{"$schema":"https://ui.shadcn.com/schema/registry-item.json","name":"agent-wave-loader","type":"registry:component","title":"Agent Wave Loader","description":"A agent-wave-loader component.","dependencies":[],"registryDependencies":[],"files":[{"path":"src/components/ui/agent-wave-loader.tsx","content":"\"use client\";\n\nimport type { CSSProperties } from \"react\";\n\ninterface MarkProps {\n  className?: string;\n}\n\n// Claude Code's pixel-art bot mark (\"Clawd\"). Source: the official Anthropic\n// Claude Code VS Code extension, resources/clawd.svg.\nfunction ClaudeCodeBotLogo({ className }: MarkProps) {\n  return (\n    <svg className={className} viewBox=\"0 0 47 38\" fill=\"none\" aria-hidden>\n      <path\n        d=\"M5.08191 10.0769V.938461h4.29231V10.0769H5.08191Zm4.15114 0V.938461h4.29235V10.0769H9.23305Zm4.15115 0V.938461h4.2923V10.0769h-4.2923Zm4.1511 0V.938461h4.2923V10.0769h-4.2923Zm4.1512 0V.938461h4.2923V10.0769h-4.2923Zm4.1511 0V.938461h4.2923V10.0769h-4.2923Zm4.1512 0V.938461h4.2923V10.0769h-4.2923Zm4.1511 0V.938461h4.2923V10.0769h-4.2923Zm4.1511 0V.938461h4.2924V10.0769H38.291ZM.930769 19.0769V9.93846h4.292311V19.0769H.930769Zm4.151141 0V9.93846h4.29231V19.0769H5.08191Zm4.15114 0v-4.5692h4.29235v4.5692H9.23305Zm4.15115 0V9.93846h4.2923V19.0769h-4.2923Zm4.1511 0V9.93846h4.2923V19.0769h-4.2923Zm4.1512 0V9.93846h4.2923V19.0769h-4.2923Zm4.1511 0V9.93846h4.2923V19.0769h-4.2923Zm4.1512 0V9.93846h4.2923V19.0769h-4.2923Zm4.1511 0v-4.5692h4.2923v4.5692h-4.2923Zm4.1511 0V9.93846h4.2924V19.0769H38.291Zm4.1512 0V9.93846h4.2923V19.0769h-4.2923ZM5.08191 28.0769v-9.1384h4.29231v9.1384H5.08191Zm4.15114 0v-9.1384h4.29235v9.1384H9.23305Zm4.15115 0v-9.1384h4.2923v9.1384h-4.2923Zm4.1511 0v-9.1384h4.2923v9.1384h-4.2923Zm4.1512 0v-9.1384h4.2923v9.1384h-4.2923Zm4.1511 0v-9.1384h4.2923v9.1384h-4.2923Zm4.1512 0v-9.1384h4.2923v9.1384h-4.2923Zm4.1511 0v-9.1384h4.2923v9.1384h-4.2923Zm4.1511 0v-9.1384h4.2924v9.1384H38.291ZM5.08191 37.0769v-9.1384h4.29231v9.1384H5.08191Zm8.30