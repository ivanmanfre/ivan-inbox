# ============================================================================
# FORK-WEDGE WATCHDOG (2026-07-30, Ivan: "shouldn't it restart by itself")
# ============================================================================
# It should, and it could not. The failure mode is NOT a crash: the process
# table fills, fork() starts returning EAGAIN, the Claude CLI can no longer be
# spawned, and uvicorn stays perfectly alive serving 503s forever.
#
# Nothing was watching that state:
#   * restartPolicyType="on_failure" only fires when the PROCESS EXITS, and it
#     never exits.
#   * railway.toml healthcheckPath is evaluated only DURING a deploy, not on a
#     running container, so the 503 /health deliberately returns for exactly
#     this case was read by nobody.
# Result: 4 recurrences, each cleared by a human pushing an empty redeploy
# commit (see `git log --grep=SIGABRT`).
#
# This task closes the loop: probe fork capacity on a timer and, once it is
# convincingly wedged, EXIT so the already-configured on_failure policy
# restarts the container. A fresh container gets a fresh process table.
#
# ⚠ Probe with /bin/true, not `claude --version`: fork capacity is the thing
#   being measured, and a heavier probe adds pressure to the very resource that
#   is exhausted.
# ⚠ GRACE + CONSECUTIVE threshold are both load-bearing. Railway probes /health
#   during deploy; exiting on a single blip would turn a transient into a
#   crash-loop and burn restartPolicyMaxRetries=5, after which Railway gives up
#   and the service stays DOWN. Only sustained failure may exit.
# ⚠ os._exit, not sys.exit: sys.exit raises inside the task and uvicorn happily
#   swallows it, which leaves the container wedged exactly as before.
# 🔴 THIS PROCESS IS NOT PID 1. entrypoint.sh runs `python3 /app/main.py &` and pid 1
#   is `node /app/web-ui/server.js`. os._exit(1) therefore kills ONLY the API, and it
#   restarts the container solely because entrypoint.sh now polls `kill -0` on
#   nginx/api/webui and exits 1 when any of them dies. Before that supervisor existed
#   (added the same day) this exit would have killed the API and left the container
#   happily serving the web UI -- the API fully GONE instead of merely wedged, i.e.
#   strictly worse than the bug. Killing pid 1 from inside is not an alternative: the
#   kernel ignores signals to pid 1 from within its own namespace when no handler is
#   installed, SIGKILL included.
#   ⚠ If anyone restores `exec node /app/web-ui/server.js` in entrypoint.sh, this
#   watchdog silently becomes a self-destruct button with no restart. Keep them coupled.
_FORK_WATCH_GRACE_S = 180      # never exit during boot / deploy healthcheck
_FORK_WATCH_INTERVAL_S = 60
_FORK_WATCH_STRIKES = 3        # ~3 min of sustained wedge before restarting
_fork_watch_state = {"strikes": 0, "last_ok": None, "last_error": None, "exits": 0}


_FORK_PROBE_CMD = None


def _fork_probe_cmd():
    """Cheapest possible fork target that is guaranteed to exist in this image."""
    global _FORK_PROBE_CMD
    if _FORK_PROBE_CMD is None:
        for c in ("/bin/true", "/usr/bin/true"):
            if Path(c).exists():
                _FORK_PROBE_CMD = [c]
                break
        else:
            _FORK_PROBE_CMD = ["/bin/sh", "-c", ":"]
    return _FORK_PROBE_CMD


def _fork_probe_ok():
    """True when the container can still fork.

    ⚠ ONLY errno EAGAIN counts as a wedge. `FileNotFoundError` and
    `PermissionError` are OSError subclasses too, so catching OSError broadly
    would score a missing/unreadable probe binary as a fork wedge and
    crash-loop the container straight through restartPolicyMaxRetries=5 --
    after which Railway stops retrying and the service stays DOWN. That is
    strictly worse than the wedge this watchdog exists to fix. Verified: on a
    box without /bin/true the broad form returned False (false wedge).
    EAGAIN is 11 on Linux, 35 on BSD/macOS.
    """
    try:
        subprocess.run(_fork_probe_cmd(), capture_output=True, timeout=5)
        return True
    except OSError as e:  # BlockingIOError is an OSError with errno 11
        if getattr(e, "errno", None) in (11, 35):
            _fork_watch_state["last_error"] = f"{type(e).__name__}: {e}"
            return False
        return True
    except Exception:
        # timeout or anything else: not evidence of a fork wedge, do not count it
        return True


async def _fork_wedge_watchdog():
    started = _dt2.datetime.utcnow()
    await asyncio.sleep(_FORK_WATCH_GRACE_S)
    while True:
        try:
            ok = await asyncio.to_thread(_fork_probe_ok)
            if ok:
                _fork_watch_state["strikes"] = 0
                _fork_watch_state["last_ok"] = _dt2.datetime.utcnow().isoformat() + "Z"
            else:
                _fork_watch_state["strikes"] += 1
                logger.error(
                    f"fork-wedge watchdog: strike {_fork_watch_state['strikes']}/{_FORK_WATCH_STRIKES} "
                    f"-- {_fork_watch_state['last_error']}"
                )
                if _fork_watch_state["strikes"] >= _FORK_WATCH_STRIKES:
                    up = (_dt2.datetime.utcnow() - started).total_seconds()
                    logger.error(
                        f"fork-wedge watchdog: container wedged on fork EAGAIN after {up:.0f}s uptime. "
                        f"Exiting so Railway's on_failure restart policy replaces the container."
                    )
                    sys.stdout.flush()
                    sys.stderr.flush()
                    os._exit(1)
        except Exception as e:
            logger.error(f"fork-wedge watchdog error (ignored): {e}")
        await asyncio.sleep(_FORK_WATCH_INTERVAL_S)


@app.on_event("startup")
async def _start_fork_watchdog():
    asyncio.create_task(_fork_wedge_watchdog())
    logger.info(
        f"fork-wedge watchdog armed (grace {_FORK_WATCH_GRACE_S}s, "
        f"every {_FORK_WATCH_INTERVAL_S}s, {_FORK_WATCH_STRIKES} strikes)"
    )


@app.get("/health")
async def health_check():
    """
    Health check endpoint.

    Returns 503 when the container can no longer spawn subprocesses (EAGAIN /
    SystemResources) so Railway's healthcheck will restart it instead of leaving
    a silently-broken container serving traffic.
    """
    # Probe subprocess spawn capacity — catches EAGAIN/SystemResources exhaustion
    spawn_ok = True
    spawn_error: Optional[str] = None
    try:
        result = subprocess.run(
            ["claude", "--version"],
            capture_output=True,
            text=True,
            timeout=10
        )
        claude_available = result.returncode == 0
        claude_version = result.stdout.strip() if claude_available else None
    except (BlockingIOError, OSError) as e:
        # errno 11 (EAGAIN) means the process table is exhausted
        spawn_ok = False
        spawn_error = f"{type(e).__name__}: {e}"
        claude_available = False
        claude_version = None
    except Exception as e:
        claude_available = False
        claude_version = str(e)

    body = {
        "status": "healthy" if spawn_ok else "degraded",
        "build_marker": "ht-audience-audit-v2",  # bump to confirm a deploy actually cut over
        "score_pending_route": True,       # confirms the /score-pending FastAPI route is in this build
        "extract_clips_route": True,       # confirms the /extract-clips FastAPI route is in this build
        "editorial_pending_route": True,   # confirms the /editorial-pending FastAPI route is in this build
        "claude_cli_available": claude_available,
        "claude_version": claude_version,
        "subprocess_spawn_ok": spawn_ok,
        "subprocess_spawn_error": spawn_error,
        "fork_watchdog": dict(_fork_watch_state),
        "anthropic_key_set": bool(ANTHROPIC_API_KEY),
        "oauth_credentials_set": Path("/home/appuser/.claude/.credentials.json").exists(),
        "workspace_dir": WORKSPACE_DIR,
        "skills_dir": SKILLS_DIR
    }
    if not spawn_ok:
        return JSONResponse(status_code=503, content=body)
    return body


@app.get("/resources")
async def resources():
    """Live container resource snapshot — real RAM ceiling (cgroup limit, not host),
    current usage, per-process footprint, CPU, and live `claude` CLI process count.
    Used to decide how far CLAUDE_SEMAPHORE can safely be raised."""

    def _read_int(path):
        try:
            v = Path(path).read_text().strip()
            return None if v in ("", "max") else int(v)
        except Exception:
            return None

    # cgroup v2 first, then v1 fallback
    mem_limit = _read_int("/sys/fs/cgroup/memory.max") or _read_int("/sys/fs/cgroup/memory/memory.limit_in_bytes")
    mem_used = _read_int("/sys/fs/cgroup/memory.current") or _read_int("/sys/fs/cgroup/memory/memory.usage_in_bytes")

    # Host MemTotal as a sanity cross-check (a cgroup "max" limit falls back to host RAM)
    mem_total_host = None
    try:
        for line in Path("/proc/meminfo").read_text().splitlines():
            if line.startswith("MemTotal:"):
                mem_total_host = int(line.split()[1]) * 1024  # kB -> bytes
                break
    except Exception:
        pass

    # If cgroup limit is unset/huge, the effective ceiling is host RAM
    effective_limit = mem_limit
    if not effective_limit or (mem_total_host and effective_limit > mem_total_host * 2):
        effective_limit = mem_total_host

    # Live claude CLI process count + their combined RSS (per-slot footprint)
    claude_procs = 0
    claude_rss = 0
    try:
        out = subprocess.run(["ps", "-eo", "rss,comm"], capture_output=True, text=True, timeout=5).stdout
        for ln in out.splitlines()[1:]:
            parts = ln.split(None, 1)
            if len(parts) == 2 and "claude" in parts[1].lower():
                claude_procs += 1
                claude_rss += int(parts[0]) * 1024  # kB -> bytes
    except Exception:
        pass

    load = None
    try:
        load = [float(x) for x in Path("/proc/loadavg").read_text().split()[:3]]
    except Exception:
        pass

    ncpu = os.cpu_count()
    mb = lambda b: round(b / 1048576) if isinstance(b, int) else None

    return {
        "cgroup_mem_limit_mb": mb(mem_limit),
        "cgroup_mem_used_mb": mb(mem_used),
        "host_mem_total_mb": mb(mem_total_host),
        "effective_ram_ceiling_mb": mb(effective_limit),
        "mem_free_mb": mb(effective_limit - mem_used) if (effective_limit and mem_used) else None,
        "claude_semaphore": int(os.environ.get("CLAUDE_SEMAPHORE", "5")),
        "live_claude_procs": claude_procs,
        "live_claude_rss_mb": mb(claude_rss),
        "avg_claude_proc_mb": mb(claude_rss // claude_procs) if claude_procs else None,
        "cpu_count": ncpu,
        "loadavg_1_5_15": load,
    }


@app.post("/auth/refresh")
async def refresh_credentials():
    """Pull fresh OAuth credentials from Supabase and write to disk"""
    import httpx as hx
    creds_path = Path("/home/appuser/.claude/.credentials.json")
    supabase_url = os.environ.get("SUPABASE_URL", "")
    supabase_key = os.environ.get("SUPABASE_SERVICE_KEY", "")
    if not supabase_url or not supabase_key:
        return {"success": False, "error": "SUPABASE_URL or SUPABASE_SERVICE_KEY not set"}
    try:
        resp = hx.get(
            f"{supabase_url}/rest/v1/system_settings?key=eq.claude_oauth_credentials&select=value",
            headers={"apikey": supabase_key, "Authorization": f"Bearer {supabase_key}"},
            timeout=5,
        )
        rows = resp.json()
        if not rows:
            return {"success": False, "error": "No credentials found in Supabase"}
        sb_creds = json.loads(rows[0]["value"])
        sb_expiry = sb_creds.get("claudeAiOauth", {}).get("expiresAt", 0)
        local_expiry = 0
        if creds_path.exists():
            local_expiry = json.loads(creds_path.read_text()).get("claudeAiOauth", {}).get("expiresAt", 0)
        creds_path.write_text(json.dumps(sb_creds))
        os.chmod(str(creds_path), 0o600)
        # Clear stale sessions so next /chat call starts fresh
        CLIENT_SESSIONS.clear()
        hours_left = (sb_expiry - int(__import__("time").time() * 1000)) / 3600000
        return {
            "success": True,
            "previous_expiry": local_expiry,
            "new_expiry": sb_expiry,
            "hours_remaining": round(hours_left, 1),
        }
    except Exception as e:
        return {"success": False, "error": str(e)}


CLAUDE_HOME = Path("/home/appuser/.claude")


def _encode_cwd(cwd: str) -> str:
    """Match jsonl_sync.py encoding: space → -, / → -, dash preserved."""
    return cwd.replace(" ", "-").replace("/", "-")


async def ensure_session_jsonl_current(session_id: str, client_id: str, working_dir: str):
    """Pull JSONL from Supabase if remote checksum differs from local."""
    target = CLAUDE_HOME / "projects" / _encode_cwd(working_dir) / f"{session_id}.jsonl"

    async with httpx.AsyncClient() as client:
        r = await client.get(
            f"{SUPABASE_URL}/rest/v1/claude_session_index?session_id=eq.{session_id}"
            "&select=client_id,checksum_sha256,bytes",
            headers={"apikey": SUPABASE_SERVICE_KEY, "Authorization": f"Bearer {SUPABASE_SERVICE_KEY}"},
            timeout=10,
        )
        if r.status_code != 200:
            return
        rows = r.json()
        if not rows:
            return  # no remote copy

        remote = rows[0]
        if target.exists():
            local = hashlib.sha256(target.read_bytes()).hexdigest()
            if local == remote["checksum_sha256"]:
                return  # already current

        # Download
        dr = await client.get(
            f"{SUPABASE_URL}/storage/v1/object/claude-sessions/{remote['client_id']}/{session_id}.jsonl",
            headers={"apikey": SUPABASE_SERVICE_KEY, "Authorization": f"Bearer {SUPABASE_SERVICE_KEY}"},
            timeout=60,
        )
        if dr.status_code != 200:
            logger.warning(f"jsonl download failed: {dr.status_code}")
            return

        target.parent.mkdir(parents=True, exist_ok=True)
        target.write_bytes(dr.content)
        actual = hashlib.sha256(target.read_bytes()).hexdigest()
        if actual != remote["checksum_sha256"]:
            target.unlink()
            logger.error(f"checksum mismatch on download for {session_id}")
            return

        logger.info(f"restored session {session_id} from Supabase ({len(dr.content)} bytes)")


@app.post("/chat", response_model=ChatResponse)
async def chat(
    request: ChatRequest,
    x_api_key: Optional[str] = Header(None)
):
    """
    Execute a Claude Code prompt and return the result.
    Supports multi-client mode via optional client_id parameter.
    """
    verify_api_key(x_api_key)

    # Check auth: either API key or OAuth credentials must be available
    oauth_creds = Path("/home/appuser/.claude/.credentials.json")
    if not ANTHROPIC_API_KEY and not oauth_creds.exists():
        raise HTTPException(status_code=500, detail="No auth configured: set ANTHROPIC_API_KEY or CLAUDE_OAUTH_CREDENTIALS")

    # Session management: explicit > auto-resume > new
    session_key = request.client_id or "__default__"

    # Serialize requests per client to prevent race conditions on session resume
    async with get_client_lock(session_key):
        if request.session_id:
            session_id = request.session_id
        elif session_key in CLIENT_SESSIONS:
            session_id = CLIENT_SESSIONS[session_key]
            logger.info(f"Auto-resuming session {session_id} for {session_key}")
        else:
            session_id = str(uuid.uuid4())

        # --- Client resolution ---
        client_config = None
        if request.client_id:
            client_config = await get_client_config(request.client_id)
            working_dir = ensure_client_repo(
                request.client_id,
                client_config["github_repo"],
                client_config,
            )
            env = build_client_env(client_config)
            logger.info(f"Client mode: {request.client_id} -> {working_dir}")
        else:
            working_dir = request.working_directory or WORKSPACE_DIR
            env = build_base_env()

        # Phase 3: pull latest JSONL from Supabase if remote is newer than local
        if request.session_id:
            try:
                await ensure_session_jsonl_current(
                    session_id=request.session_id,
                    client_id=request.client_id or "__default__",
                    working_dir=working_dir,
                )
            except Exception as e:
                logger.warning(f"ensure_session_jsonl_current failed: {e}")

        # Build the claude command — prompt piped via stdin to avoid argv exec limits
        cmd = [
            "claude",
            "-p",
            "--permission-mode", request.permission_mode,
            "--model", CLAUDE_MODEL,
        ]

        # Resume session if we have a previous one
        if session_key in CLIENT_SESSIONS or request.session_id:
            cmd.extend(["--resume", session_id])

        # Add output format
        if request.output_format in ["json", "stream-json"]:
            cmd.extend(["--output-format", request.output_format])

        # Add allowed tools if specified
        if request.allowed_tools:
            cmd.extend(["--allowedTools", ",".join(request.allowed_tools)])

        # Add max turns if specified
        if request.max_turns:
            cmd.extend(["--max-turns", str(request.max_turns)])

        # Add system prompt append if specified
        if request.append_system_prompt:
            cmd.extend(["--append-system-prompt", request.append_system_prompt])

        try:
            # Get list of files before execution
            files_before = set()
            if Path(working_dir).exists():
                files_before = set(str(p) for p in Path(working_dir).rglob("*") if p.is_file())

            # Run Claude Code — prompt via stdin (semaphore-gated to cap concurrent subprocess spawns)
            async with acquire_claude_slot():
                # to_thread: a blocking 15-min subprocess.run inside an async handler
                # freezes the whole event loop -> nginx 502/503 for every concurrent
                # request (incl. /v1/messages). Run it in a worker thread instead.
                result = await asyncio.to_thread(
                    _run_blocking_claude,
                    cmd,
                    working_dir,
                    env,
                    request.prompt,
                    900,  # 15 minute timeout
                )

            # Get list of files after execution
            files_after = set()
            if Path(working_dir).exists():
                files_after = set(str(p) for p in Path(working_dir).rglob("*") if p.is_file())

            # Determine created and modified files
            files_created = list(files_after - files_before)
            files_modified = []

            output = result.stdout
            if result.returncode != 0 and result.stderr:
                output = f"{output}\n\nSTDERR:\n{result.stderr}"

            # If resume failed with "No conversation found", retry without --resume
            if result.returncode != 0 and "No conversation found" in (result.stderr or ""):
                logger.info(f"Session {session_id} expired, retrying without --resume")
                CLIENT_SESSIONS.pop(session_key, None)
                new_session_id = str(uuid.uuid4())
                retry_cmd = [c for c in cmd if c != "--resume" and c != session_id]
                async with acquire_claude_slot():
                    result = await asyncio.to_thread(
                        _run_blocking_claude,
                        retry_cmd,
                        working_dir,
                        env,
                        request.prompt,
                        900,
                    )
                session_id = new_session_id
                output = result.stdout
                if result.returncode != 0 and result.stderr:
                    output = f"{output}\n\nSTDERR:\n{result.stderr}"

            # Store session for auto-resume on next call
            if result.returncode == 0:
                CLIENT_SESSIONS[session_key] = session_id
                logger.info(f"Stored session {session_id} for {session_key}")

            return ChatResponse(
                session_id=session_id,
                result=output,
                success=result.returncode == 0,
                client_id=request.client_id,
                files_created=files_created,
                files_modified=files_modified,
            )

        except subprocess.TimeoutExpired:
            raise HTTPException(status_code=504, detail="Claude Code execution timed out")
        except Exception as e:
            raise HTTPException(status_code=500, detail=f"Execution error: {str(e)}")


@app.post("/chat/stream")
async def chat_stream(
    request: ChatRequest,
    x_api_key: Optional[str] = Header(None)
):
    """
    Execute a Claude Code prompt with streaming response.
    Returns Server-Sent Events (SSE).
    """
    verify_api_key(x_api_key)

    oauth_creds = Path("/home/appuser/.claude/.credentials.json")
    if not ANTHROPIC_API_KEY and not oauth_creds.exists():
        raise HTTPException(status_code=500, detail="No auth configured: set ANTHROPIC_API_KEY or CLAUDE_OAUTH_CREDENTIALS")

    # --- Client resolution (same as /chat) ---
    client_config = None
    if request.client_id:
        client_config = await get_client_config(request.client_id)
        working_dir = ensure_client_repo(
            request.client_id,
            client_config["github_repo"],
            client_config,
        )
        env = build_client_env(client_config)
    else:
        working_dir = request.working_directory or WORKSPACE_DIR
        env = build_base_env()

    # Build the claude command with streaming — prompt via stdin to avoid argv exec limits
    cmd = [
        "claude",
        "-p",
        "--permission-mode", request.permission_mode,
        "--model", CLAUDE_MODEL,
        "--output-format", "stream-json"
    ]

    if request.allowed_tools:
        cmd.extend(["--allowedTools", ",".join(request.allowed_tools)])

    if request.max_turns:
        cmd.extend(["--max-turns", str(request.max_turns)])

    if request.append_system_prompt:
        cmd.extend(["--append-system-prompt", request.append_system_prompt])

    async def generate():
        # Semaphore-gated to cap concurrent subprocess spawns
        async with acquire_claude_slot():
            process = await asyncio.create_subprocess_exec(
                *cmd,
                cwd=working_dir,
                env=env,
                stdin=asyncio.subprocess.PIPE,
                stdout=asyncio.subprocess.PIPE,
                stderr=asyncio.subprocess.PIPE,
                start_new_session=True,  # own process group → reap the whole tree below
            )

            try:
                # Pipe prompt via stdin then close to signal EOF
                process.stdin.write(request.prompt.encode("utf-8"))
                await process.stdin.drain()
                process.stdin.close()

                async for line in process.stdout:
                    yield f"data: {line.decode()}\n\n"

                await process.wait()
                yield f"data: {json.dumps({'type': 'done', 'returncode': process.returncode})}\n\n"

            except Exception as e:
                yield f"data: {json.dumps({'type': 'error', 'message': str(e)})}\n\n"
            finally:
                # A dropped SSE client (or error mid-stream) otherwise leaves the CLI and
                # its MCP child processes running — the /chat-path fork leak. Kill the
                # whole process group if it is still alive.
                if process.returncode is None:
                    try:
                        os.killpg(os.getpgid(process.pid), signal.SIGKILL)
                        await process.wait()
                    except Exception:
                        try:
                            process.kill()
                            await process.wait()
                        except Exception:
                            pass

    return StreamingResponse(
        generate(),
        media_type="text/event-stream"
    )


@app.get("/skills")
async def list_skills(x_api_key: Optional[str] = Header(None)):
    """List all available skills"""
    verify_api_key(x_api_key)
    
    skills = []
    skills_path = Path(SKILLS_DIR)
    
    if skills_path.exists():
        for skill_dir in skills_path.iterdir():
            if skill_dir.is_dir():
                skill_md = skill_dir / "SKILL.md"
                if skill_md.exists():
                    content = skill_md.read_text()
                    
                    # Parse YAML frontmatter
                    name = skill_dir.name
                    description = ""
                    
                    if content.startswith("---"):
                        parts = content.split("---", 2)
                        if len(parts) >= 3:
                            frontmatter = parts[1]
                            for line in frontmatter.split("\n"):
                                if line.startswith("name:"):
                                    name = line.split(":", 1)[1].strip().strip('"')
                                elif line.startswith("description:"):
                                    description = line.split(":", 1)[1].strip().strip('"')
                    
                    skills.append(SkillInfo(
                        id=skill_dir.name,
                        name=name,
                        description=description,
                        path=str(skill_dir)
                    ))
    
    return {"skills": skills}


@app.get("/skills/{skill_id}")
async def get_skill(skill_id: str, x_api_key: Optional[str] = Header(None)):
    """Get a specific skill's SKILL.md content"""
    verify_api_key(x_api_key)
    
    skill_path = Path(SKILLS_DIR) / skill_id / "SKILL.md"
    
    if not skill_path.exists():
        raise HTTPException(status_code=404, detail=f"Skill '{skill_id}' not found")
    
    return {
        "id": skill_id,
        "content": skill_path.read_text(),
        "files": [str(f.relative_to(skill_path.parent)) for f in skill_path.parent.rglob("*") if f.is_file()]
    }


@app.post("/skills/upload")
async def upload_skill(
    file: UploadFile = File(...),
    x_api_key: Optional[str] = Header(None)
):
    """Upload a skill as a zip file"""
    verify_api_key(x_api_key)
    
    if not file.filename.endswith(".zip"):
        raise HTTPException(status_code=400, detail="File must be a .zip archive")
    
    # Create temp directory
    with tempfile.TemporaryDirectory() as temp_dir:
        zip_path = Path(temp_dir) / file.filename
        
        # Save uploaded file
        with open(zip_path, "wb") as f:
            content = await file.read()
            f.write(content)
        
        # Extract
        extract_dir = Path(temp_dir) / "extracted"
        shutil.unpack_archive(zip_path, extract_dir)
        
        # Find SKILL.md to determine skill structure
        skill_md_files = list(extract_dir.rglob("SKILL.md"))
        if not skill_md_files:
            raise HTTPException(status_code=400, detail="No SKILL.md found in archive")
        
        # Get the skill directory (parent of SKILL.md)
        skill_source = skill_md_files[0].parent
        skill_name = skill_source.name
        
        # Copy to skills directory
        skill_dest = Path(SKILLS_DIR) / skill_name
        if skill_dest.exists():
            shutil.rmtree(skill_dest)
        shutil.copytree(skill_source, skill_dest)
        
        return {
            "success": True,
            "skill_id": skill_name,
            "message": f"Skill '{skill_name}' uploaded successfully"
        }


@app.delete("/skills/{skill_id}")
async def delete_skill(skill_id: str, x_api_key: Optional[str] = Header(None)):
    """Delete a skill"""
    verify_api_key(x_api_key)
    
    skill_path = Path(SKILLS_DIR) / skill_id
    
    if not skill_path.exists():
        raise HTTPException(status_code=404, detail=f"Skill '{skill_id}' not found")
    
    shutil.rmtree(skill_path)
    
    return {"success": True, "message": f"Skill '{skill_id}' deleted"}


@app.get("/workspace")
async def list_workspace(
    path: str = "",
    x_api_key: Optional[str] = Header(None)
):
    """List files in the workspace"""
    verify_api_key(x_api_key)
    
    target_path = Path(WORKSPACE_DIR) / path
    
    if not target_path.exists():
        raise HTTPException(status_code=404, detail="Path not found")
    
    if target_path.is_file():
        return {
            "type": "file",
            "path": str(target_path.relative_to(WORKSPACE_DIR)),
            "size": target_path.stat().st_size
        }
    
    items = []
    for item in target_path.iterdir():
        items.append({
            "name": item.name,
            "type": "directory" if item.is_dir() else "file",
            "path": str(item.relative_to(WORKSPACE_DIR)),
            "size": item.stat().st_size if item.is_file() else None
        })
    
    return {"items": items, "path": path}


@app.get("/workspace/{file_path:path}")
async def download_workspace_file(
    file_path: str,
    x_api_key: Optional[str] = Header(None)
):
    """Download a file from the workspace"""
    verify_api_key(x_api_key)
    
    target_path = Path(WORKSPACE_DIR) / file_path
    
    if not target_path.exists():
        raise HTTPException(status_code=404, detail="File not found")
    
    if not target_path.is_file():
        raise HTTPException(status_code=400, detail="Path is not a file")
    
    return FileResponse(
        target_path,
        filename=target_path.name
    )


@app.post("/workspace/upload")
async def upload_workspace_file(
    file: UploadFile = File(...),
    path: str = "",
    x_api_key: Optional[str] = Header(None)
):
    """Upload a file to the workspace"""
    verify_api_key(x_api_key)
    
    target_dir = Path(WORKSPACE_DIR) / path
    target_dir.mkdir(parents=True, exist_ok=True)
    
    target_path = target_dir / file.filename
    
    with open(target_path, "wb") as f:
        content = await file.read()
        f.write(content)
    
    return {
        "success": True,
        "path": str(target_path.relative_to(WORKSPACE_DIR))
    }


@app.delete("/workspace/{file_path:path}")
async def delete_workspace_file(
    file_path: str,
    x_api_key: Optional[str] = Header(None)
):
    """Delete a file from the workspace"""
    verify_api_key(x_api_key)
    
    target_path = Path(WORKSPACE_DIR) / file_path
    
    if not target_path.exists():
        raise HTTPException(status_code=404, detail="File not found")
    
    if target_path.is_dir():
        shutil.rmtree(target_path)
    else:
        target_path.unlink()
    
    return {"success": True, "message": f"Deleted {file_path}"}


# --------------- Client Endpoints ---------------

@app.get("/clients")
async def list_clients(x_api_key: Optional[str] = Header(None)):
    """List all registered clients."""
    verify_api_key(x_api_key)
    if not SUPABASE_URL or not SUPABASE_SERVICE_KEY:
        raise HTTPException(status_code=500, detail="Supabase not configured")

    async with httpx.AsyncClient() as client:
        response = await client.get(
            f"{SUPABASE_URL}/rest/v1/client_registry",
            params={
                "is_active": "eq.true",
                "select": "client_id,display_name,n8n_url,aliases",
            },
            headers={
                "apikey": SUPABASE_SERVICE_KEY,
                "Authorization": f"Bearer {SUPABASE_SERVICE_KEY}",
            },
            timeout=15,
        )
        return {"clients": response.json()}


@app.post("/clients/{client_id}/sync")
async def sync_client_repo(client_id: str, x_api_key: Optional[str] = Header(None)):
    """Force git pull for a client's config repo."""
    verify_api_key(x_api_key)
    client_config = await get_client_config(client_id)
    path = ensure_client_repo(client_id, client_config["github_repo"], client_config)
    return {"success": True, "client_id": client_id, "path": path}


@app.post("/clients/{client_id}/reset-session")
async def reset_client_session(client_id: str, x_api_key: Optional[str] = Header(None)):
    """Clear the stored session for a client so the next call starts fresh."""
    verify_api_key(x_api_key)
    session_key = client_id or "__default__"
    old = CLIENT_SESSIONS.pop(session_key, None)
    return {"success": True, "client_id": client_id, "cleared_session": old}


async def create_repo_from_template(client_slug: str) -> str:
    """Create a GitHub repo from the client-config-template. Returns clone URL."""
    if not GITHUB_TOKEN:
        raise HTTPException(status_code=500, detail="GITHUB_TOKEN not configured")

    repo_name = f"{client_slug}-config"
    async with httpx.AsyncClient() as client:
        resp = await client.post(
            "https://api.github.com/repos/ivanmanfre/client-config-template/generate",
            headers={
                "Authorization": f"token {GITHUB_TOKEN}",
                "Accept": "application/vnd.github.v3+json",
            },
            json={
                "owner": "ivanmanfre",
                "name": repo_name,
                "private": True,
                "description": f"Client config for {client_slug}",
            },
            timeout=30,
        )
        if resp.status_code not in (200, 201):
            raise HTTPException(
                status_code=500,
                detail=f"GitHub repo creation failed: {resp.text[:200]}",
            )
        return resp.json()["clone_url"]


class ClientCreate(BaseModel):
    """Request model for creating a client."""
    client_id: str
    display_name: str
    n8n_url: Optional[str] = None
    n8n_api_key: Optional[str] = None
    aliases: Optional[List[str]] = []
    create_repo: bool = True


@app.post("/clients", status_code=201)
async def create_client(request: ClientCreate, x_api_key: Optional[str] = Header(None)):
    """Create a new client with optional auto-created GitHub config repo."""
    verify_api_key(x_api_key)
    if not SUPABASE_URL or not SUPABASE_SERVICE_KEY:
        raise HTTPException(status_code=500, detail="Supabase not configured")

    slug = request.client_id.lower().strip()
    if not re.match(r"^[a-z0-9][a-z0-9-]*$", slug):
        raise HTTPException(
            status_code=400,
            detail="client_id must be lowercase alphanumeric with hyphens",
        )

    github_repo = ""
    if request.create_repo:
        github_repo = await create_repo_from_template(slug)

    async with httpx.AsyncClient() as client:
        resp = await client.post(
            f"{SUPABASE_URL}/rest/v1/client_registry",
            headers={
                "apikey": SUPABASE_SERVICE_KEY,
                "Authorization": f"Bearer {SUPABASE_SERVICE_KEY}",
                "Content-Type": "application/json",
                "Prefer": "return=representation",
            },
            json={
                "client_id": slug,
                "display_name": request.display_name,
                "github_repo": github_repo,
                "n8n_url": request.n8n_url,
                "n8n_api_key": request.n8n_api_key,
                "aliases": request.aliases or [],
            },
            timeout=15,
        )
        if resp.status_code == 409:
            raise HTTPException(
                status_code=409, detail=f"Client '{slug}' already exists"
            )
        data = resp.json()

    # Pre-warm: clone the new repo + initialize n8nac
    if github_repo:
        try:
            new_client_config = {
                "n8n_url": request.n8n_url,
                "n8n_api_key": request.n8n_api_key,
            }
            ensure_client_repo(slug, github_repo, new_client_config)
        except Exception:
            logger.warning(f"Pre-warm clone failed for new client {slug}")

    return {
        "success": True,
        "client": data[0] if data else {},
        "github_repo": github_repo,
    }


# --------------- Anthropic API-Compatible Proxy ---------------
# This allows n8n workflows to switch from api.anthropic.com to this server
# with minimal changes — just swap the base URL.

# Model mapping: Anthropic model IDs → Claude Code --model values
MODEL_MAP = {
    "claude-opus-4-8": "opus",
    "claude-opus-4-7": "opus",
    "claude-opus-4-6": "opus",
    "claude-opus-4-5-20251101": "opus",
    "claude-opus-4-5": "opus",
    "claude-sonnet-4-6": "sonnet",
    "claude-sonnet-4-5-20250929": "sonnet",
    "claude-sonnet-4-5": "sonnet",
    "claude-sonnet-4-20250514": "sonnet",
    "claude-haiku-4-5": "haiku",
    "claude-haiku-4-5-20251001": "haiku",
}

# Semaphore to limit concurrent claude CLI processes.
# Env-tunable (default 5) so we can raise/lower concurrency without a code deploy.
# Raised 3->5 on 2026-06-08 after Opus audit (AI Opportunity Scan) + Post Gen bursts
# saturated the 3 slots and timed out unrelated triage calls.
CLAUDE_SEMAPHORE = asyncio.Semaphore(int(os.environ.get("CLAUDE_SEMAPHORE", "5")))

# Max seconds a request will WAIT for a free Claude slot before shedding load.
# Without this, `async with CLAUDE_SEMAPHORE` waits FOREVER when all slots are busy:
# under concurrent n8n load the queue grows unbounded, clients (n8n nodes) time out at
# 90-140s but the proxy-side request keeps waiting, eventually grabs a slot and burns it
# on work nobody is waiting for — a death spiral that keeps the proxy permanently wedged
# (the 2026-06-16 "n8n calls hang while external calls succeed" incident). Bounding the
# wait turns an indefinite hang into a fast, retryable 503 so load sheds gracefully.
SEMAPHORE_ACQUIRE_TIMEOUT = float(os.environ.get("SEMAPHORE_ACQUIRE_TIMEOUT", "30"))

# Hard cap on a single CLI run. On timeout the subprocess is now KILLED (below) so it
# stops holding its slot. Default 900s preserves headroom for genuinely heavy Opus gens;
# env-tunable so it can be lowered to free wedged slots faster under load.
CLI_EXEC_TIMEOUT = float(os.environ.get("CLI_EXEC_TIMEOUT", "900"))


@contextlib.asynccontextmanager
async def acquire_claude_slot():
    """Bounded acquire of CLAUDE_SEMAPHORE. Raises 503 (retryable) if no slot frees
    within SEMAPHORE_ACQUIRE_TIMEOUT, instead of hanging indefinitely."""
    try:
        await asyncio.wait_for(CLAUDE_SEMAPHORE.acquire(), timeout=SEMAPHORE_ACQUIRE_TIMEOUT)
    except asyncio.TimeoutError:
        raise HTTPException(
            status_code=503,
            detail="Proxy busy: no Claude slot available (all concurrent slots in use)",
            headers={"Retry-After": "8"},
        )
    try:
        yield
    finally:
        CLAUDE_SEMAPHORE.release()


def format_messages_as_prompt(system: str, messages: list) -> str:
    """
    Convert Anthropic API messages format into a single prompt string for claude -p.
    Preserves the system prompt and conversation structure.
    """
    parts = []

    if system:
        parts.append(f"<system_instructions>\n{system}\n</system_instructions>\n")

    for msg in messages:
        role = msg.get("role", "user")
        content = msg.get("content", "")

        # Handle content blocks (text, image, etc.)
        if isinstance(content, list):
            text_parts = []
            for block in content:
                if isinstance(block, dict):
                    if block.get("type") == "text":
                        text_parts.append(block["text"])
                    elif block.get("type") == "image":
                        text_parts.append("[image omitted]")
                    elif block.get("type") == "tool_result":
                        text_parts.append(str(block.get("content", "")))
                    elif block.get("type") == "tool_use":
                        text_parts.append(f"[tool_use: {block.get('name', '')}]")
                else:
                    text_parts.append(str(block))
            content = "\n".join(text_parts)

        if role == "user":
            parts.append(content)
        elif role == "assistant":
            parts.append(f"[Previous assistant response]\n{content}")

    return "\n\n".join(parts)


async def _run_with_heartbeat(raw_request: Request, core_coro):
    """Wrap a core coroutine (returns a JSONResponse / raises HTTPException) so that
    callers sending `X-Heartbeat: 1` get a StreamingResponse that emits headers + a
    whitespace ping every 15s until the result is ready, then the final JSON.

    WHY: a normal buffered response keeps the TCP connection SILENT for minutes while
    the CLI generates, and Railway's edge proxy resets that silent connection -> 502
    (the carousel failure mode). Interspersed whitespace is valid leading JSON, so n8n
    parses the body unchanged. Callers WITHOUT the header get the identical buffered
    JSONResponse — zero behavior change. Shared by /v1/messages and /v1/vision-qa."""
    if raw_request.headers.get("x-heartbeat") != "1":
        return await core_coro

    HEARTBEAT_INTERVAL = 15.0
    gen_task = asyncio.create_task(core_coro)

    async def _heartbeat_stream():
        yield b" "  # emit immediately so the edge sees the response start right away
        while True:
            try:
                resp = await asyncio.wait_for(asyncio.shield(gen_task), timeout=HEARTBEAT_INTERVAL)
                yield resp.body  # core returns a JSONResponse; forward its bytes
                return
            except asyncio.TimeoutError:
                yield b" "  # keep-alive ping (valid leading JSON whitespace)
            except HTTPException as e:
                # Already committed to HTTP 200; encode the proxy error as parseable JSON.
                yield json.dumps({
                    "type": "error",
                    "error": {
                        "type": "proxy_error",
                        "message": str(e.detail),
                        "status_code": e.status_code,
                    },
                }).encode("utf-8")
                return
            except Exception as e:  # noqa: BLE001 — never leave the stream hanging
                yield json.dumps({
                    "type": "error",
                    "error": {"type": "proxy_error", "message": str(e)[:300]},
                }).encode("utf-8")
                return

    # X-Accel-Buffering: no -> nginx flushes each ping immediately instead of buffering
    # the tiny pings until upstream closes (~9 min) where the edge still sees silence.
    return StreamingResponse(
        _heartbeat_stream(),
        media_type="application/json",
        headers={"X-Accel-Buffering": "no"},
    )


@app.post("/v1/messages")
async def anthropic_messages_proxy(
    raw_request: Request,
    x_api_key: Optional[str] = Header(None),
    authorization: Optional[str] = Header(None),
):
    """
    Anthropic Messages API-compatible endpoint.
    Accepts the same request format as api.anthropic.com/v1/messages.
    Routes through Claude Code CLI using Max subscription.

    Works as a drop-in replacement — just change the base URL in n8n.
    """
    # Accept auth via X-API-Key header or Authorization: Bearer header
    # (Anthropic SDK uses x-api-key, some HTTP nodes use Authorization)
    api_key = x_api_key
    if not api_key and authorization:
        api_key = authorization.replace("Bearer ", "").strip()
    verify_api_key(api_key)

    # Read the request body HERE, in the request handler — before any streaming starts.
    # (Reading raw_request.json() inside a concurrently-running task while a
    # StreamingResponse is already draining the request lifecycle deadlocks the body
    # read — the cause of the first heartbeat attempt hanging with 0 bytes.)
    request = await raw_request.json()

    # Opt-in heartbeat streaming for LONG generations (e.g. carousel Call 1/2/4).
    # See _run_with_heartbeat for the full rationale (Railway edge resets silent
    # multi-minute connections -> 502). Callers WITHOUT X-Heartbeat:1 get the identical
    # buffered JSONResponse — zero behavior change for every other consumer.
    return await _run_with_heartbeat(raw_request, _messages_core(request))


async def _messages_core(request: dict):
    """Core /v1/messages generation. Returns a JSONResponse or raises HTTPException.
    Auth + body parsing are performed by the route wrapper before this is called."""

    # Check auth
    oauth_creds = Path("/home/appuser/.claude/.credentials.json")
    if not ANTHROPIC_API_KEY and not oauth_creds.exists():
        raise HTTPException(
            status_code=500,
            detail="No auth configured: set ANTHROPIC_API_KEY or configure OAuth credentials"
        )

    # Parse Anthropic API request fields
    system_prompt = request.get("system", "")
    messages = request.get("messages", [])
    model = request.get("model", "claude-sonnet-4-6")
    max_tokens = request.get("max_tokens", 4096)
    temperature = request.get("temperature")
    # tools/tool_choice: detect web_search requests and route through Claude Code's
    # native WebSearch + WebFetch. Other tool types are unsupported — strip them.
    tools = request.pop("tools", None)
    tool_choice = request.pop("tool_choice", None)
    has_web_search = False
    cli_allowed_tools: list[str] = []
    if tools:
        unsupported_count = 0
        for t in tools:
            if not isinstance(t, dict):
                unsupported_count += 1
                continue
            t_type = t.get("type", "")
            t_name = t.get("name", "")
            # Anthropic's native web_search tool → Claude Code's WebSearch + WebFetch
            if "web_search" in t_type or t_name == "web_search":
                has_web_search = True
            else:
                unsupported_count += 1
        if has_web_search:
            cli_allowed_tools = ["WebSearch", "WebFetch"]
            logger.info(f"/v1/messages: web_search tool detected — enabling WebSearch + WebFetch")
        if unsupported_count:
            logger.info(f"/v1/messages: stripped {unsupported_count} unsupported tool definitions")

    if not messages:
        raise HTTPException(status_code=400, detail="messages field is required")

    # Map model ID to claude CLI model name
    cli_model = MODEL_MAP.get(model, "sonnet")

    # Build prompt from system + messages
    prompt = format_messages_as_prompt(system_prompt, messages)

    # Construct append_system_prompt with formatting instructions
    if has_web_search:
        append_prompt = (
            "IMPORTANT: You are being used as a direct AI completion API with web search enabled. "
            "When the user asks to verify a fact, price, version, or claim, USE the WebSearch tool to find current information. "
            "Use WebFetch to read specific pages when a search result warrants deeper reading. "
            "Return ONLY the final answer in your requested format — no meta-commentary about which tools you used, "
            "no preamble, no mention of Claude Code or 'I searched for...'. "
            "If the answer is a JSON object, output ONLY the JSON."
        )
    else:
        append_prompt = (
            "IMPORTANT: You are being used as a direct AI completion API. "
            "Do NOT use any tools (no Bash, no file operations, no web searches). "
            "Do NOT mention Claude Code, tools, or files. "
            "Simply respond to the user's request directly with your text output. "
            "Output ONLY the requested content — no preamble, no meta-commentary."
        )

    # Build claude CLI command
    # When tools are enabled, allow multi-turn so the CLI can iterate through
    # search → synthesize. For pure completion, --max-turns 1 was too tight: large
    # generations (e.g. 18k-token lead-magnet guides) get counted as a 2nd turn and
    # return subtype="error_max_turns" with the generated text DISCARDED, which then
    # surfaced downstream as empty/garbage responses. Give completion headroom (4).
    max_turns = "15" if has_web_search else "4"
    # Prompt piped via stdin to avoid argv exec limits (large system prompts hit E2BIG)
    cmd = [
        "claude",
        "-p",
        # Stateless text generation needs ZERO MCP servers. Without these flags every
        # call boots the workspace .mcp.json servers (n8n/supabase/clickup + extras) as
        # child node processes that orphan when the CLI exits/times out and accumulate
        # across calls until the container can't fork (EAGAIN / returncode=-5). Strict +
        # empty config makes claude ignore the workspace MCP autostart entirely.
        "--strict-mcp-config",
        "--mcp-config", '{"mcpServers":{}}',
        "--model", cli_model,
        "--max-turns", max_turns,
        "--output-format", "json",
        "--permission-mode", "acceptEdits",
        "--append-system-prompt", append_prompt,
    ]
    if cli_allowed_tools:
        cmd.extend(["--allowedTools", ",".join(cli_allowed_tools)])

    result_text = await _run_claude_cli(cmd, prompt)

    # Return in Anthropic API response format
    return JSONResponse(content={
        "id": f"msg_{uuid.uuid4().hex[:24]}",
        "type": "message",
        "role": "assistant",
        "content": [{"type": "text", "text": result_text}],
        "model": model,
        "stop_reason": "end_turn",
        "stop_sequence": None,
        "usage": {
            "input_tokens": 0,  # Not tracked via CLI
            "output_tokens": 0,
        }
    })


def _reap_orphan_group(pid, label):
    """SIGKILL anything still alive in the child's process group after a NORMAL exit.

    🔴 Every spawn site here killed the group ONLY on timeout. On a clean exit the
    direct child is reaped and its grandchildren (MCP/tool node servers, CLI helper
    workers) are simply abandoned -- and normal exits massively outnumber timeouts,
    so that, not the timeout path, is the dominant way this container leaks pids
    until fork() returns EAGAIN and the whole proxy wedges.

    Safe by construction: this only ever runs AFTER communicate() has returned, so
    stdout/stderr are already captured and the response is complete. The group
    leader is gone; anything still in the group is by definition an orphan.

    ⚠ start_new_session=True at every spawn site is what makes pgid == child pid.
    If that is ever removed, this kills the PARENT's process group -- i.e. the API
    itself. Do not decouple them.
    ⚠ ProcessLookupError is the SUCCESS case (nothing left to kill), not an error.
    """
    try:
        os.killpg(pid, signal.SIGKILL)
        logger.warning(f"reaped orphaned process group after {label} (pgid {pid})")
    except ProcessLookupError:
        pass  # clean: no survivors
    except Exception as e:
        logger.warning(f"orphan reap failed for {label} (pgid {pid}): {e}")


def _run_blocking_claude(cmd, cwd, env, input_text, timeout):
    """subprocess.run replacement for the /chat paths that isolates the CLI in its OWN
    process group and SIGKILLs the WHOLE group on timeout. subprocess.run only reaps the
    direct child, so the MCP/tool grandchildren (n8n/supabase/clickup node servers the
    full-agent /chat path DOES need) orphan on every timeout and accumulate until the
    container can't fork (EAGAIN / returncode=-5), which then starves /v1/messages too.
    Mirrors the reaping already done in _run_claude_cli. Returns a CompletedProcess so
    the callers' result.stdout/.stderr/.returncode interface is unchanged."""
    proc = subprocess.Popen(
        cmd, cwd=cwd, env=env,
        stdin=subprocess.PIPE, stdout=subprocess.PIPE, stderr=subprocess.PIPE,
        text=True, start_new_session=True,  # own process group → kill the whole tree
    )
    try:
        stdout, stderr = proc.communicate(input=input_text, timeout=timeout)
    except subprocess.TimeoutExpired:
        try:
            os.killpg(os.getpgid(proc.pid), signal.SIGKILL)
            proc.wait()
        except Exception:
            try:
                proc.kill()
                proc.wait()
            except Exception:
                pass
        raise
    _reap_orphan_group(proc.pid, "_run_blocking_claude normal exit")
    return subprocess.CompletedProcess(cmd, proc.returncode, stdout, stderr)


async def _run_claude_cli(cmd: list, prompt: str) -> str:
    """Run the claude CLI subprocess with retry/backoff and return its parsed text
    result. Shared by /v1/messages (text completion) and /v1/vision-qa (image Read).
    Raises a retryable HTTPException on persistent empty/transient failure."""
    env = build_base_env()

    # Transient inner-CLI failures (Anthropic overloaded_error / rate-limit / upstream
    # 5xx, or fork/EAGAIN + dropped connections under concurrent load) are retryable,
    # but were previously surfaced as an immediate hard 500 with no retry — the root
    # cause of intermittent "Request failed with status code 500" / "connection closed
    # unexpectedly" errors across every workflow on the proxy. Retry with backoff, then
    # return a retryable 503 (with Retry-After) so callers/n8n retry instead of failing.
    MAX_ATTEMPTS = 3
    TRANSIENT_MARKERS = (
        "overloaded", "rate limit", "rate_limit", "429", "500", "502", "503", "504",
        "529", "internal server error", "service unavailable", "bad gateway",
        "gateway timeout", "econnreset", "etimedout", "connection error",
        "connection reset", "connection closed", "temporarily", "try again",
        "resource temporarily unavailable", "eagain",
        # cold-start race: first request after a container restart can hit the claude
        # CLI before stdin is wired up — self-heal by retrying (warm container succeeds).
        "no stdin data received", "input must be provided",
    )

    def _is_transient(text: str) -> bool:
        t = (text or "").lower()
        return any(m in t for m in TRANSIENT_MARKERS)

    # [cli-timing] Instrumentation to separate slot-queue wait from actual CLI exec
    # duration. Heavy generations either genuinely run long (exec) OR starve on the
    # CLAUDE_SEMAPHORE (queue_wait); n8n's 600s HTTP timeout can't tell which. Logging
    # only, no behavior change. Grep logs for "[cli-timing]".
    import time as _time
    _t_arrive = _time.monotonic()
    _model = cmd[cmd.index("--model") + 1] if "--model" in cmd else "?"

    last_error = ""
    for attempt in range(1, MAX_ATTEMPTS + 1):
        try:
            async with acquire_claude_slot():
                _t_slot = _time.monotonic()
                _queue_wait = _t_slot - _t_arrive
                process = await asyncio.create_subprocess_exec(
                    *cmd,
                    cwd=WORKSPACE_DIR,
                    env=env,
                    stdin=asyncio.subprocess.PIPE,
                    stdout=asyncio.subprocess.PIPE,
                    stderr=asyncio.subprocess.PIPE,
                    start_new_session=True,  # own process group → kill the whole tree, not just claude
                )

                try:
                    stdout, stderr = await asyncio.wait_for(
                        process.communicate(input=prompt.encode("utf-8")),
                        timeout=CLI_EXEC_TIMEOUT
                    )
                    _exec = _time.monotonic() - _t_slot
                except asyncio.TimeoutError:
                    print(
                        f"[cli-timing] attempt={attempt} model={_model} "
                        f"queue_wait={_queue_wait:.1f}s exec={_time.monotonic()-_t_slot:.1f}s "
                        f"out_bytes=0 result=TIMEOUT",
                        flush=True,
                    )
                    # Kill the ENTIRE process group (claude + any child MCP/tool procs) so
                    # nothing orphans and holds this slot + RAM/CPU/PIDs — lingering children
                    # were feeding the EAGAIN/returncode=-5 exhaustion.
                    try:
                        os.killpg(os.getpgid(process.pid), signal.SIGKILL)
                        await process.wait()
                    except Exception:
                        try:
                            process.kill()
                            await process.wait()
                        except Exception:
                            pass
                    raise

            _reap_orphan_group(process.pid, "_run_claude_cli normal exit")

            output = stdout.decode("utf-8", errors="replace").strip()
            stderr_text = stderr.decode("utf-8", errors="replace").strip()
            print(  # print→stdout so it reaches Railway logs regardless of logger config (temp diag)
                f"[cli-timing] attempt={attempt} model={_model} "
                f"queue_wait={_queue_wait:.1f}s exec={_exec:.1f}s "
                f"out_bytes={len(stdout)} rc={process.returncode} result=OK",
                flush=True,
            )

            # Parse claude CLI JSON output
            result_text = ""
            if output:
                try:
                    cli_result = json.loads(output)
                    # Primary: "result" field has the text response
                    result_text = cli_result.get("result", "")

                    # CLI error results (e.g. subtype="error_max_turns", is_error=true)
                    # carry NO usable assistant text — only run metadata. Never leak that
                    # metadata JSON downstream as if it were content; force the empty-retry
                    # path below instead. (Root cause of intermittent garbage responses.)
                    cli_is_error = bool(cli_result.get("is_error")) or str(
                        cli_result.get("subtype", "")
                    ).startswith("error")

                    # If result is empty or looks like JSON metadata, try session content blocks
                    if not result_text or (isinstance(result_text, str) and result_text.startswith("{")):
                        try:
                            meta = json.loads(result_text) if isinstance(result_text, str) else result_text
                            if isinstance(meta, dict) and meta.get("type") == "result":
                                result_text = ""  # Clear metadata, fall through to content extraction
                        except (json.JSONDecodeError, TypeError):
                            pass

                    # Fallback: extract from content_blocks
                    if not result_text:
                        for block in cli_result.get("content", []):
                            if isinstance(block, dict) and block.get("type") == "text":
                                result_text += block.get("text", "")

                    if cli_is_error and not result_text:
                        # Record the CLI error and leave result_text empty → retry path.
                        last_error = (
                            f"CLI {cli_result.get('subtype', 'error')}: "
                            f"{(cli_result.get('errors') or [''])[0]}"
                        )[:300]
                    elif not result_text:
                        # Genuinely no structured text but not an error result — use raw output.
                        result_text = output

                except json.JSONDecodeError:
                    # Plain text output
                    result_text = output

            if not result_text:
                # Empty completion. This includes the previously-silent case where the CLI
                # produced NO stdout and NO stderr (returncode 0) — which used to fall
                # through and return a 200 with empty text, letting downstream callers
                # (e.g. the LM QA node) "succeed" on nothing, then halt and DISCARD good
                # generated content. Never return an empty 200: log the raw CLI output so
                # the real cause is visible, retry, then surface a retryable 503.
                rc = process.returncode
                last_error = (
                    stderr_text
                    or f"empty CLI output (returncode={rc}, stdout_len={len(output)})"
                )[:500]
                logger.warning(
                    f"/v1/messages empty completion (attempt {attempt}/{MAX_ATTEMPTS}, "
                    f"returncode={rc}, stdout_len={len(output)}, stderr_len={len(stderr_text)}): "
                    f"{(output or stderr_text or '<stdout+stderr both empty>')[:400]}"
                )
                if attempt < MAX_ATTEMPTS:
                    backoff = 2 * attempt
                    await asyncio.sleep(backoff)
                    continue
                raise HTTPException(
                    status_code=503,
                    detail=f"Claude CLI returned no content after {MAX_ATTEMPTS} attempts: {last_error}",
                    headers={"Retry-After": "5"},
                )

            return result_text

        except asyncio.TimeoutError:
            raise HTTPException(status_code=504, detail=f"Claude CLI execution timed out ({int(CLI_EXEC_TIMEOUT)}s)")
        except HTTPException:
            raise
        except Exception as e:
            # Subprocess spawn failure (EAGAIN/OSError) or dropped connection under
            # load — transient. Retry with backoff, then surface as retryable 503.
            last_error = str(e)[:300]
            if attempt < MAX_ATTEMPTS:
                backoff = 2 * attempt
                logger.warning(
                    f"/v1/messages spawn/exec error (attempt {attempt}/{MAX_ATTEMPTS}), "
                    f"retrying in {backoff}s: {last_error}"
                )
                await asyncio.sleep(backoff)
                continue
            logger.error(f"/v1/messages error after {MAX_ATTEMPTS} attempts: {e}")
            raise HTTPException(
                status_code=503,
                detail=f"Proxy error after {MAX_ATTEMPTS} attempts: {last_error}",
                headers={"Retry-After": "5"},
            )

    # Loop exhausted without return/raise (defensive — should be unreachable).
    raise HTTPException(
        status_code=503,
        detail=f"Claude CLI error after {MAX_ATTEMPTS} attempts: {last_error or 'no output'}",
        headers={"Retry-After": "5"},
    )


_VISION_EXT = {
    "image/png": "png",
    "image/jpeg": "jpg",
    "image/jpg": "jpg",
    "image/webp": "webp",
    "image/gif": "gif",
}


@app.post("/v1/vision-qa")
async def vision_qa_proxy(
    raw_request: Request,
    x_api_key: Optional[str] = Header(None),
    authorization: Optional[str] = Header(None),
):
    """Vision QA on the Max subscription — WITHOUT spending Anthropic API credits.

    The /v1/messages text path is vision-BLIND: format_messages_as_prompt drops image
    blocks to "[image omitted]" before invoking `claude -p`, so any image-bearing QA
    routed there always sees nothing (the root cause of garbled carousel slides passing
    QA). The CLI itself CAN see images — its Read tool returns image pixels to the model.
    So here we write the image to a file inside the workspace and tell the CLI to Read it,
    which runs on the Max OAuth subscription exactly like every other proxy call.

    Request body:
      { "image": "<base64>" (data: prefix optional)  OR  "image_url": "https://...",
        "media_type": "image/png" (optional, default png),
        "instructions": "<what to check; ask for JSON>",
        "model": "claude-sonnet-4-6" (optional) }

    Returns the same Anthropic shape as /v1/messages: content[0].text holds the result.
    Supports X-Heartbeat: 1 (CLI image reads can run long under load)."""
    api_key = x_api_key
    if not api_key and authorization:
        api_key = authorization.replace("Bearer ", "").strip()
    verify_api_key(api_key)

    request = await raw_request.json()
    return await _run_with_heartbeat(raw_request, _vision_qa_core(request))


async def _decode_qa_image(item):
    """Resolve one QA image item -> (bytes, media_type, label).
    item may be a bare base64 string, or a dict with image|data (base64) / image_url|url,
    plus optional media_type and label."""
    if isinstance(item, str):
        item = {"image": item}
    if not isinstance(item, dict):
        raise HTTPException(status_code=400, detail="each image must be a base64 string or an object")
    b64 = item.get("image") or item.get("data")
    url = item.get("image_url") or item.get("url")
    media_type = (item.get("media_type") or "image/png").lower()
    if b64:
        if b64.startswith("data:"):
            # data:image/png;base64,XXXX -> XXXX (and pick up the real media type)
            header, _, b64 = b64.partition(",")
            if ";" in header and ":" in header:
                media_type = header.split(":", 1)[1].split(";", 1)[0].lower() or media_type
        data = base64.b64decode(b64)
    elif url:
        async with httpx.AsyncClient() as client:
            r = await client.get(url, timeout=30.0)
            r.raise_for_status()
            data = r.content
            ct = (r.headers.get("content-type") or "").split(";")[0].strip().lower()
            if ct in _VISION_EXT:
                media_type = ct
    else:
        raise HTTPException(status_code=400, detail="each image needs `image` (base64) or `image_url`")
    if not data:
        raise HTTPException(status_code=400, detail="an image payload was empty")
    return data, media_type, (item.get("label") or "")


async def _vision_qa_core(request: dict):
    """Core vision-QA generation. Writes the image(s) to the workspace, runs the CLI
    with the Read tool enabled, returns a JSONResponse. Always cleans up temp files.

    Accepts a single image (`image` base64 / `image_url`) OR an ordered `images` list
    of {image|data (base64) | image_url, media_type, label} for multi-image QA such as
    face-identity comparison (reference photo + slide)."""
    oauth_creds = Path("/home/appuser/.claude/.credentials.json")
    if not ANTHROPIC_API_KEY and not oauth_creds.exists():
        raise HTTPException(
            status_code=500,
            detail="No auth configured: set ANTHROPIC_API_KEY or configure OAuth credentials",
        )

    instructions = (request.get("instructions") or request.get("prompt") or "").strip()
    model = request.get("model", "claude-sonnet-4-6")
    cli_model = MODEL_MAP.get(model, "sonnet")

    if not instructions:
        raise HTTPException(status_code=400, detail="instructions (or prompt) field is required")

    # Normalize to an ordered list of image items.
    raw_items = request.get("images")
    if not raw_items:
        if not request.get("image") and not request.get("image_url"):
            raise HTTPException(status_code=400, detail="image / image_url / images is required")
        raw_items = [{
            "image": request.get("image"),
            "image_url": request.get("image_url"),
            "media_type": request.get("media_type"),
            "label": request.get("label"),
        }]
    if not isinstance(raw_items, list) or not raw_items:
        raise HTTPException(status_code=400, detail="images must be a non-empty list")

    # Write each into the workspace so the CLI's Read tool (cwd=WORKSPACE_DIR) can open it.
    tmp_dir = Path(WORKSPACE_DIR) / ".vision-qa"
    tmp_dir.mkdir(parents=True, exist_ok=True)
    written = []  # list of (Path, label)

    try:
        for idx, item in enumerate(raw_items):
            try:
                data, media_type, label = await _decode_qa_image(item)
            except HTTPException:
                raise
            except Exception as e:
                raise HTTPException(status_code=400, detail=f"Could not load image {idx}: {str(e)[:200]}")
            ext = _VISION_EXT.get(media_type, "png")
            p = tmp_dir / f"qa_{uuid.uuid4().hex}.{ext}"
            p.write_bytes(data)
            written.append((p, label))

        if len(written) == 1 and not written[0][1]:
            file_instr = f"Use the Read tool to open the image file at {written[0][0]}"
        else:
            lines = []
            for i, (p, label) in enumerate(written, 1):
                tag = f"  ({label})" if label else ""
                lines.append(f"  {i}. {p}{tag}")
            file_instr = "Use the Read tool to open EACH of these image files, in order:\n" + "\n".join(lines)

        prompt = (
            f"{file_instr}\n\n"
            f"Then perform this visual QA on the IMAGE(S) you just read:\n\n{instructions}"
        )
        append_prompt = (
            "IMPORTANT: You are a vision QA API. You MUST use the Read tool to open the "
            "image file(s) at the path(s) given, then judge the actual IMAGE PIXELS "
            "(rendered text, layout, faces, artifacts) — never the filename. Output ONLY "
            "the requested result (JSON only if JSON is requested) — no preamble, no "
            "mention of tools, files, or Claude Code."
        )
        cmd = [
            "claude",
            "-p",
            # Same MCP-orphan guard as /v1/messages: zero MCP servers for a stateless call.
            "--strict-mcp-config",
            "--mcp-config", '{"mcpServers":{}}',
            "--model", cli_model,
            "--max-turns", "4",  # Read -> analyze -> answer; headroom for a re-read
            "--output-format", "json",
            "--permission-mode", "acceptEdits",
            "--allowedTools", "Read",  # the whole point: let the CLI SEE the image
            "--append-system-prompt", append_prompt,
        ]

        result_text = await _run_claude_cli(cmd, prompt)

        return JSONResponse(content={
            "id": f"msg_{uuid.uuid4().hex[:24]}",
            "type": "message",
            "role": "assistant",
            "content": [{"type": "text", "text": result_text}],
            "model": model,
            "stop_reason": "end_turn",
            "stop_sequence": None,
            "usage": {"input_tokens": 0, "output_tokens": 0},
        })
    finally:
        for p, _ in written:
            try:
                p.unlink()
            except Exception:
                pass


# Also support the anthropic-version header check (n8n SDK sends this)
@app.get("/v1/models")
async def list_models(x_api_key: Optional[str] = Header(None)):
    """Minimal models endpoint for SDK compatibility."""
    return JSONResponse(content={
        "data": [
            {"id": "claude-opus-4-8", "type": "model"},
            {"id": "claude-opus-4-7", "type": "model"},
            {"id": "claude-opus-4-6", "type": "model"},
            {"id": "claude-sonnet-4-6", "type": "model"},
            {"id": "claude-haiku-4-5", "type": "model"},
        ]
    })


# ============================================================================
# LM Curator — server-side scoring loop (2026-06-22)
# ----------------------------------------------------------------------------
# WHY THIS EXISTS: each scoring call is ~108-200s (Claude CLI subprocess overhead,
# NOT output size). n8n kills scheduled nodes at ~120s, so the scoring LOOP could
# never run there reliably — it silently scored 0 for weeks. This runs the loop
# HERE as a detached background task with no HTTP/node timeout: fetch pending ->
# score via our own /v1/messages (same CLI/semaphore/OAuth path) -> apply the prod
# composite + reject rules (mirrors the n8n "Apply Scores" node EXACTLY) -> write
# back to Supabase. n8n (or cron) just fires POST /score-pending and returns.
# Idempotent: only touches status=pending, so a mid-run restart just resumes.
# ============================================================================
import datetime as _dt2

LM_SCORER_SLUG = "lm-curator-system-prompt"
LM_SCORER_BATCH = int(os.environ.get("LM_SCORER_BATCH", "6"))
LM_SCORER_MODEL = os.environ.get("LM_SCORER_MODEL", "claude-sonnet-4-6")
_lm_scorer_state = {"running": False, "started_at": None, "finished_at": None,
                    "scored": 0, "archived": 0, "failed": 0, "total": 0, "last_error": None}


async def _lm_supa(method: str, path: str, body=None):
    headers = {"apikey": SUPABASE_SERVICE_KEY, "Authorization": f"Bearer {SUPABASE_SERVICE_KEY}",
               "Content-Type": "application/json", "Prefer": "return=minimal"}
    async with httpx.AsyncClient(timeout=45) as c:
        r = await c.request(method, f"{SUPABASE_URL}/rest/v1/{path}", headers=headers,
                            json=body if body is not None else None)
        if method == "GET":
            r.raise_for_status()
            return r.json()
        return r.status_code


def _lm_apply(r: dict, cand: dict):
    """Mirror of the n8n 'Apply Scores to Candidates' node: composite v2 + 4 reject rules."""
    icp = float(r.get("icp_fit_score") or 0); vir = float(r.get("virality_score") or 0)
    gap = float(r.get("gap_score") or 0); beat = float(r.get("beat_fit_score") or 0)
    why = r.get("why_score") or None
    fmt = r.get("format_recommendation") or None
    content_type = (r.get("content_type") or "lead_magnet").lower()
    ss = cand.get("signal_strength") or 0
    composite = round(vir * 3.0 + gap * 3.0 + icp * 1.5 + beat * 1.5 + ss / 100.0, 2)
    if cand.get("ivan_engaged") is True:
        composite += 2
    status, reason = "scored", None
    if icp < 4 or vir < 4 or gap < 4:
        composite = -1; status = "archived"; reason = "hard_reject:below_floor:" + (why or "")
    elif vir == 4 and icp < 6:
        composite = -1; status = "archived"; reason = "reject:virality4_weak_icp:" + (why or "")
    elif icp <= 5 and vir <= 5:
        composite = -1; status = "archived"; reason = "reject:mid_band_filler:" + (why or "")
    elif beat < 5:
        composite = -1; status = "archived"; reason = "reject:off_beat:" + (why or "")
    patch = {
        "scored_at": _dt2.datetime.utcnow().isoformat() + "Z",
        "icp_fit_score": icp, "virality_score": vir, "gap_score": gap, "beat_fit_score": beat,
        "composite_score": composite, "format_recommendation": fmt,
        "offer_ladder_map": r.get("offer_ladder_map") or None, "why_score": why,
        "status": status, "archived_reason": reason, "content_type": content_type,
        "normalized_topic": r.get("normalized_topic") or None, "post_angle": r.get("post_angle") or None,
    }
    return patch, status


async def _lm_score_batch(system_prompt: str, batch: list):
    user = ("Score the following candidates and return a JSON array. Each element must include "
            "candidate_id matching the input.\n\n" + json.dumps(
        [{"candidate_id": c["id"], "source": c.get("source"), "raw_topic": c.get("raw_topic"),
          "evidence_summary": (c["evidence"][:3] if isinstance(c.get("evidence"), list) else c.get("evidence")),
          "signal_strength": c.get("signal_strength")} for c in batch], indent=2))
    # Call our OWN /v1/messages on localhost — reuses the CLI path, semaphore, OAuth, retries.
    async with httpx.AsyncClient(timeout=300) as c:
        r = await c.post(f"http://127.0.0.1:{PORT}/v1/messages",
                         headers={"X-API-Key": API_KEY, "Content-Type": "application/json"},
                         json={"model": LM_SCORER_MODEL, "max_tokens": 8000, "system": system_prompt,
                               "messages": [{"role": "user", "content": user}]})
    if r.status_code >= 400:
        raise RuntimeError(f"score call http {r.status_code}: {r.text[:120]}")
    txt = ((r.json().get("content") or [{}])[0].get("text") or "").strip()
    if txt.startswith("```"):
        txt = txt.split("```", 2)[1]
        if txt.startswith("json"):
            txt = txt[4:]
        txt = txt.strip().rstrip("`").strip()
    parsed = json.loads(txt)
    return parsed if isinstance(parsed, list) else []


async def _lm_run_scorer():
    st = _lm_scorer_state
    st.update({"running": True, "started_at": _dt2.datetime.utcnow().isoformat() + "Z",
               "finished_at": None, "scored": 0, "archived": 0, "failed": 0, "total": 0, "last_error": None})
    try:
        prows = await _lm_supa("GET", f"content_prompts?slug=eq.{LM_SCORER_SLUG}&is_active=eq.true&select=body&limit=1")
        if not prows:
            st["last_error"] = "no active lm-curator-system-prompt"
            return
        # v1: strip unfilled few-shot example placeholders (the rubric + v5 calibration carry scoring).
        system_prompt = re.sub(r"\{LM_CURATOR_[A-Z_]+\}", "", prows[0]["body"])
        cands = await _lm_supa("GET", "lm_idea_candidates?status=eq.pending&select=id,source,raw_topic,evidence,signal_strength,ivan_engaged&order=ingested_at.asc&limit=200")
        st["total"] = len(cands)
        for i in range(0, len(cands), LM_SCORER_BATCH):
            batch = cands[i:i + LM_SCORER_BATCH]
            try:
                results = await _lm_score_batch(system_prompt, batch)
            except Exception as e:
                st["failed"] += len(batch); st["last_error"] = str(e)[:200]
                logger.warning(f"lm-scorer batch failed (rows stay pending, retried next run): {e}")
                continue
            by = {x.get("candidate_id"): x for x in results if isinstance(x, dict) and x.get("candidate_id")}
            for c in batch:
                sc = by.get(c["id"])
                if not sc:
                    st["failed"] += 1
                    continue
                patch, status = _lm_apply(sc, c)
                code = await _lm_supa("PATCH", f"lm_idea_candidates?id=eq.{c['id']}", patch)
                if code and code < 400:
                    st["archived" if status == "archived" else "scored"] += 1
                else:
                    st["failed"] += 1
        logger.info(f"lm-scorer done: scored={st['scored']} archived={st['archived']} failed={st['failed']} of {st['total']}")
    except Exception as e:
        st["last_error"] = str(e)[:300]
        logger.error(f"lm-scorer crashed: {e}")
    finally:
        st["running"] = False
        st["finished_at"] = _dt2.datetime.utcnow().isoformat() + "Z"
        # Chain the post-idea editorial pass so freshly-scored ideas get their
        # Opus editorial assessment with no separate trigger. Idempotent + detached.
        try:
            if not _lm_editorial_state["running"]:
                asyncio.create_task(_lm_run_editorial())
        except Exception as _e:
            logger.warning(f"editorial chain kick failed: {_e}")


@app.post("/score-pending")
async def score_pending(x_api_key: Optional[str] = Header(None), authorization: Optional[str] = Header(None)):
    """Fire-and-forget: kick the server-side LM Curator scoring loop. Returns immediately;
    work runs detached with NO timeout (the n8n ~120s per-node limit was the original bug).
    Idempotent — only scores status=pending rows, so concurrent/duplicate fires are safe."""
    key = x_api_key or (authorization.replace("Bearer ", "").strip() if authorization else None)
    verify_api_key(key)
    if _lm_scorer_state["running"]:
        return {"status": "already_running", "state": _lm_scorer_state}
    asyncio.create_task(_lm_run_scorer())
    return {"status": "started"}


@app.get("/score-pending/status")
async def score_pending_status(x_api_key: Optional[str] = Header(None), authorization: Optional[str] = Header(None)):
    key = x_api_key or (authorization.replace("Bearer ", "").strip() if authorization else None)
    verify_api_key(key)
    return _lm_scorer_state


# ============================================================================
# SERVER-SIDE POST-IDEA EDITORIAL PASS  (POST /editorial-pending)
# ----------------------------------------------------------------------------
# Same detached, no-timeout pattern as /score-pending — because each Opus call
# hits the same CLI spin-up floor (~108-200s) that exceeds n8n's ~120s node kill.
# Runs the post-idea editorial assessment (Opus) on SCORED post candidates that
# don't yet have an editorial_assessment, and writes:
#   editorial_assessment (2-3 sentences) + editorial_strength (High|Mid|Low)
#   + format_recommendation ONLY when the scorer left it null (fills gaps /
#     adds fitting variety; never overrides an existing recommendation).
# The Scorer is left 100% untouched (its calibration is load-bearing).
# ============================================================================
LM_EDITORIAL_SLUG = "editorial-post-idea"
LM_EDITORIAL_BATCH = int(os.environ.get("LM_EDITORIAL_BATCH", "4"))
LM_EDITORIAL_MODEL = os.environ.get("LM_EDITORIAL_MODEL", "claude-opus-4-8")
_VALID_FMT = {"text", "single_image", "carousel", "video"}
_lm_editorial_state = {"running": False, "started_at": None, "finished_at": None,
                       "assessed": 0, "failed": 0, "total": 0, "last_error": None}


async def _lm_editorial_batch(system_prompt: str, batch: list):
    user = ("Assess the following post ideas editorially and return ONLY a JSON array. "
            "Each element must include candidate_id matching the input.\n\n" + json.dumps(
        [{"candidate_id": c["id"], "source": c.get("source"), "raw_topic": c.get("raw_topic"),
          "normalized_topic": c.get("normalized_topic"), "post_angle": c.get("post_angle"),
          "why_score": c.get("why_score"),
          "evidence": (c["evidence"][:3] if isinstance(c.get("evidence"), list) else c.get("evidence")),
          "icp_fit_score": c.get("icp_fit_score"), "virality_score": c.get("virality_score"),
          "gap_score": c.get("gap_score"), "composite_score": c.get("composite_score")} for c in batch], indent=2))
    async with httpx.AsyncClient(timeout=600) as c:
        r = await c.post(f"http://127.0.0.1:{PORT}/v1/messages",
                         headers={"X-API-Key": API_KEY, "Content-Type": "application/json"},
                         json={"model": LM_EDITORIAL_MODEL, "max_tokens": 4000, "system": system_prompt,
                               "messages": [{"role": "user", "content": user}]})
    if r.status_code >= 400:
        raise RuntimeError(f"editorial call http {r.status_code}: {r.text[:120]}")
    txt = ((r.json().get("content") or [{}])[0].get("text") or "").strip()
    if txt.startswith("```"):
        txt = txt.split("```", 2)[1]
        if txt.startswith("json"):
            txt = txt[4:]
        txt = txt.strip().rstrip("`").strip()
    # Opus sometimes adds a preamble or trailing prose around the array — extract
    # the bracketed JSON span rather than failing the whole batch.
    try:
        parsed = json.loads(txt)
    except Exception:
        a, b = txt.find("["), txt.rfind("]")
        parsed = json.loads(txt[a:b + 1]) if (a != -1 and b > a) else []
    return parsed if isinstance(parsed, list) else []


async def _lm_run_editorial():
    st = _lm_editorial_state
    st.update({"running": True, "started_at": _dt2.datetime.utcnow().isoformat() + "Z",
               "finished_at": None, "assessed": 0, "failed": 0, "total": 0, "last_error": None})
    try:
        prows = await _lm_supa("GET", f"content_prompts?slug=eq.{LM_EDITORIAL_SLUG}&is_active=eq.true&select=body&limit=1")
        if not prows:
            st["last_error"] = "no active editorial-post-idea prompt"
            return
        system_prompt = prows[0]["body"]
        # Post candidates that are scored/reviewing and not yet editorially assessed.
        cands = await _lm_supa("GET", (
            "lm_idea_candidates?content_type=eq.post&status=in.(scored,reviewing)"
            "&editorial_assessment=is.null"
            "&select=id,source,raw_topic,normalized_topic,post_angle,why_score,evidence,"
            "icp_fit_score,virality_score,gap_score,composite_score,format_recommendation"
            "&order=composite_score.desc.nullslast&limit=200"))
        st["total"] = len(cands)
        for i in range(0, len(cands), LM_EDITORIAL_BATCH):
            batch = cands[i:i + LM_EDITORIAL_BATCH]
            try:
                results = await _lm_editorial_batch(system_prompt, batch)
            except Exception as e:
                st["failed"] += len(batch); st["last_error"] = str(e)[:200]
                logger.warning(f"lm-editorial batch failed (rows stay null, retried next run): {e}")
                continue
            by = {x.get("candidate_id"): x for x in results if isinstance(x, dict) and x.get("candidate_id")}
            for c in batch:
                ed = by.get(c["id"])
                if not ed:
                    st["failed"] += 1
                    continue
                assessment = (ed.get("editorial_assessment") or "").strip() or None
                strength = (ed.get("editorial_strength") or "").strip().title()
                if strength not in ("High", "Mid", "Low"):
                    strength = None
                patch = {"editorial_assessment": assessment, "editorial_strength": strength}
                # Fill format only when the scorer left none (don't override / don't force variety).
                fmt = (ed.get("format_recommendation") or "").strip().lower()
                if fmt in _VALID_FMT and not (c.get("format_recommendation") or "").strip():
                    patch["format_recommendation"] = fmt
                code = await _lm_supa("PATCH", f"lm_idea_candidates?id=eq.{c['id']}", patch)
                if code and code < 400:
                    st["assessed"] += 1
                else:
                    st["failed"] += 1
        logger.info(f"lm-editorial done: assessed={st['assessed']} failed={st['failed']} of {st['total']}")
    except Exception as e:
        st["last_error"] = str(e)[:300]
        logger.error(f"lm-editorial crashed: {e}")
    finally:
        st["running"] = False
        st["finished_at"] = _dt2.datetime.utcnow().isoformat() + "Z"


@app.post("/editorial-pending")
async def editorial_pending(x_api_key: Optional[str] = Header(None), authorization: Optional[str] = Header(None)):
    """Fire-and-forget: kick the server-side post-idea editorial pass (Opus). Returns
    immediately; work runs detached with NO timeout. Idempotent — only touches post
    candidates with editorial_assessment IS NULL, so duplicate fires are safe."""
    key = x_api_key or (authorization.replace("Bearer ", "").strip() if authorization else None)
    verify_api_key(key)
    if _lm_editorial_state["running"]:
        return {"status": "already_running", "state": _lm_editorial_state}
    asyncio.create_task(_lm_run_editorial())
    return {"status": "started"}


@app.get("/editorial-pending/status")
async def editorial_pending_status(x_api_key: Optional[str] = Header(None), authorization: Optional[str] = Header(None)):
    key = x_api_key or (authorization.replace("Bearer ", "").strip() if authorization else None)
    verify_api_key(key)
    return _lm_editorial_state


# ============================================================================
# SERVER-SIDE CALL CLIP EXTRACTOR  (POST /extract-clips)
# ----------------------------------------------------------------------------
# Same detached pattern as /score-pending. The n8n "Call Clip Extractor" wf
# (Rm4fFERNtVQq9cRn) ran the Claude call INSIDE the workflow, so very long
# calls (813+ utt) hit n8n's ~120s node kill AND Railway's ~300s edge cap and
# silently produced no clips. This runs the extraction HERE as a background
# task with NO HTTP/edge timeout: it calls our OWN /v1/messages over localhost
# (127.0.0.1 — bypasses Railway's edge 502) so the slow CLI has the full 900s.
# Faithful port of the n8n nodes: Build Claude Payload -> Call Claude ->
# Parse and Filter Candidates -> Insert to video_shorts. n8n just fires this
# and returns. Idempotent: clears prior status=pending clips for the recording
# before re-inserting, so duplicate fires are safe.
# ============================================================================
CLIP_MODEL = os.environ.get("CLIP_MODEL", "claude-sonnet-4-6")
CLIP_PROMPT_SLUG = "call-clip-extractor-prompt"
_clip_state: dict = {}  # transcript_id -> {running, started_at, finished_at, candidates, inserted, error}
_PROPER_NOUN_RE = re.compile(r"\b[A-Z][a-z]+ [A-Z][a-z]+\b")
_COMPANY_RE = re.compile(r"\b[A-Z][a-z]+ (Inc|Corp|LLC|Ltd)\b")


def _clip_now() -> str:
    return _dt2.datetime.utcnow().isoformat() + "Z"


def _clip_build_user_message(transcript: list, speaker_map: dict, meeting_id: str,
                             transcript_id: str, screen_context: str):
    """Port of the n8n 'Build Claude Payload' node. `transcript` utterances carry
    start/end already in MILLISECONDS (caller normalizes seconds->ms)."""
    speaker_map = speaker_map or {}
    ivan_label = ""
    for label, name in speaker_map.items():
        if isinstance(name, str) and "ivan" in name.lower():
            ivan_label = label
            break
    lines = []
    for utt in transcript:
        start = utt.get("start")
        if not isinstance(start, (int, float)):
            start = utt.get("start_ms", 0)
        start_ms = int(start or 0)
        speaker = speaker_map.get(utt.get("speaker")) or utt.get("speaker") or "Unknown"
        lines.append(f"[{start_ms}ms] {speaker}: {utt.get('text', '')}")
    user = "\n".join([
        f"meeting_id: {meeting_id}",
        f"transcript_id: {transcript_id}",
        f"ivan_speaker_label: {ivan_label}",
        f"speaker_map: {json.dumps(speaker_map)}",
        f"screen_context: {screen_context}",
        "",
        "TRANSCRIPT:",
        "\n".join(lines),
    ])
    return user, ivan_label


def _clip_parse_json(txt: str):
    """Port of the n8n parse step: strip ``` fences, fall back to the first {...} block."""
    txt = (txt or "").strip()
    if txt.startswith("```"):
        txt = txt.split("```", 2)[1]
        if txt.startswith("json"):
            txt = txt[4:]
        txt = txt.strip().rstrip("`").strip()
    try:
        return json.loads(txt)
    except Exception:
        m = re.search(r"\{[\s\S]*\}", txt)
        if m:
            return json.loads(m.group(0))
        raise


def _clip_filter_candidates(parsed: dict, meeting_id: str) -> list:
    """Port of the n8n 'Parse and Filter Candidates' node -> video_shorts rows."""
    candidates = (parsed or {}).get("candidates") or []
    rows = []
    for c in candidates:
        if (c.get("score") or 0) < 7:
            continue
        quote = c.get("ivan_quote_full") or ""
        if _PROPER_NOUN_RE.search(quote) or _COMPANY_RE.search(quote):
            continue
        start_ms = c.get("start_ms") or 0
        end_ms = c.get("end_ms") or 0
        if not start_ms or not end_ms:
            continue
        hook = c.get("hook_line") or ""
        rows.append({
            "source_type": "call_recording",
            "source_recording_id": meeting_id,
            "start_time": start_ms / 1000.0,
            "end_time": end_ms / 1000.0,
            "score": c.get("score"),
            "transcript_text": quote,
            "hook_line": hook,
            "suggested_caption": hook + ("\n\n" + quote if quote != hook else ""),
            "anonymization_flags": c.get("anonymization_flags") or [],
            "needs_explicit_consent": c.get("needs_explicit_consent") is True,
            "title": hook or ("Call clip from " + meeting_id),
            "status": "pending",
            "format": "short",
        })
    return rows


async def _run_clip_extract(transcript_id: str, meeting_id: str,
                            inline_transcript=None, inline_speaker_map=None, screen_context: str = ""):
    st = _clip_state[transcript_id]
    st.update({"running": True, "started_at": _clip_now(), "finished_at": None,
               "candidates": 0, "inserted": 0, "error": None})
    try:
        # 1. Resolve the transcript. Prefer the inline payload (already ms, from the
        #    n8n Fire node); otherwise fetch transcript_json (seconds) and convert.
        if inline_transcript:
            transcript = inline_transcript
            speaker_map = inline_speaker_map or {"ivan": "Ivan"}
        else:
            rows = await _lm_supa("GET", f"transcripts?fireflies_id=eq.{urllib.parse.quote(transcript_id)}"
                                         "&select=transcript_json,speaker_map,platform&limit=1")
            if not rows or not rows[0].get("transcript_json"):
                st["error"] = f"no transcript_json for {transcript_id}"
                return
            tj = rows[0]["transcript_json"]
            speaker_map = rows[0].get("speaker_map") or {"ivan": "Ivan"}
            screen_context = screen_context or (rows[0].get("platform") or "")
            transcript = [{"speaker": u.get("speaker"), "text": u.get("text"),
                           "start": round((u.get("start") or 0) * 1000),
                           "end": round((u.get("end") or 0) * 1000)} for u in tj]

        # 2. System prompt (migrated ClickUp -> content_prompts).
        prows = await _lm_supa("GET", f"content_prompts?slug=eq.{CLIP_PROMPT_SLUG}&select=body&limit=1")
        system_prompt = (prows[0]["body"] if prows else "") or ""
        if not system_prompt:
            st["error"] = "empty system prompt (content_prompts slug missing)"
            return

        user_message, _ = _clip_build_user_message(transcript, speaker_map, meeting_id, transcript_id, screen_context)

        # 3. Call our OWN /v1/messages over localhost — same CLI/OAuth/semaphore path,
        #    but no Railway edge (no 302s->502) and the full 900s CLI budget.
        async with httpx.AsyncClient(timeout=900) as c:
            r = await c.post(f"http://127.0.0.1:{PORT}/v1/messages",
                             headers={"X-API-Key": API_KEY, "Content-Type": "application/json"},
                             json={"model": CLIP_MODEL, "max_tokens": 4000, "system": system_prompt,
                                   "messages": [{"role": "user", "content": user_message}]})
        if r.status_code >= 400:
            st["error"] = f"claude http {r.status_code}: {r.text[:160]}"
            return
        txt = ((r.json().get("content") or [{}])[0].get("text") or "").strip()
        try:
            parsed = _clip_parse_json(txt)
        except Exception as e:
            st["error"] = f"parse failed: {str(e)[:120]} :: {txt[:200]}"
            return

        rows_to_insert = _clip_filter_candidates(parsed, meeting_id)
        st["candidates"] = len(rows_to_insert)

        # 4. Idempotent write: clear prior PENDING clips for this recording, then insert.
        await _lm_supa("DELETE", f"video_shorts?source_recording_id=eq.{urllib.parse.quote(meeting_id)}"
                                 "&source_type=eq.call_recording&status=eq.pending")
        for row in rows_to_insert:
            code = await _lm_supa("POST", "video_shorts", row)
            if code and code < 400:
                st["inserted"] += 1
        logger.info(f"clip-extract {transcript_id}: candidates={st['candidates']} inserted={st['inserted']}")
    except Exception as e:
        st["error"] = str(e)[:300]
        logger.error(f"clip-extract crashed {transcript_id}: {e}")
    finally:
        st["running"] = False
        st["finished_at"] = _clip_now()


@app.post("/extract-clips")
async def extract_clips(raw_request: Request,
                        x_api_key: Optional[str] = Header(None),
                        authorization: Optional[str] = Header(None)):
    """Fire-and-forget call-clip extraction. Accepts the same body the n8n
    'call-clip-extractor' webhook gets ({transcript_id, meeting_id, transcript?,
    speaker_map?, screen_context?}). If `transcript` is absent it is fetched
    from Supabase by transcript_id. Returns immediately; work runs detached."""
    key = x_api_key or (authorization.replace("Bearer ", "").strip() if authorization else None)
    verify_api_key(key)
    body = await raw_request.json()
    transcript_id = body.get("transcript_id") or body.get("meeting_id")
    if not transcript_id:
        raise HTTPException(status_code=400, detail="transcript_id (or meeting_id) required")
    meeting_id = body.get("meeting_id") or transcript_id
    inline_transcript = body.get("transcript") or None
    inline_speaker_map = body.get("speaker_map") or None
    screen_context = body.get("screen_context") or ""
    cur = _clip_state.get(transcript_id)
    if cur and cur.get("running"):
        return {"status": "already_running", "transcript_id": transcript_id, "state": cur}
    _clip_state[transcript_id] = {"running": False}
    asyncio.create_task(_run_clip_extract(transcript_id, meeting_id,
                                          inline_transcript, inline_speaker_map, screen_context))
    return {"status": "started", "transcript_id": transcript_id}


@app.get("/extract-clips/status")
async def extract_clips_status(transcript_id: Optional[str] = None,
                               x_api_key: Optional[str] = Header(None),
                               authorization: Optional[str] = Header(None)):
    key = x_api_key or (authorization.replace("Bearer ", "").strip() if authorization else None)
    verify_api_key(key)
    if transcript_id:
        return _clip_state.get(transcript_id, {"status": "unknown", "transcript_id": transcript_id})
    return _clip_state


# ============================================================================
# SERVER-SIDE HYPERTARGET BUILD PIPELINE  (POST /build-hypertarget)
# ----------------------------------------------------------------------------
# Same detached, no-timeout pattern as /score-pending: build a `detected`
# hypertarget_corpus row into an `asset_ready` scan (transcript -> voice posts
# -> lint -> LM -> brand assets -> scans row). n8n fires this and polls.
# Posts are in the PROSPECT's voice (evidenced by their transcript), not Ivan's.
# ============================================================================
HT_BATCH = int(os.environ.get("HT_BUILD_BATCH", "3"))
HT_POST_MODEL = os.environ.get("HT_POST_MODEL", "claude-sonnet-4-6")
LM_GEN_WEBHOOK = os.environ.get("LM_GEN_WEBHOOK", "https://n8n.ivanmanfredi.com/webhook/lm-gen-v2")
SR_BASE = os.environ.get("SCROLL_RECORDER_BASE", "https://scroll-recorder-production.up.railway.app")
SR_TOKEN = os.environ.get("SCROLL_RECORDER_TOKEN", "")
_ht_state = {"running": False, "started_at": None, "finished_at": None,
             "built": 0, "failed": 0, "total": 0, "current": None, "last_error": None}


async def _ht_fetch_transcript(corpus_url, override=None):
    """yt-dlp captions -> plain text. `override` short-circuits (tests / Apify audio corpora)."""
    if override and override.strip():
        return override.strip()
    if not corpus_url:
        raise RuntimeError("no corpus_url and no transcript override")
    import glob as _glob

    def _candidates():
        # homepages usually link a channel, not a video. Resolve to the latest N uploads and try each
        # (any single video may lack captions or be blocked) until one yields a usable transcript.
        if ("watch?v=" in corpus_url) or ("youtu.be/" in corpus_url):
            return [corpus_url]
        if "youtube.com" in corpus_url:
            base = corpus_url.rstrip("/")
            if not base.endswith("/videos"):
                base = base + "/videos"
            vid = subprocess.run(["yt-dlp", "--flat-playlist", "--playlist-end", "6", "--print", "id",
                                  "--extractor-args", "youtube:player_client=android,web", base],
                                 capture_output=True, text=True, timeout=60)
            ids = [ln.strip() for ln in (vid.stdout or "").splitlines() if ln.strip()]
            return ["https://www.youtube.com/watch?v=" + i for i in ids]
        return [corpus_url]

    def _captions(url):
        with tempfile.TemporaryDirectory() as d:
            out = os.path.join(d, "cap")
            subprocess.run(["yt-dlp", "--skip-download", "--write-auto-subs", "--write-subs",
                            "--sub-langs", "en.*", "--sub-format", "vtt",
                            "--extractor-args", "youtube:player_client=android,web",
                            "-o", out, url],
                           check=True, capture_output=True, timeout=180)
            vtts = _glob.glob(out + "*.vtt")
            if not vtts:
                return ""
            raw = open(vtts[0], encoding="utf-8").read()
            lines, seen = [], set()
            for ln in raw.splitlines():
                ln = ln.strip()
                if not ln or ln == "WEBVTT" or "-->" in ln or ln.isdigit():
                    continue
                ln = re.sub(r"<[^>]+>", "", ln)
                if ln and ln not in seen:
                    seen.add(ln)
                    lines.append(ln)
            return " ".join(lines)

    def _captions_apify(url):
        # Apify runs on its own proxies, so it gets captions even when YouTube IP-blocks Railway's yt-dlp.
        token = os.environ.get("APIFY_TOKEN", "")
        if not token:
            return ""
        import httpx as _hx
        r = _hx.post("https://api.apify.com/v2/acts/pintostudio~youtube-transcript-scraper/run-sync-get-dataset-items?token=" + token,
                     json={"videoUrl": url}, timeout=150)
        if r.status_code >= 300:
            return ""
        data = r.json()
        segs = (data[0].get("data") if (data and isinstance(data, list) and isinstance(data[0], dict)) else None) or []
        return " ".join((s.get("text") or "") for s in segs).strip()

    def _run():
        cands = _candidates()
        if not cands:
            raise RuntimeError("no video candidates from corpus_url")
        last_err = "none"
        for url in cands:
            for fetch in (_captions_apify, _captions):  # Apify first (reliable), yt-dlp fallback (free)
                try:
                    text = fetch(url)
                    if len(text) >= 400:
                        return text
                    if text:
                        last_err = "thin/" + fetch.__name__
                except Exception as e:
                    last_err = (str(e) or repr(e))[:120]
        raise RuntimeError("no usable transcript from " + str(len(cands)) + " video(s): " + last_err)
    return await asyncio.to_thread(_run)


# --- Prompt canon (2026-07-14 scan revamp): the three scan generator prompt BODIES live in
# Supabase content_prompts (slugs scan-post-generator / scan-carousel-generator /
# scan-lm-generator, kind 'system') so dashboard edits propagate without a deploy. The
# _HT_*_PROMPT_FALLBACK constants below are byte-identical in-code fallbacks so a Supabase
# blip never breaks a build. {{NAME}} / {{HEADLINE}} are substituted at call time (plain
# .replace, never .format: the bodies contain JSON braces).

_HT_POST_PROMPT_FALLBACK = (
    "=== TASK ===\n"
    "You are ghost-writing LinkedIn posts for {{NAME}} ({{HEADLINE}}). Write in THEIR OWN voice, "
    "evidenced ONLY by the transcript of their own talk below: their phrasing, their beliefs, "
    "their cadence. Do not insert a consultant/agency register and do not sound like a generic "
    "LinkedIn ghostwriter writing for the prospect. First person as the founder.\n\n"
    "=== HARD STRUCTURE RULES (write clean the FIRST time, a strict linter rejects these) ===\n"
    "- No corrective contrast in ANY form: not 'it's not X, it's Y', not 'X, not Y', not "
    "'you think X, actually Y', not 'stop X start Y'. Zero. This is the #1 tell.\n"
    "- No stacked short fragments for drama ('They apply. They interview. And then nothing. A week passes.'). "
    "Vary sentence length hard: put a long, winding sentence next to a short one.\n"
    "- Do NOT end on a quotable aphorism or a rhetorical question. End on a concrete detail, a "
    "specific number, or a thought you leave unresolved.\n"
    "- No demonstrative pivot that names the lesson ('That's the thing that...', 'That's the real "
    "problem', 'That right there is...').\n"
    "- No formulaic transitions ('here's the thing', 'here's the kicker', 'what most people miss').\n"
    "- One idea per post, carried by specific moments and details from the transcript, never by "
    "rhetorical scaffolding. If a line could open any post in any industry, cut it.\n\n"
    "Return a JSON array of exactly 8 posts (oversample: the linter is strict). Each: "
    "{\"format\": \"Post\" or \"Carousel\", \"hook\": first line, \"body\": full post text, "
    "\"image_prompt\": a short literal image concept or null, "
    "\"source_quote\": a 10-25 word passage copied VERBATIM, character-for-character, from the "
    "transcript that this post grew from -- never paraphrase inside source_quote, a checker drops "
    "the post if the quote is not found in the transcript}. Make two of them \"Carousel\". "
    "For Carousel posts, body is the LinkedIn CAPTION only: the hook plus one or two sentences on "
    "what the slides cover. NEVER write 'SLIDE 1', 'Slide 2:' or any slide-by-slide narration "
    "inside body -- the slide deck is rendered separately. "
    "Ground every post in a DIFFERENT specific idea or moment from the transcript. Every number "
    "you write in a hook or body must appear in the transcript.\n\n"
    "For every \"Post\" (non-carousel), also include \"image_card\": {\"kicker\": a 2 to 4 word "
    "label, \"headline\": a 4 to 9 word claim, \"figure\": a number copied verbatim from the "
    "transcript or null, \"sub\": one short supporting line}. The image_card is the designed image "
    "that rides with the caption. Write it from the same source material as the caption, in "
    "different words. The headline must never repeat the hook or any sentence from the body; a "
    "checker drops the card if it does. Every number inside the image_card must appear verbatim "
    "in the transcript."
)


async def _ht_prompt_body(slug, fallback):
    """Fetch a prompt body from Supabase content_prompts; return the in-code fallback on any
    miss or error so a Supabase blip never breaks a build."""
    try:
        rows = await _lm_supa("GET", f"content_prompts?slug=eq.{slug}&is_active=eq.true&select=body&limit=1")
        body = ((rows or [{}])[0].get("body") or "").strip()
        if body:
            return body
    except Exception as e:
        logger.warning(f"prompt fetch {slug} failed, using in-code fallback: {e}")
    return fallback


def _ht_post_system(forbidden, founder, body=None):
    name = founder.get("name") or "the founder"
    head = founder.get("headline") or ""
    tpl = (body or "").strip() or _HT_POST_PROMPT_FALLBACK
    return ((forbidden or "").strip() + "\n\n"
            + tpl.replace("{{NAME}}", name).replace("{{HEADLINE}}", head))


async def _ht_gen_posts(founder, transcript):
    fb = await _lm_supa("GET", "content_prompts?slug=eq.forbidden-language&is_active=eq.true&select=body&limit=1")
    forbidden = (fb[0]["body"] if fb else "")
    tpl = await _ht_prompt_body("scan-post-generator", _HT_POST_PROMPT_FALLBACK)
    system = _ht_post_system(forbidden, founder, tpl)
    user = "Transcript of their talk:\n\n" + (transcript or "")[:14000]
    async with httpx.AsyncClient(timeout=300) as c:
        # X-Heartbeat: keeps the server streaming whitespace pings every 15s so httpx's
        # read timeout never fires during a long (6500-token) generation. Without it this
        # silent loopback call ReadTimeouts at 300s and the whole hypertarget build dies.
        r = await c.post(f"http://127.0.0.1:{PORT}/v1/messages",
                         headers={"X-API-Key": API_KEY, "Content-Type": "application/json", "X-Heartbeat": "1"},
                         json={"model": HT_POST_MODEL, "max_tokens": 8000, "system": system,
                               "messages": [{"role": "user", "content": user}]})
    if r.status_code >= 400:
        raise RuntimeError(f"post-gen http {r.status_code}: {r.text[:120]}")
    body = r.json()
    # Heartbeat path always returns 200 and encodes proxy errors as a JSON error object.
    if isinstance(body, dict) and body.get("type") == "error":
        raise RuntimeError(f"post-gen proxy error: {str(body.get('error'))[:160]}")
    txt = ((body.get("content") or [{}])[0].get("text") or "").strip()
    if txt.startswith("```"):
        txt = txt.split("```", 2)[1]
        if txt.startswith("json"):
            txt = txt[4:]
        txt = txt.strip().rstrip("`").strip()
    if not txt or "session limit" in txt.lower():
        raise RuntimeError("proxy returned empty or limit-banner completion: " + txt[:80])
    posts = json.loads(txt)
    return posts if isinstance(posts, list) else []


async def _ht_lint(text, profile="post"):
    async with httpx.AsyncClient(timeout=45) as c:
        r = await c.post(f"{SUPABASE_URL}/functions/v1/content-lint",
                         headers={"Authorization": f"Bearer {SUPABASE_SERVICE_KEY}", "Content-Type": "application/json"},
                         json={"post_text": text, "profile": profile})
    r.raise_for_status()
    return r.json()


def _ht_post_is_clean(lint: dict, voice_mode: str = "prospect") -> bool:
    """These outreach samples are written in the PROSPECT's own voice, not Ivan's — so by
    default ("prospect" mode) we only enforce the genuine-slop floor the linter itself already
    checks (banned vocab, em-dash, filler): verdict=="pass" is enough. Corrective-contrast,
    aphorism closers, dramatic fragments, and metronomic rhythm are legitimate rhetorical moves
    in many founders' authentic voice and are NOT rejected here.

    "strict" mode preserves the old high bar (used elsewhere, or if we ever need Ivan's own
    stricter anti-slop standard applied to a sample)."""
    if (lint or {}).get("verdict") != "pass":
        return False
    if voice_mode != "strict":
        return True
    fp = lint.get("fingerprint") or {}
    names = {v.get("name") for v in (lint.get("violations") or [])}
    return (
        fp.get("contrast_count", 0) == 0
        and fp.get("pivot_count", 0) <= 1
        and not fp.get("dramatic_fragment")
        and fp.get("closer_type") != "aphorism"
        and "low_burstiness" not in names
    )


def _ht_clean_image_card(post, corpus_nums):
    """Validate/normalize a model-emitted image_card in place (2026-07-14 scan revamp).
    Additive and defensive: the card is designed sidecar copy for image posts, so it is DROPPED
    (never shipped broken) when the headline duplicates the caption, when a headline/sub number
    is not verbatim in the corpus, or when the shape is unusable. An ungrounded figure alone
    strips just the figure. Old templates ignore the key; new templates fall back to image_url."""
    ic = post.get("image_card")
    if post.get("format") == "Carousel" or not isinstance(ic, dict):
        post.pop("image_card", None)
        return
    _norm = lambda t: re.sub(r"\s+", " ", (t or "")).strip().lower()
    kicker = _ht_deslop(str(ic.get("kicker") or "").strip())
    headline = _ht_deslop(str(ic.get("headline") or "").strip())
    sub = _ht_deslop(str(ic.get("sub") or "").strip())
    figure = _ht_deslop(str(ic.get("figure") or "").strip()) if ic.get("figure") not in (None, "", "null") else ""
    caption = _norm((post.get("hook") or "") + " " + (post.get("body") or ""))
    # Distinct-copy check: the card must not restate the caption verbatim.
    if not headline or _norm(headline) in caption:
        post.pop("image_card", None)
        return
    def _grounded(text):
        for num in re.findall(r"\d[\d,.]*", text or ""):
            n = num.rstrip(".,").replace(",", "")
            if n and n not in corpus_nums:
                return False
        return True
    if not (_grounded(kicker) and _grounded(headline) and _grounded(sub)):
        logger.info("hypertarget image_card: dropped card with ungrounded number")
        post.pop("image_card", None)
        return
    out = {"kicker": kicker, "headline": headline, "sub": sub}
    if figure and re.search(r"\d", figure) and _grounded(figure):
        out["figure"] = figure
    post["image_card"] = out


async def _ht_gen_posts_gated(founder, transcript, target=4, quotas=None):
    # Rank verdict-pass candidates with GUARANTEED format variety. Within a format slot prefer
    # strict-clean (the high anti-slop bar) then the prospect-voice floor (linter verdict pass);
    # never ship a verdict-fail post (genuine slop). quotas maps format -> minimum count.
    if quotas is None:
        quotas = {"Carousel": 1, "Post": 3}
    buckets = {}   # fmt -> {"strict": [p...], "floor": [p...]}
    seen = set()

    # Receipts gate (2026-07-10): reject-not-rank. source_quote must appear VERBATIM in the
    # transcript and every number in hook+body must exist there too -- same lesson class as the
    # wins-lane gate: the model provably invents specifics regardless of in-prompt rules. The
    # surviving source_quote ships in report_json and renders as a "what I read" caption.
    _rg_norm = lambda t: re.sub(r"\s+", " ", (t or "")).strip().lower()
    _rg_base = _rg_norm(transcript)
    # set membership, not substring: "16" must NOT pass because "7,316" exists in the talk
    _rg_nums = {n.rstrip(".,").replace(",", "") for n in re.findall(r"\d[\d,.]*", transcript or "")}

    def _rg_grounded(p):
        sq = _rg_norm(p.get("source_quote"))
        if not sq or sq not in _rg_base:
            return False
        for num in re.findall(r"\d[\d,.]*", (p.get("hook") or "") + " " + (p.get("body") or "")):
            n = num.rstrip(".,").replace(",", "")
            if n and n not in _rg_nums:
                return False
        return True

    async def consider(cands):
        for p in cands:
            body = (p.get("body") or "").strip()
            if not body or body in seen:
                continue
            seen.add(body)
            if not _rg_grounded(p):
                logger.info("hypertarget receipts gate: dropped an ungrounded post")
                continue
            try:
                # Samples are in the PROSPECT's own voice, not Ivan's: lint with the "prospect"
                # profile so corrective contrast / aphorism closers / metronomic rhythm (legitimate
                # in a founder's authentic voice) don't cull every candidate. The genuine-slop floor
                # (em-dash, filler, banned-vocab) still fails. See content-lint profiles.ts "prospect".
                lint = await _ht_lint(body, profile="prospect")
            except Exception as e:
                logger.warning(f"hypertarget lint error, skipping a post: {e}")
                continue
            if (lint or {}).get("verdict") != "pass":
                continue
            # image_card (2026-07-14): validate the designed-image sidecar copy for image posts.
            # Distinct-from-caption + verbatim-number gates; a bad card is dropped, never the post.
            _ht_clean_image_card(p, _rg_nums)
            fmt = "Carousel" if p.get("format") == "Carousel" else "Post"
            b = buckets.setdefault(fmt, {"strict": [], "floor": []})
            (b["strict"] if _ht_post_is_clean(lint, voice_mode="strict") else b["floor"]).append(p)

    def _count(fmt):
        b = buckets.get(fmt, {"strict": [], "floor": []})
        return len(b["strict"]) + len(b["floor"])

    def _total():
        return sum(_count(f) for f in buckets)

    variants = [
        transcript,
        transcript + "\n\n(Write 8 FRESH posts, different angles, vary sentence length hard.)",
        transcript + "\n\n(Write 8 more, each grounded in a DIFFERENT specific moment from the talk.)",
    ]
    for i, v in enumerate(variants):
        if _total() >= target and all(_count(f) >= q for f, q in quotas.items()):
            break
        if i:
            logger.info(f"hypertarget post batch {i+1} (passing so far: {_total()})")
        await consider(await _ht_gen_posts(founder, v))

    out, used = [], set()

    def _take(pool, n):
        taken = []
        for p in pool:
            if len(taken) >= n:
                break
            if id(p) in used:
                continue
            used.add(id(p))
            taken.append(p)
        return taken

    for fmt, q in quotas.items():
        b = buckets.get(fmt, {"strict": [], "floor": []})
        out += _take(b["strict"] + b["floor"], q)
    if len(out) < target:
        strict_all = [p for b in buckets.values() for p in b["strict"]]
        floor_all = [p for b in buckets.values() for p in b["floor"]]
        out += _take(strict_all + floor_all, target - len(out))
    out = out[:target]
    missing = [f for f, q in quotas.items() if sum(1 for p in out if (p.get("format") == "Carousel") == (f == "Carousel")) < q]
    if missing:
        logger.info(f"hypertarget posts: quota shortfall for {missing} (supply-limited)")
    logger.info(f"hypertarget posts: shipping {len(out)} formats={[p.get('format') for p in out]}")
    return out


_HT_LM_PROMPT_FALLBACK = (
    "=== TASK ===\n"
    "Design a one-page lead magnet for {{NAME}}'s audience, grounded ONLY in their talk below. "
    "It should read like a short brief or checklist they could publish under their own name. "
    "Return JSON only: {\"title\": str, \"promise\": one sentence on the concrete outcome, "
    "\"whats_inside\": array of 5-7 short prompts or questions, each under 120 chars}. "
    "Voice is theirs, drawn from the transcript. Obey every rule above."
)


def _ht_lm_system(forbidden, founder, body=None):
    name = founder.get("name") or "the founder"
    tpl = (body or "").strip() or _HT_LM_PROMPT_FALLBACK
    return ((forbidden or "").strip() + "\n\n"
            + tpl.replace("{{NAME}}", name).replace("{{HEADLINE}}", founder.get("headline") or ""))


async def _ht_gen_lm(founder, transcript, topic):
    # Self-contained: generate the LM brief via our own /v1/messages (no n8n dependency).
    # The scan needs the brief (title/promise/what's-inside/cover) for its preview; the full
    # interactive lm-gen-v2 resource is a later, post-conversion concern.
    fb = await _lm_supa("GET", "content_prompts?slug=eq.forbidden-language&is_active=eq.true&select=body&limit=1")
    forbidden = (fb[0]["body"] if fb else "")
    tpl = await _ht_prompt_body("scan-lm-generator", _HT_LM_PROMPT_FALLBACK)
    system = _ht_lm_system(forbidden, founder, tpl)
    user = "Their talk:\n\n" + (transcript or "")[:14000]
    async with httpx.AsyncClient(timeout=300) as c:
        # X-Heartbeat: same reason as _ht_gen_posts — keep the loopback read alive so a
        # slow generation doesn't ReadTimeout at 300s and kill the build before seeding.
        r = await c.post(f"http://127.0.0.1:{PORT}/v1/messages",
                         headers={"X-API-Key": API_KEY, "Content-Type": "application/json", "X-Heartbeat": "1"},
                         json={"model": HT_POST_MODEL, "max_tokens": 1500, "system": system,
                               "messages": [{"role": "user", "content": user}]})
    if r.status_code >= 400:
        raise RuntimeError(f"lm-gen http {r.status_code}: {r.text[:120]}")
    body = r.json()
    if isinstance(body, dict) and body.get("type") == "error":
        raise RuntimeError(f"lm-gen proxy error: {str(body.get('error'))[:160]}")
    txt = ((body.get("content") or [{}])[0].get("text") or "").strip()
    if txt.startswith("```"):
        txt = txt.split("```", 2)[1]
        if txt.startswith("json"):
            txt = txt[4:]
        txt = txt.strip().rstrip("`").strip()
    if not txt or "session limit" in txt.lower():
        raise RuntimeError("proxy returned empty or limit-banner completion: " + txt[:80])
    brief = json.loads(txt)
    title = brief.get("title") or topic
    promise = brief.get("promise") or ""
    inside = [str(x).strip() for x in (brief.get("whats_inside") or []) if str(x).strip()][:7]
    # record a draft row for traceability (best-effort; not on the critical path)
    draft_id = None
    try:
        headers = {"apikey": SUPABASE_SERVICE_KEY, "Authorization": f"Bearer {SUPABASE_SERVICE_KEY}",
                   "Content-Type": "application/json", "Prefer": "return=representation"}
        async with httpx.AsyncClient(timeout=45) as c:
            ins = await c.post(f"{SUPABASE_URL}/rest/v1/lm_drafts_v2", headers=headers,
                               json={"topic": title, "format": "checklist", "status": "pending",
                                     "source": "hypertarget_demo",
                                     "spec": {"title": title, "description": promise, "whats_inside": inside}})
            ins.raise_for_status()
            draft_id = ins.json()[0]["id"]
    except Exception as e:
        logger.warning(f"lm draft row insert skipped: {e}")
    return {"draft_id": draft_id, "title": title, "promise": promise, "whats_inside": inside, "cover_url": ""}


async def _ht_llm_json(system, user, max_tokens=3000):
    """Call the loopback proxy for a JSON completion, strip code fences, return parsed JSON.
    Raises RuntimeError on proxy error. (Extracted so the assessment generator is testable.)"""
    async with httpx.AsyncClient(timeout=300) as c:
        r = await c.post(f"http://127.0.0.1:{PORT}/v1/messages",
                         headers={"X-API-Key": API_KEY, "Content-Type": "application/json", "X-Heartbeat": "1"},
                         json={"model": HT_POST_MODEL, "max_tokens": max_tokens, "system": system,
                               "messages": [{"role": "user", "content": user}]})
    if r.status_code >= 400:
        raise RuntimeError(f"llm-json http {r.status_code}: {r.text[:120]}")
    body = r.json()
    if isinstance(body, dict) and body.get("type") == "error":
        raise RuntimeError(f"llm-json proxy error: {str(body.get('error'))[:160]}")
    txt = ((body.get("content") or [{}])[0].get("text") or "").strip()
    if txt.startswith("```"):
        txt = txt.split("```", 2)[1]
        if txt.startswith("json"):
            txt = txt[4:]
        txt = txt.strip().rstrip("`").strip()
    return json.loads(txt)


# --- Three-pillar diagnosis (2026-07-14 scan revamp): CONTENT / INBOUND / WARM OUTBOUND.
# The scan page's WARNING box renders a 3-row table from content_system.pillars; every cell is
# ALWAYS a real plain sentence (never a bracket glyph, never an empty string). LLM-generated
# when the proxy cooperates, deterministically derived from wins/metrics when it does not.

_HT_PILLARS = ("content", "inbound", "outbound")
_HT_PILLAR_PATTERNS = (
    # inbound/outbound first: their vocab is specific, content's is broad and would shadow them.
    ("inbound", r"lead.?magnet|lead.?capture|opt.?in|newsletter|email list|subscriber|landing.?page|"
                r"download|funnel|waitlist|sign.?up|inbound|captures? no name|uncaptured"),
    ("outbound", r"\bdms?\b|direct message|outreach|\brepl(?:y|ies)\b|follow.?up|comment|engager|"
                 r"reaction|connection request|inmail|outbound|booked call|sales call|warm lead"),
    ("content", r"\bposts?\b|posting|carousel|video|content|linkedin|feed|\bhooks?\b|impression|"
                r"follower|podcast|episode|audience|views|publish"),
)


def _ht_win_pillar(win):
    """Cheap deterministic pillar tag for one win; None when no keyword matches (ambiguous)."""
    if not isinstance(win, dict):
        return None
    text = ((win.get("observation") or "") + " " + (win.get("build") or "")).lower()
    for pillar, pattern in _HT_PILLAR_PATTERNS:
        if re.search(pattern, text):
            return pillar
    return None


def _ht_fallback_pillars(row, wins):
    """Deterministic pillar sentences derived from wins and the engagement metrics. Used whole
    when the pillars LLM call fails, and per-cell to fill anything the model left unusable."""
    eng = (row or {}).get("_engagement") or {}
    found = {p: "" for p in _HT_PILLARS}
    for w in wins or []:
        if not isinstance(w, dict):
            continue
        p = w.get("pillar") or _ht_win_pillar(w)
        obs = (w.get("observation") or "").strip()
        if p in found and obs and not found[p]:
            found[p] = obs if obs.endswith((".", "!", "?")) else obs + "."
    if not found["content"]:
        if eng.get("posts") and eng.get("avg_reactions"):
            found["content"] = f"Your last {eng['posts']} posts average {eng['avg_reactions']} reactions each."
        else:
            found["content"] = "No consistent publishing rhythm shows on your feed over the last 30 days."
    if not found["inbound"]:
        found["inbound"] = "No lead capture found behind any post in the last 30 days."
    if not found["outbound"]:
        found["outbound"] = "No follow-up reaches the people already engaging with your posts."
    return {
        "content": {"found": found["content"],
                    "projected": "Four posts a week drafted in your voice, ready to approve."},
        "inbound": {"found": found["inbound"],
                    "projected": "A lead magnet under your name that turns readers into named leads."},
        "outbound": {"found": found["outbound"],
                     "projected": "A short personal note to every warm engager, drafted for your approval."},
    }


def _ht_norm_pillars(pillars, row, wins):
    """Merge model pillar sentences over the deterministic fallback so every cell is always a
    real sentence: no empty strings, no bracket glyphs, all three pillars present."""
    base = _ht_fallback_pillars(row, wins)
    if isinstance(pillars, dict):
        for key in _HT_PILLARS:
            cell = pillars.get(key)
            if not isinstance(cell, dict):
                continue
            for f in ("found", "projected"):
                v = str(cell.get(f) or "").replace("[", "").replace("]", "").strip()
                if v:
                    base[key][f] = v
    return base


def _ht_pillars_system(forbidden, founder):
    name = founder.get("name") or "the founder"
    return (
        (forbidden or "").strip() + "\n\n"
        "=== TASK ===\n"
        f"You are writing the three-pillar diagnosis for a content-system scan of {name}. "
        "The pillars: content (what they publish), inbound (how a reader becomes a named lead), "
        "outbound (what happens to the people already engaging). You get their own corpus plus "
        "verified observations (wins).\n\n"
        "For each pillar return two sentences:\n"
        "- found: ONE specific plain sentence on what exists on their side today, grounded ONLY in "
        "the corpus and the wins. Quote or derive from real material. Use a number ONLY if that "
        "exact number appears verbatim in the corpus; a checker drops any sentence with an "
        "invented number.\n"
        "- projected: ONE plain sentence on what ships weekly once the system runs. Adapt lightly "
        "from this bank: content = posts drafted in their voice each week, ready to approve; "
        "inbound = a lead magnet under their name that turns readers into named leads; outbound = "
        "a short personal note to every warm engager, drafted for approval.\n\n"
        "Also classify each numbered win into exactly one pillar.\n\n"
        "Style: plain declarative sentences. Zero em dashes. No corrective contrast. No brackets. "
        "No hype. Obey every rule above.\n\n"
        "Return JSON ONLY, no prose:\n"
        "{\"content\": {\"found\": str, \"projected\": str}, "
        "\"inbound\": {\"found\": str, \"projected\": str}, "
        "\"outbound\": {\"found\": str, \"projected\": str}, "
        "\"win_pillars\": [\"content\"|\"inbound\"|\"outbound\" per numbered win, in order]}"
    )


async def _ht_gen_pillars(founder, transcript, wins):
    """One LLM call for the pillar table + win classification. Returns (pillars, win_tags) or
    None on any failure (caller falls back to _ht_fallback_pillars via _ht_norm_pillars).
    found-sentences get the same receipts-style gate as posts: any number not verbatim in the
    corpus (transcript + wins) voids that cell so the deterministic sentence replaces it."""
    try:
        fb = await _lm_supa("GET", "content_prompts?slug=eq.forbidden-language&is_active=eq.true&select=body&limit=1")
        forbidden = (fb[0]["body"] if fb else "")
        wins_txt = "\n".join(
            f"{i + 1}) {w.get('observation', '')} -> {w.get('build', '')}"
            for i, w in enumerate(wins or []) if isinstance(w, dict)) or "(none)"
        user = ("Verified wins:\n" + wins_txt + "\n\nTheir corpus:\n\n" + (transcript or "")[:12000])
        spec = await _ht_llm_json(_ht_pillars_system(forbidden, founder), user, max_tokens=1500)
        if not isinstance(spec, dict):
            return None
        nums = {n.rstrip(".,").replace(",", "")
                for n in re.findall(r"\d[\d,.]*", (transcript or "") + " " + wins_txt)}
        pillars = {}
        for key in _HT_PILLARS:
            cell = spec.get(key) or {}
            out_cell = {}
            for f in ("found", "projected"):
                v = _ht_deslop(str(cell.get(f) or "").strip()).replace("[", "").replace("]", "").strip()
                if f == "found" and v:
                    for num in re.findall(r"\d[\d,.]*", v):
                        n = num.rstrip(".,").replace(",", "")
                        if n and n not in nums:
                            logger.info(f"pillars receipts gate: dropped {key}.found (ungrounded {n})")
                            v = ""
                            break
                if v:
                    out_cell[f] = v
            pillars[key] = out_cell
        tags = [str(t).strip().lower() for t in (spec.get("win_pillars") or [])]
        return pillars, tags
    except Exception as e:
        logger.warning(f"_ht_gen_pillars failed: {e}")
        return None


def _ht_archetype(row, transcript=""):
    """Archetype from real signals (2026-07-14 scan revamp), replacing the hardcoded literal.
    Plain string; the template maps the copy. silent_founder = no recent posts in the corpus;
    uncaptured_feed = they post but no lead capture shows in enrichment; unworked_audience =
    capture exists but the warm audience goes unworked."""
    posts_recent = bool((row or {}).get("_engagement")) or bool(
        re.search(r"\[(?:their post,|post \d+ \|)", transcript or ""))
    if not posts_recent:
        return "silent_founder"
    ed = (row or {}).get("_enrichment") or {}
    try:
        blob = json.dumps(ed).lower()
    except Exception:
        blob = ""
    if not re.search(r"lead.?magnet|lead.?capture|opt.?in|email list|newsletter sign.?up|capture[sd]? (a )?name", blob):
        return "uncaptured_feed"
    return "unworked_audience"


_HT_ASSESS_CTA = {
    "headline": "Want a partner who turns this score into an actual plan?",
    "description": "Most people don't fail at the assessment. They fail at sequencing. In 30 minutes I'll show you which two things to fix first, based on your score and your stage. No pitch deck, just the sequencing call.",
    "button": "Book Strategy Call",
    "url": "https://calendly.com/im-ivanmanfredi/30min",
}
_HT_ASSESS_TIERS = {"low": 40, "mid": 70}
_HT_ASSESS_TIER_NAMES = {"low": "Developing", "mid": "Growth Stage", "high": "Advanced"}


def _ht_assessment_system(forbidden, founder, angle=""):
    name = founder.get("name") or "the founder"
    head = founder.get("headline") or ""
    steer = (f"REQUIRED ANGLE - build exactly this assessment: \"{angle}\". The title, the categories, "
             "and every question must serve that premise, and it must feel high-stakes and specific to "
             "it (something the reader would be a little afraid to score honestly), not a soft readiness "
             "quiz.\n\n") if angle else ""
    return (
        (forbidden or "").strip() + "\n\n"
        "=== TASK ===\n"
        + steer +
        f"Design an interactive self-assessment that {name} ({head}) could publish under their own "
        "name as a lead magnet for THEIR audience. Ground every question ONLY in the themes, beliefs, "
        "and vocabulary from their talk/content below — a reader who follows them should recognize it "
        "as their framework, not a generic quiz. The reader scores themselves; a higher score = more "
        "mature/ready.\n\n"
        "Return JSON ONLY in EXACTLY this shape (no prose):\n"
        "{\"title\": short score name (<=60 chars), \"subtitle\": one sentence on what it measures, "
        "\"persona_selector\": {\"id\": \"role\", \"text\": which-are-you question, "
        "\"answers\": [{\"label\": str, \"tag\": short_slug}]}, "
        "\"categories\": [{\"name\": section name, \"questions\": "
        "[{\"text\": the question, \"answers\": [{\"label\": option, \"score\": int 1..5}]}], "
        "\"recommendations\": {\"low\": {\"headline\": str, \"text\": str, \"steps\": [str]}, "
        "\"mid\": {...}, \"high\": {...}}}]}\n"
        "Rules: 4 to 5 categories; 12 to 16 questions TOTAL across them; each question has 4-5 answers "
        "with ascending integer scores starting at 1; answers describe concrete situations (not "
        "'strongly agree'); write recommendations in the founder's voice.\n\n"
        "=== V2 SCHEMA (REQUIRED) ===\n"
        "Emit top-level \"schema_version\": \"v2\". Add \"type\": \"likert\" to every scored question above (keep its answers[] of {label, score}).\n"
        "COST REVEAL (attempt it honestly): if the reader's world has a real countable quantity (weekly hours on a manual task, team size, monthly clients, average deal or retainer size, response-lag hours), add 1 to 3 NUMBER questions and 1 to 3 computed_outputs that turn those numbers into a cost the reader feels.\n"
        "NUMBER question shape: {\"id\": kebab, \"type\": \"number\", \"text\": str, \"hint\": str, \"suffix\": unit, \"min\": int, \"max\": int, \"step\": int, \"default\": int, \"normalize_formula\": expr}. normalize_formula maps the raw input (variable name x) to a 0-100 sub-score, higher = healthier. Allowed in any formula: digits, x, Math.*, the operators + - * / % ( ) comparisons and ?:. NO square brackets, NO other variable names.\n"
        "computed_outputs (top-level array): [{\"id\": kebab, \"label\": str, \"format\": one of currency, currency_per_period, hours, hours_per_period, percent, integer, decimal, \"formula\": expr, \"show_in_result\": true}]. A formula may reference any number question id (its raw value), any <id>_score, overall_score, and Math.*. Emit a formula string only, NEVER a pre-computed value.\n"
        "COEFFICIENT DISCIPLINE (hard rule): every number inside a formula must trace to a reader NUMBER input, or to a constant you STATE in the question text or hint (for example a loaded hourly rate the reader enters). NO invented multiplier, NO made-up coefficient. Before emitting a computed_output, name to yourself the source of every coefficient; if any would be invented, emit NO computed_outputs and NO number questions. If the topic has no honest quantity, omit computed_outputs entirely and keep it likert-only, that is a valid result.\n"
        "Obey every rule above."
    )


_HT_VALIDATE_MJS = os.path.join(os.path.dirname(os.path.abspath(__file__)), "lib", "validate_assessment.mjs")


def _ht_validate_assessment_spec(spec):
    """Phase 2b.4 render-QA gate: run the deployed scoring core (assessment-score.js) on
    synthetic answers via node, mirroring the n8n gate. Returns (valid: bool, reasons: list).
    Fail-closed: any harness error counts as invalid."""
    try:
        p = subprocess.run(["node", _HT_VALIDATE_MJS], input=json.dumps(spec),
                           capture_output=True, text=True, timeout=25)
        if p.returncode != 0:
            return False, ["validator subprocess exit %s: %s" % (p.returncode, (p.stderr or "")[:200])]
        verdict = json.loads(p.stdout or "{}")
        return bool(verdict.get("valid")), list(verdict.get("reasons") or [])
    except Exception as e:
        return False, ["validator harness error: %s" % str(e)[:200]]


def _ht_normalize_assessment_spec(spec, founder=None, slug=""):
    """Coerce a model assessment into a valid data.json. Raises ValueError if it can't yield
    >=12 well-formed questions. Brand accent is a neutral placeholder; the publisher (Task 2.2)
    overrides it with the prospect's accent."""
    if not isinstance(spec, dict):
        raise ValueError("spec not a dict")
    cats_out, qcount = [], 0
    for ci, cat in enumerate(spec.get("categories") or []):
        if not isinstance(cat, dict):
            continue
        cname = str(cat.get("name") or cat.get("id") or f"Section {ci+1}").strip()
        cid = re.sub(r"[^a-z0-9]+", "_", cname.lower()).strip("_")[:24] or f"cat{ci}"
        qs_out = []
        for qi, q in enumerate(cat.get("questions") or []):
            if not isinstance(q, dict):
                continue
            text = str(q.get("text") or "").strip()
            if not text:
                continue
            qid = str(q.get("id") or f"{cid}_q{qi+1}").strip()
            # v2 number-input question: no answers[]; carries a normalize_formula.
            if q.get("type") == "number":
                entry = {"id": qid, "type": "number", "text": text}
                for k in ("hint", "suffix", "min", "max", "step", "default"):
                    if q.get(k) is not None:
                        entry[k] = q[k]
                nf = q.get("normalize_formula")
                if isinstance(nf, str) and nf.strip():
                    entry["normalize_formula"] = nf.strip()
                qs_out.append(entry)
                continue
            # likert / untyped scored-choice: needs >=2 labeled answers.
            answers = []
            for a in (q.get("answers") or []):
                if not isinstance(a, dict):
                    continue
                label = str(a.get("label") or "").strip()
                if not label:
                    continue
                try:
                    score = int(a.get("score"))
                except (TypeError, ValueError):
                    score = len(answers) + 1
                answers.append({"label": label, "score": score})
            if len(answers) < 2:
                continue
            entry = {"id": qid, "text": text,
                     "max_score": max(a["score"] for a in answers), "answers": answers}
            if q.get("type") == "likert":
                entry["type"] = "likert"
            qs_out.append(entry)
        if not qs_out:
            continue
        cout = {"id": str(cat.get("id") or cid), "name": cname, "questions": qs_out}
        if isinstance(cat.get("recommendations"), dict):
            cout["recommendations"] = cat["recommendations"]
        cats_out.append(cout)
        qcount += len(qs_out)
    if qcount < 12:
        raise ValueError(f"only {qcount} valid questions (need >=12)")
    if qcount > 16:  # trim whole-question tail, keep categories
        trimmed, total = [], 0
        for c in cats_out:
            if total >= 16:
                break
            c = {**c, "questions": c["questions"][:max(0, 16 - total)]}
            if c["questions"]:
                trimmed.append(c); total += len(c["questions"])
        cats_out = trimmed
    fname = (founder or {}).get("name") or "your business"
    ps = spec.get("persona_selector")
    out = {
        "slug": slug or "",
        "title": ((spec.get("title") or "").strip() or "Readiness Score")[:80],
        "subtitle": ((spec.get("subtitle") or "").strip() or f"A quick diagnostic for {fname}.")[:200],
        "brand": {"accent": "#5B82A6", "hero_badge": "Interactive Assessment"},
        "estimated_minutes": spec["estimated_minutes"] if isinstance(spec.get("estimated_minutes"), int) else 8,
        "categories": cats_out,
        "tier_thresholds": spec["tier_thresholds"] if isinstance(spec.get("tier_thresholds"), dict) else dict(_HT_ASSESS_TIERS),
        "tier_names": spec["tier_names"] if isinstance(spec.get("tier_names"), dict) else dict(_HT_ASSESS_TIER_NAMES),
        "cta": spec["cta"] if (isinstance(spec.get("cta"), dict) and spec["cta"].get("url")) else dict(_HT_ASSESS_CTA),
    }
    # v2: carry computed_outputs (formula-only, sanitized) + schema_version through.
    cos = []
    for co in (spec.get("computed_outputs") or []):
        if not isinstance(co, dict):
            continue
        f = co.get("formula")
        if not (isinstance(f, str) and f.strip()):
            continue
        if isinstance(co.get("value"), (int, float)):
            continue  # formulas-not-values: drop any pre-computed numeral
        cos.append({k: co[k] for k in ("id", "label", "format", "formula", "show_in_result") if k in co})
    if cos:
        out["computed_outputs"] = cos
    if spec.get("schema_version") == "v2" or cos or any(q.get("type") for c in cats_out for q in c["questions"]):
        out["schema_version"] = "v2"
    if isinstance(spec.get("headline_formula"), str) and spec["headline_formula"].strip():
        out["headline_formula"] = spec["headline_formula"].strip()
    if isinstance(ps, dict) and ps.get("answers"):
        out["persona_selector"] = ps
    return out


async def _ht_gen_assessment_spec(founder, transcript, angle=""):
    """Bespoke interactive assessment (data.json shape) for prospects with no mapped niche slug.
    Returns a normalized spec dict, or None on any failure (caller keeps the static LM card)."""
    try:
        fb = await _lm_supa("GET", "content_prompts?slug=eq.forbidden-language&is_active=eq.true&select=body&limit=1")
        forbidden = (fb[0]["body"] if fb else "")
        spec = await _ht_llm_json(_ht_assessment_system(forbidden, founder, angle),
                                  "Their talk / content:\n\n" + (transcript or "")[:14000], max_tokens=6000)
        return _ht_normalize_assessment_spec(spec, founder=founder)
    except Exception as e:
        logger.warning(f"_ht_gen_assessment_spec failed: {e}")
        return None


# --- Tasks 3.1-3.3: newsletter / follow-up nurture / warm-engager-outreach sample generators.
# Same pattern as _ht_gen_assessment_spec / _ht_gen_lm: pure system-prompt builder + pure
# normalizer (raises ValueError on unusable output) + async gen that fetches forbidden-language,
# calls _ht_llm_json, normalizes, and returns None on ANY failure (caller guards). Display-only
# samples for the scan -- no live sends, no external writes.


def _ht_deslop(text):
    """Deterministic anti-slop pass for sample copy. Sonnet ignores the zero-em-dash rule, so we
    strip the tells ourselves: em-dash -> comma, en-dash -> hyphen, collapse double spaces. Only
    touches strings; non-strings pass through unchanged (never call on URLs / structural keys)."""
    if not isinstance(text, str):
        return text
    t = re.sub(r"\s*—\s*", ", ", text)   # em-dash -> comma
    t = t.replace("—", ", ")
    t = re.sub(r"\s*–\s*", "-", t)         # en-dash -> hyphen
    return re.sub(r"[ ]{2,}", " ", t).strip()


def _ht_strip_placeholder(text):
    """Kill literal merge-field tokens (e.g. "[Name]", "[First]") from sample copy: the reactor's
    name is unknown at sample time, so a bracketed placeholder must never ship. Removes the token
    and tidies the leftover greeting ("Hey [Name]," -> "Hey,"). Non-strings pass through."""
    if not isinstance(text, str):
        return text
    t = re.sub(r"\[[^\]]*\]", "", text)                       # drop [Name] / [First] / [name]
    t = re.sub(r"\b(Hey|Hi|Hello)\b\s*,", r"\1,", t)          # "Hey ," -> "Hey,"
    t = re.sub(r"\s+([,.!?])", r"\1", t)                       # tidy space before punctuation
    return re.sub(r"[ ]{2,}", " ", t).strip()


def _ht_newsletter_system(forbidden, founder):
    name = founder.get("name") or "the founder"
    return (
        (forbidden or "").strip() + "\n\n"
        "=== TASK ===\n"
        f"Write a short email newsletter in {name}'s voice, repackaging the themes from their talk "
        "below into something they could send to their own list this week. Scannable: short "
        "paragraphs, 2-4 sections each with a heading and a tight body, plain-text feel (no heavy "
        "formatting), one soft call to action at the end. Ground every claim ONLY in the transcript. "
        "Lead with the benefit to the reader, not with the fact that this is AI-made or automated.\n\n"
        "Return JSON ONLY in EXACTLY this shape (no prose):\n"
        "{\"subject\": short subject line, \"preview\": one-line preview text, "
        "\"sections\": [{\"h\": heading, \"body\": 2-4 sentence paragraph}], \"cta\": one soft closing line}\n"
        "Rules: 2-4 sections; each body is plain prose in their voice; obey every rule above."
    )


async def _ht_sample_clean(bodies, label):
    """Lint gate for the non-post sample copy (newsletter / follow-ups / engager DMs) — the same
    genuine-slop floor the posts get (banned vocab, filler; em-dash is already stripped by
    _ht_deslop). Lint outage fails OPEN: an unlintable build beats a missing section."""
    text = "\n\n".join(b for b in bodies if b and str(b).strip())
    if not text.strip():
        return False
    try:
        lint = await _ht_lint(text, profile="prospect")
    except Exception as e:
        logger.warning(f"_ht_sample_clean({label}) lint unavailable, failing open: {e}")
        return True
    ok = (lint or {}).get("verdict") == "pass"
    if not ok:
        names = [v.get("name") for v in (lint or {}).get("violations") or []]
        logger.info(f"hypertarget {label} failed prospect lint: {names}")
    return ok


async def _ht_gen_newsletter(founder, transcript, posts):
    """A short email newsletter in the prospect's voice, repackaging their content themes.
    Returns {subject,preview,sections,cta} or None."""
    try:
        fb = await _lm_supa("GET", "content_prompts?slug=eq.forbidden-language&is_active=eq.true&select=body&limit=1")
        forbidden = (fb[0]["body"] if fb else "")
        system = _ht_newsletter_system(forbidden, founder)
        user = "Their content themes / talk:\n\n" + (transcript or "")[:10000]
        for attempt in range(2):
            nl = _ht_norm_newsletter(await _ht_llm_json(system, user, max_tokens=2000))
            if await _ht_sample_clean([nl["subject"], nl["preview"], nl["cta"]]
                                      + [s["body"] for s in nl["sections"]], "newsletter"):
                return nl
        logger.info("hypertarget newsletter failed lint twice, omitting section")
        return None
    except Exception as e:
        logger.warning(f"_ht_gen_newsletter failed: {e}")
        return None


def _ht_norm_newsletter(spec):
    if not isinstance(spec, dict):
        raise ValueError("newsletter not a dict")
    secs = []
    for s in (spec.get("sections") or []):
        if not isinstance(s, dict):
            continue
        h = _ht_deslop(str(s.get("h") or s.get("heading") or "").strip())
        b = _ht_deslop(str(s.get("body") or s.get("text") or "").strip())
        if b:
            secs.append({"h": h, "body": b})
    if len(secs) < 2:
        raise ValueError("newsletter needs >=2 sections")
    return {
        "subject": _ht_deslop((str(spec.get("subject") or "").strip() or "This week")[:120]),
        "preview": _ht_deslop(str(spec.get("preview") or "").strip()[:160]),
        "sections": secs[:5],
        "cta": _ht_deslop(str(spec.get("cta") or "").strip() or "Reply if you want the full breakdown."),
    }


def _ht_followups_system(forbidden, founder):
    name = founder.get("name") or "the founder"
    return (
        (forbidden or "").strip() + "\n\n"
        "=== TASK ===\n"
        f"Write a 3-email nurture sequence in {name}'s voice that fires AFTER someone downloads "
        "their lead magnet (details below). Each email references the resource they grabbed, days "
        "ascend (send further apart as the sequence goes), and the LAST email closes with a soft "
        "'grab 20 minutes' call ask (never a hard pitch). Ground everything ONLY in the lead "
        "magnet's title/promise/contents. Lead with the benefit to the reader.\n\n"
        "Return JSON ONLY in EXACTLY this shape (no prose): a JSON array of 3 objects, each "
        "{\"subject\": str, \"body\": 2-4 sentence email body, \"day\": int, days sent after signup}.\n"
        "Rules: 3 emails; ascending day values; last email's body ends on the soft call CTA; obey "
        "every rule above."
    )


async def _ht_gen_followups(founder, lm):
    """A 3-email nurture that fires AFTER someone grabs the lead magnet, in the prospect's voice,
    ending on a soft call CTA. Grounded in the LM's title/promise. Returns a list or None."""
    try:
        fb = await _lm_supa("GET", "content_prompts?slug=eq.forbidden-language&is_active=eq.true&select=body&limit=1")
        forbidden = (fb[0]["body"] if fb else "")
        system = _ht_followups_system(forbidden, founder)
        user = f"The lead magnet they downloaded:\nTitle: {lm.get('title','')}\nPromise: {lm.get('promise','')}\nInside: {', '.join(lm.get('whats_inside', [])[:6])}"
        for attempt in range(2):
            fu = _ht_norm_followups(await _ht_llm_json(system, user, max_tokens=2000))
            if await _ht_sample_clean([e["subject"] for e in fu] + [e["body"] for e in fu], "followups"):
                return fu
        logger.info("hypertarget followups failed lint twice, omitting section")
        return None
    except Exception as e:
        logger.warning(f"_ht_gen_followups failed: {e}")
        return None


def _ht_norm_followups(spec):
    items = spec if isinstance(spec, list) else ((spec.get("emails") or spec.get("follow_ups")) if isinstance(spec, dict) else None)
    default_days = [1, 3, 6, 10]
    out = []
    for i, e in enumerate(items or []):
        if not isinstance(e, dict):
            continue
        body = _ht_deslop(str(e.get("body") or "").strip())
        if not body:
            continue
        try:
            day = int(e.get("day"))
        except (TypeError, ValueError):
            day = default_days[i] if i < len(default_days) else (i + 1) * 3
        out.append({"step": i + 1, "day": day,
                    "subject": _ht_deslop(str(e.get("subject") or "").strip()[:120]), "body": body})
    if len(out) < 2:
        raise ValueError("need >=2 follow-ups")
    return out[:4]


def _ht_engager_system(forbidden, founder):
    name = founder.get("name") or "the founder"
    return (
        (forbidden or "").strip() + "\n\n"
        "=== TASK ===\n"
        f"Write 2 sample DMs {name} could send to someone who reacted to or commented on one of "
        "their own LinkedIn posts (hooks below). This is positioning-safe outreach on THEIR owned "
        "asset: warm, peer-to-peer tone, ties the message to the specific post that triggered it, "
        "offers something useful, never a hard pitch, never brags that the content or DM is "
        "AI-made or automated. Approve-first, benefit-led.\n\n"
        "Return JSON ONLY in EXACTLY this shape (no prose):\n"
        "{\"explainer\": one sentence describing when this DM fires, "
        "\"samples\": [{\"trigger\": what they reacted to / which post, \"dm\": the message}]}\n"
        "Rules: 2 samples; each dm is short and conversational; the recipient's name is UNKNOWN at "
        "send time, so NEVER use a merge-field placeholder like [Name]/[First] — open with a plain "
        "greeting ('Hey,') or no greeting at all; obey every rule above."
    )


async def _ht_gen_engager_outreach(founder, posts, real=None):
    """2 sample DMs that would go to someone who reacted/commented on the prospect's content,
    framed as 'captured from your own post -> personal DM -> booked call'. Positioning-safe:
    their owned asset, approve-first, benefit-led, no machine-brag. Returns {explainer,samples} or None."""
    try:
        fb = await _lm_supa("GET", "content_prompts?slug=eq.forbidden-language&is_active=eq.true&select=body&limit=1")
        forbidden = (fb[0]["body"] if fb else "")
        system = _ht_engager_system(forbidden, founder)
        if real and real.get("engagers"):
            # Real commenters exist: both sample DMs key to the REAL post they engaged, and the
            # engager identity rides as metadata only (DM text stays name-free per system rules).
            names = "; ".join(f"{i + 1}) {e['name']}" + (f" \u00b7 {e['headline']}" if e.get("headline") else "")
                              for i, e in enumerate(real["engagers"][:2]))
            user = ("One of their REAL recent posts:\n" + real["post_text"] +
                    "\n\nReal people who commented on it: " + names +
                    "\nWrite the 2 sample DMs as the openers these two commenters would get, each keyed to that real post. Never use their names in the DM text.")
        else:
            hooks = "\n".join(f"- {p.get('hook','')}" for p in (posts or [])[:4])
            user = "Their recent post hooks:\n" + hooks
        for attempt in range(2):
            eng = _ht_norm_engager(await _ht_llm_json(system, user, max_tokens=1500))
            if await _ht_sample_clean([eng["explainer"]] + [s["dm"] for s in eng["samples"]], "engager"):
                if real and real.get("engagers"):
                    for smp, e in zip(eng["samples"], real["engagers"]):
                        smp["engager"] = {"name": e["name"], "headline": e.get("headline", "")}
                return eng
        logger.info("hypertarget engager failed lint twice, omitting section")
        return None
    except Exception as e:
        logger.warning(f"_ht_gen_engager_outreach failed: {e}")
        return None


def _ht_norm_engager(spec):
    if not isinstance(spec, dict):
        raise ValueError("engager not a dict")
    samples = []
    for s in (spec.get("samples") or []):
        if not isinstance(s, dict):
            continue
        dm = _ht_strip_placeholder(_ht_deslop(str(s.get("dm") or s.get("message") or "").strip()))
        if not dm:
            continue
        trigger = _ht_strip_placeholder(_ht_deslop(str(s.get("trigger") or "").strip()))
        samples.append({"trigger": trigger, "dm": dm})
    if not samples:
        raise ValueError("need >=1 engager sample")
    return {
        "explainer": _ht_strip_placeholder(_ht_deslop(str(spec.get("explainer") or "").strip()))
                     or "When someone reacts to one of your posts, they get a short personal note, not a pitch.",
        "samples": samples[:3],
    }


def _ht_sr_url(path):
    return SR_BASE.rstrip("/") + path


# Mid-slate: forms a real gradient in the asset renderer (unlike a near-black accent, which
# makes it fall back to sparse outline decoration) and is NOT Ivan's brand green.
_HT_NEUTRAL_ACCENT = "#5B6470"


def _ht_accent_renders_ok(hex_str):
    """A usable asset accent needs mid luminance so the renderer can build a gradient fill.
    Near-black or near-white accents produce the sparse, 'unpositioned' look."""
    try:
        h = (hex_str or "").lstrip("#")
        r, g, b = int(h[0:2], 16), int(h[2:4], 16), int(h[4:6], 16)
        return 45 <= (0.2126 * r + 0.7152 * g + 0.0722 * b) <= 232
    except Exception:
        return False


async def _ht_brand_profile(company_name, domain, screenshot_url=None):
    prof = None
    try:
        async with httpx.AsyncClient(timeout=120) as c:
            r = await c.post(_ht_sr_url("/brand-profile"),
                             headers={"Authorization": f"Bearer {SR_TOKEN}", "Content-Type": "application/json"},
                             json={"company_name": company_name, "domain": domain, "screenshot_url": screenshot_url})
            if r.status_code < 400:
                j = r.json()
                prof = j.get("profile") or j
    except Exception as e:
        logger.warning(f"brand-profile fell back: {e}")
    if not prof:
        prof = {"accent_hex": _HT_NEUTRAL_ACCENT, "is_dark": False, "wordmark": company_name, "mood": "editorial"}
    # Guard the accent. brand-profile returns accent_source="fallback" when it couldn't actually
    # read the site (e.g. no screenshot on a JS-heavy site) — it then guesses a green that happens
    # to be OUR brand. Also reject too-dark/too-light accents that render sparse. In both cases use
    # a neutral mid-slate so a lead is never painted in Ivan's green or rendered "unpositioned".
    if prof.get("accent_source") == "fallback" or not _ht_accent_renders_ok(prof.get("accent_hex")):
        logger.info(f"brand accent unreliable ({prof.get('accent_hex')}, src={prof.get('accent_source')}) -> neutral slate")
        prof["accent_hex"] = _HT_NEUTRAL_ACCENT
        prof["accent_source"] = "neutral_guard"
    # Full-brand fallback (2026-07-10, Andy Alagappan audit): when the probe resolved no fonts,
    # read the site's Google Fonts link directly; a light readable site renders on ITS white,
    # never on Ivan's cream. Fonts/surface only set from evidence -- unreadable site stays neutral.
    if domain and not (prof.get("font_heading") or prof.get("font_body")):
        try:
            async with httpx.AsyncClient(timeout=15, follow_redirects=True) as c:
                html = (await c.get(f"https://{domain}", headers={"User-Agent": "Mozilla/5.0"})).text
            fams = re.findall(r"fonts\.googleapis\.com/css2?\?[^\"\']*?family=([A-Za-z+0-9 ]+)", html)
            fam = fams[0].split(":")[0].replace("+", " ").strip() if fams else ""
            if fam:
                prof["font_heading"] = prof.get("font_heading") or fam
                prof["font_body"] = prof.get("font_body") or fam
        except Exception:
            pass
    if not prof.get("surface_hex") and not prof.get("is_dark") and prof.get("accent_source") not in ("fallback", "neutral_guard"):
        prof["surface_hex"] = "ffffff"
    return prof


def _ht_apply_brand_override(profile, override):
    """Human escape hatch: a curator-set brand_override dict wins over the auto-probed profile
    (2-min accent/logo fix before a high-value send). Non-dict/empty override -> unchanged."""
    if isinstance(override, dict) and override:
        return {**profile, **override}
    return profile


async def _ht_brand_asset(profile, kind, copy, slug, aspect=None):
    payload = {"profile": profile, "kind": kind, "copy": copy, "slug": slug}
    if aspect:
        payload["aspect"] = aspect
    async with httpx.AsyncClient(timeout=180) as c:
        r = await c.post(_ht_sr_url("/brand-asset"),
                         headers={"Authorization": f"Bearer {SR_TOKEN}", "Content-Type": "application/json"},
                         json=payload)
    r.raise_for_status()
    return r.json()["url"]


_HT_SLIDE_ROLES = {"cover", "point", "proof", "action"}


def _ht_assign_slide_roles(slides):
    """Positional role assignment (2026-07-14 scan revamp): first slide = cover, last = action,
    middle = point (a valid model-provided middle role like proof is kept). In place; returns
    the list. Old templates ignore the key; new templates fall back to exactly this ladder."""
    if not slides:
        return slides
    for s in slides[1:-1]:
        if s.get("role") not in ("point", "proof"):
            s["role"] = "point"
    slides[0]["role"] = "cover"
    if len(slides) > 1:
        slides[-1]["role"] = "action"
    return slides


def _ht_carousel_slides(post: dict, target: int = 5) -> list:
    """Structured slide cards for a Carousel post — the renderer draws them brand-mirrored in
    code (Ivan's notebook-carousel style). Prefer model-provided slides; else split the body."""
    raw = post.get("slides")
    if isinstance(raw, list) and raw:
        out = []
        for s in raw:
            if isinstance(s, dict):
                out.append({"heading": (s.get("heading") or s.get("title") or "").strip(),
                            "body": (s.get("body") or s.get("text") or "").strip(),
                            **({"role": s["role"]} if s.get("role") in _HT_SLIDE_ROLES else {})})
            elif isinstance(s, str) and s.strip():
                out.append({"heading": "", "body": s.strip()})
        out = [s for s in out if s["heading"] or s["body"]]
        if out:
            return _ht_assign_slide_roles(out[:8])
    body = (post.get("body") or "").strip()
    if not body:
        return []
    chunks = [c.strip() for c in re.split(r"\n\s*\n", body) if c.strip()]
    if len(chunks) < 2:
        sents = [s.strip() for s in re.split(r"(?<=[.!?])\s+", body) if s.strip()]
        if not sents:
            return []
        per = max(1, -(-len(sents) // target))  # ceil
        chunks = [" ".join(sents[i:i + per]) for i in range(0, len(sents), per)]
    hook = (post.get("hook") or "").strip()
    return _ht_assign_slide_roles(
        [{"heading": hook if i == 0 else "", "body": ch} for i, ch in enumerate(chunks[:8])])


_HT_CAROUSEL_PROMPT_FALLBACK = (
    "=== TASK ===\n"
    "Turn ONE LinkedIn carousel by {{NAME}} into its actual swipeable slides. You get the post's "
    "hook and its caption body. The caption usually PROMISES a payoff the reader swipes to see "
    "(a side-by-side comparison, a breakdown, a scored list, a before/after). Your slides MUST "
    "DELIVER that exact payoff. Do NOT slice the caption sentence by sentence: if the caption says "
    "'I mapped the two scoreboards side by side', the middle slides ARE those two scoreboards with "
    "their real line items.\n\n"
    "Write 6 or 7 slides. Slide 1 has role \"cover\": the hook restated as a designed cover line. "
    "The middle slides carry the substance the caption promised, each one standing on its own on a "
    "phone screen, with role \"point\", or role \"proof\" when the slide is built around the "
    "caption's strongest number or receipt. The final slide has role \"action\": the single "
    "concrete step the reader takes next.\n\n"
    "First person as {{NAME}}, in their voice. Ground every slide only in the caption's own content "
    "and numbers; invent nothing. Each slide: heading = 3 to 8 words naming the point; body = one "
    "or two short sentences, OR a tight list of 2 to 4 items separated by newlines; kicker = an "
    "optional 1 to 3 word label above the heading, or null; figure = a number copied verbatim from "
    "the caption when the slide is built around one, or null. No slide repeats the caption "
    "verbatim.\n\n"
    "Return JSON ONLY, no prose: {\"slides\": [{\"role\": \"cover\"|\"point\"|\"proof\"|\"action\", "
    "\"heading\": str, \"body\": str, \"kicker\": str|null, \"figure\": str|null}, ...]}"
)


def _ht_carousel_system(forbidden, name, body=None):
    who = name or "the founder"
    tpl = (body or "").strip() or _HT_CAROUSEL_PROMPT_FALLBACK
    return ((forbidden or "").strip() + "\n\n"
            + tpl.replace("{{NAME}}", who).replace("{{HEADLINE}}", ""))


async def _ht_gen_carousel_slides(post, name):
    """Author real swipeable slide cards that DELIVER the caption's promise, instead of slicing the
    linear body into sentences. Returns a list of {heading,body} (>=3) or None so the caller can fall
    back to the deterministic splitter."""
    try:
        hook = (post.get("hook") or "").strip()
        body = (post.get("body") or "").strip()
        if not (hook or body):
            return None
        fb = await _lm_supa("GET", "content_prompts?slug=eq.forbidden-language&is_active=eq.true&select=body&limit=1")
        forbidden = (fb[0]["body"] if fb else "")
        tpl = await _ht_prompt_body("scan-carousel-generator", _HT_CAROUSEL_PROMPT_FALLBACK)
        system = _ht_carousel_system(forbidden, name, tpl)
        user = f"HOOK:\n{hook}\n\nCAPTION BODY:\n{body}"
        spec = await _ht_llm_json(system, user, max_tokens=1800)
        raw = spec.get("slides") if isinstance(spec, dict) else None
        if not isinstance(raw, list):
            return None
        # figure must be a verbatim-corpus number: the caption (hook+body) is the slides'
        # grounding corpus, so its digit runs are the allowed set.
        cap_nums = {n.rstrip(".,").replace(",", "")
                    for n in re.findall(r"\d[\d,.]*", hook + " " + body)}
        out = []
        for s in raw:
            if not isinstance(s, dict):
                continue
            h = _ht_deslop(str(s.get("heading") or s.get("title") or "").strip())
            b = _ht_deslop(str(s.get("body") or s.get("text") or "").strip())
            if not (h or b):
                continue
            slide = {"heading": h, "body": b}
            role = str(s.get("role") or "").strip().lower()
            slide["role"] = role if role in _HT_SLIDE_ROLES else "point"
            kicker = _ht_deslop(str(s.get("kicker") or "").strip()) if s.get("kicker") not in (None, "", "null") else ""
            if kicker:
                slide["kicker"] = kicker
            figure = _ht_deslop(str(s.get("figure") or "").strip()) if s.get("figure") not in (None, "", "null") else ""
            if figure and re.search(r"\d", figure) and all(
                    n.rstrip(".,").replace(",", "") in cap_nums
                    for n in re.findall(r"\d[\d,.]*", figure)):
                slide["figure"] = figure
            out.append(slide)
        if len(out) < 3:
            return None
        return _ht_assign_slide_roles(out[:8])
    except Exception as e:
        logger.warning(f"_ht_gen_carousel_slides failed: {e}")
        return None


async def _ht_render_images(posts, profile, slug, limit=3):
    """Brand-render images for the first `limit` non-carousel posts (was: just one). Sets
    post['image_url'] in place; returns the first url (used as the scan OG image)."""
    non_carousel = [p for p in posts if p.get("format") != "Carousel"]
    targets = non_carousel[:limit] or posts[:1]
    first = ""
    for i, p in enumerate(targets):
        # Per-post slug so the storage key is unique (brand-asset-<slug>-post1-brand_image.png,
        # ...-post2-..., ...). Was: one shared slug -> every post reused the same file. Each
        # image is still generated from THAT post's own hook, so the 3 differ visually.
        url = await _ht_brand_asset(profile, "brand_image", {"headline": p.get("hook", "")},
                                    f"{slug}-post{i + 1}")
        p["image_url"] = url
        if i == 0:
            first = url
    return first


def _ht_slug(name):
    base = re.sub(r"[^a-z0-9]+", "-", (name or "prospect").lower()).strip("-")[:40]
    suffix = hashlib.sha1((name or "").encode()).hexdigest()[:2]
    return f"{base}-{suffix}"


_HT_LM_SLUG_MAP = [
    # (regex_pattern, assessment_slug). Matched against headline + company + the
    # generated LM title/promise (the transcript-derived title is the strongest niche
    # signal — DB company/headline are often null or stale, e.g. "Sci-Rec" for a firm
    # that calls itself Cyre on the recording).
    (r"staff|recruit|talent|headhunt|placement|search firm|executive search|sci.?rec",
     "staffing-firm-placement-capacity-score-are-you-leaving-revenue-on-the-table"),
    (r"account|bookkeep|\btax\b|cpa|audit firm",
     "accounting-workflow-capacity-score-where-are-your-hours-actually-leaking"),
    (r"architect",
     "architecture-studio-margin-diagnostic-where-project-hours-actually-land"),
    (r"consult|advisory|\bfractional\b",
     "boutique-consultancy-capacity-score-where-senior-hours-actually-go"),
    (r"research|clinical|\blab\b|biotech|pharma|life scien",
     "research-practice-throughput-score-where-studies-actually-stall"),
    (r"property|real estate|realty|\bproperty management\b",
     "property-management-operations-score-where-is-your-team-losing-hours"),
    # Creative-agency ICP (design/brand studios). Two bespoke assessments authored for
    # the hypertarget content_system pilots (Dizz / SKULPT). Brand-strategy signals ->
    # the meaning audit; design/communication-delivery signals -> the clarity test.
    (r"brand strateg|brand studio|brand agency|branding|rebrand|brand design|visual identit|brand consult",
     "the-meaning-audit-does-your-brand-give-people-a-reason-to-care"),
    (r"design studio|design agency|creative studio|creative agency|web design|product design|ux/ui|ui/ux|graphic design|motion design|pitch deck",
     "the-10-second-clarity-test-what-an-investor-understands-before-they-lose-interest"),
]
_HT_LM_SLUG_DEFAULT = (
    "an-agent-ready-assessment-scorecard-that-helps-agency-operators-evaluate-which-of-their"
    "-workflows-are-actually-automation-ready-before-they-spend-on-a-build"
)


def _ht_pick_lm_slug(*signals: str) -> str:
    """Return the best-fit interactive-assessment slug for this prospect's niche.

    Pass any number of signal strings (headline, company, generated LM title/promise).
    The transcript-derived LM title is usually the strongest signal.
    """
    haystack = " ".join(s for s in signals if s).lower()
    for pattern, slug in _HT_LM_SLUG_MAP:
        if re.search(pattern, haystack):
            return slug
    # No niche match: return None so the caller KEEPS the transcript-grounded generated brief
    # instead of overwriting it with the agent-ready-for-agencies default (which misfires on
    # any prospect outside the agency/consultancy map, e.g. coaches/education/info-product).
    return None


def _ht_seed_from_spec(lm, data, slug):
    """Seed lm from an assessment spec (mapped data.json OR bespoke). Neutral-middle answers;
    aligns card title/promise/whats_inside so card+cover+quiz tell one story. Pure/in-place."""
    seed = {}
    for cat in data.get("categories") or []:
        for q in cat.get("questions") or []:
            if q.get("type") == "number":
                mn = q.get("min", 0) or 0
                mx = q.get("max", 100) if q.get("max") is not None else 100
                seed[q["id"]] = q["default"] if q.get("default") is not None else round((mn + mx) / 2)
                continue
            answers = q.get("answers") or []
            n = len(answers) or 5
            seed[q["id"]] = max(0, (n - 1) // 2)
    ps = data.get("persona_selector")
    if ps:
        seed[ps.get("id") or "__persona"] = 0
        seed["__persona"] = 0
    lm["slug"] = slug
    lm["seed_answers"] = seed
    if data.get("title"):
        lm["title"] = data["title"]
    if data.get("subtitle"):
        lm["promise"] = data["subtitle"]
    cats = [str(c.get("name")).strip() for c in (data.get("categories") or []) if c.get("name")]
    if cats:
        lm["whats_inside"] = cats[:6]


async def _ht_gh_put_file(repo, path, content_bytes, message):
    """Create-or-update a file in a GitHub repo via the Contents API. Idempotent: looks up an
    existing file's sha so re-publish (e.g. William rebuild) updates instead of 409-ing."""
    import base64 as _b64
    api = f"https://api.github.com/repos/{repo}/contents/{path}"
    headers = {"Authorization": f"token {GITHUB_TOKEN}", "Accept": "application/vnd.github.v3+json"}
    async with httpx.AsyncClient(timeout=30) as c:
        sha = None
        g = await c.get(api, headers=headers)
        if g.status_code == 200:
            sha = g.json().get("sha")
        body = {"message": message, "content": _b64.b64encode(content_bytes).decode()}
        if sha:
            body["sha"] = sha
        r = await c.put(api, headers=headers, json=body)
    if r.status_code not in (200, 201):
        raise RuntimeError(f"gh put {path} -> {r.status_code}: {r.text[:160]}")


async def _ht_assessment_live(slug, cb=0):
    async with httpx.AsyncClient(timeout=10) as c:
        r = await c.get(f"https://resources.ivanmanfredi.com/{slug}/data.json?cb={cb}")
    return r.status_code == 200


