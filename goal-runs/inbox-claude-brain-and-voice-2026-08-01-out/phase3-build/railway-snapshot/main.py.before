async def _ht_publish_assessment(slug, spec, accent):
    """Publish a bespoke assessment to the resources GH Pages repo (2 files), poll until live,
    return the slug. Raises on write failure. Brand.accent is set to the prospect's accent so
    the quiz UI mirrors their brand."""
    spec = dict(spec)
    spec["slug"] = slug
    spec.setdefault("brand", {})
    spec["brand"]["accent"] = accent or spec["brand"].get("accent") or "#5B82A6"
    data_bytes = json.dumps(spec, ensure_ascii=False, indent=1).encode("utf-8")
    title = (spec.get("title") or "Assessment").replace('"', "'")
    subtitle = (spec.get("subtitle") or "").replace('"', "'")
    _is_v2 = spec.get("schema_version") == "v2" or bool(spec.get("computed_outputs"))
    engine_css = "/_engine/assessment-v2.css" if _is_v2 else "/_engine/assessment.css"
    engine_scripts = (
        '<script src="/_engine/shared.js" defer></script><script src="/_engine/assessment-score.js"></script><script src="/_engine/embed-brand.js"></script><script src="/_engine/assessment-v2.js" defer></script>'
        if _is_v2 else
        '<script src="/_engine/shared.js" defer></script><script src="/_engine/assessment.js" defer></script>'
    )
    html = _HT_ASSESS_INDEX_TEMPLATE.format(title=title, subtitle=subtitle, slug=slug, accent=spec["brand"]["accent"], engine_css=engine_css, engine_scripts=engine_scripts)
    # index.html FIRST, data.json LAST -> data.json-live implies the whole folder is live.
    await _ht_gh_put_file("ivanmanfre/resources", f"{slug}/index.html", html.encode("utf-8"), f"hypertarget assessment page {slug}")
    await _ht_gh_put_file("ivanmanfre/resources", f"{slug}/data.json", data_bytes, f"hypertarget assessment {slug}")
    for i in range(60):  # up to ~6 min for GH Pages to build; cache-buster because fastly caches the 404
        try:
            if await _ht_assessment_live(slug, cb=i):
                return slug
        except Exception:
            pass
        await asyncio.sleep(6)
    # Never went live in-window: do NOT wire a dead embed. Raise -> caller keeps the static card.
    raise RuntimeError(f"_ht_publish_assessment: {slug} not live after ~6min (GH Pages lag)")


async def _ht_enrich_lm_bespoke(lm, founder, transcript, slug, accent):
    """No mapped niche assessment -> generate a bespoke one, publish it, seed the lm from it.
    Non-raising: any failure leaves lm as the static generated card."""
    try:
        spec = await _ht_gen_assessment_spec(founder, transcript)
        if not spec:
            return
        _ok, _reasons = _ht_validate_assessment_spec(spec)
        if not _ok:
            logger.warning(f"_ht_enrich_lm_bespoke: spec failed render-QA, keeping static card: {_reasons[:3]}")
            return
        published = await _ht_publish_assessment(slug, spec, accent)
        _ht_seed_from_spec(lm, spec, published)
    except Exception as e:
        logger.warning(f"_ht_enrich_lm_bespoke skipped: {e}")


async def _ht_enrich_lm_seed(lm: dict, headline: str, company: str) -> None:
    """Make the lead magnet coherent with the niche assessment it embeds, in-place.

    Picks the best-fit assessment (using headline + company + the transcript-derived
    LM title/promise), fetches its live data.json, and aligns the WHOLE lead magnet to
    it so the card, the cover, and the interactive all tell one story in the prospect's
    own vocabulary:
      - slug + seed_answers (neutral middle index) -> renders the live assessment
      - title/promise/whats_inside <- the assessment's title/subtitle/categories

    The caller renders the cover AFTER this runs, off the aligned title, so the cover
    matches too. Completely non-raising: any failure leaves lm untouched (static fallback).
    """
    slug = None
    try:
        slug = _ht_pick_lm_slug(headline, company, lm.get("title", ""), lm.get("promise", ""))
        if not slug:
            # No niche assessment fits -> keep the grounded generated brief as a static LM card.
            return
        url = f"https://resources.ivanmanfredi.com/{slug}/data.json"
        async with httpx.AsyncClient(timeout=15) as c:
            r = await c.get(url)
        r.raise_for_status()
        # Some edge functions return a JSON-encoded string body; unwrap if needed.
        raw = r.json()
        data = json.loads(raw) if isinstance(raw, str) else raw

        _ht_seed_from_spec(lm, data, slug)
    except Exception as e:
        logger.warning(f"_ht_enrich_lm_seed skipped ({slug or '?'}): {e}")


def _ht_assemble_scan(row, posts, lm, brand_image, og, avatar, title, accent_hex=None, brand=None,
                      newsletter=None, follow_ups=None, engager_outreach=None,
                      pillars=None, archetype=None):
    founder = {"name": row.get("name"), "first_name": (row.get("name") or "").split(" ")[0],
               "headline": row.get("headline") or "", "avatar_url": avatar or ""}
    # Metrics strip: per-prospect arithmetic when we hold their real engagement (#18). The
    # first number is theirs verbatim; the multipliers are stated inline and conservative
    # (~15 impressions/reaction = low end of the public 15-30x rule; 0.5% reader→email).
    # Thin or absent engagement (silent founders, youtube corpora) keeps the qualitative
    # capture-frame trio — the math only ships where it flatters honestly.
    eng = row.get("_engagement") or {}
    avg_rx = eng.get("avg_reactions") or 0
    readers = int(avg_rx * 15)
    leads_mo = int(readers * 17 * 0.005)  # 4 posts/wk ≈ 17/mo on their own baseline
    if avg_rx >= 5 and leads_mo >= 10:
        metrics = [{"label": f"avg reactions · your last {eng.get('posts')} posts", "value": str(avg_rx)},
                   {"label": "readers per post · ~15 per reaction, conservative", "value": f"~{readers}"},
                   {"label": "named leads a month · 4 posts/wk + a 0.5% capture", "value": f"≈{leads_mo}"}]
    else:
        # Capture frame, not machine/speed brag. The positioning lock: the client gets an
        # OWNED ASSET (leads captured), the machine is proof not product; never brag content
        # is AI-made / "built in N min" (hands a capable ICP the DIY blueprint + reads as slop).
        metrics = [{"label": "In your voice", "value": f"{len(posts)} posts + a lead magnet"},
                   {"label": "The lead magnet", "value": "turns readers into leads"},
                   {"label": "Leads land", "value": "named, in your inbox"}]
    sample_output = {
        "title": title,
        "posts": posts,
        "metrics": metrics,
        # accent_hex is the LEAD's brand color (the same one the cover + post image are
        # rendered in). The frontend threads it into the live-scorecard embed so all three
        # surfaces read as built for the prospect, not in Ivan's brand.
        # brand = the LEAD's full brand read off their site (accent = their CTA color, their
        # real heading/body fonts guardrailed to loadable Google families, their logo). The
        # frontend threads it into the live-assessment embed so the sample renders as THEIR tool.
        "lm": {"title": lm["title"], "cover_url": lm["cover_url"], "promise": lm.get("promise", ""),
               "whats_inside": lm.get("whats_inside", []),
               "slug": lm.get("slug", ""), "seed_answers": lm.get("seed_answers", {}),
               "accent_hex": accent_hex or "",
               "brand": brand or {}},
    }
    # New engine pillars — omitted when a generator returned None so old-shape scans stay clean.
    if newsletter:
        sample_output["newsletter"] = newsletter
    if follow_ups:
        sample_output["follow_ups"] = follow_ups
    if engager_outreach:
        sample_output["engager_outreach"] = engager_outreach
    out = {
        # Real-signal archetype (2026-07-14 revamp); "silent_founder" stays the safe default so
        # old callers and thin-signal builds render unchanged.
        "archetype": archetype if archetype in ("silent_founder", "uncaptured_feed", "unworked_audience")
                     else "silent_founder",
        "founder": founder,
        "sample_output": sample_output,
        "og_image_url": og or brand_image or "",
    }
    # Wins gate relaxed 3 -> 1 (2026-07-14): the template renders 1-2 honestly. Each win now
    # carries a pillar tag; untagged wins get the deterministic classifier with "content" default.
    _wins = row.get("_wins") or []
    wins_out = []
    if isinstance(_wins, list):
        for w in _wins[:3]:
            if not isinstance(w, dict):
                continue
            obs = (w.get("observation") or "").strip()
            bld = (w.get("build") or "").strip()
            if not (obs or bld):
                continue
            pillar = w.get("pillar") if w.get("pillar") in _HT_PILLARS else (_ht_win_pillar(w) or "content")
            wins_out.append({"observation": obs, "build": bld, "pillar": pillar})
    if wins_out:
        out["wins"] = wins_out
    # Three-pillar diagnosis table: ALWAYS present, every cell a real sentence (LLM sentences when
    # _ht_gen_pillars succeeded, deterministic wins/metrics fallback otherwise; never brackets).
    out["pillars"] = _ht_norm_pillars(pillars, row, wins_out or [w for w in _wins if isinstance(w, dict)])
    return out


async def _ht_draft_dm(founder, slug, lm=None):
    name = (founder.get("name") or "there").split(" ")[0]
    url = f"ivanmanfredi.com/scan/{slug}/"
    title = ((lm or {}).get("title") or "").strip()
    if title:
        return (f"{name} - built you a live {title} from your own content. It scores a reader and "
                f"turns them into a named lead, on a page in your voice: {url} . If it is useful I can "
                f"show you what the capture side looks like running.")
    return (f"{name} - took your recent content and turned it into a week of LinkedIn posts plus a "
            f"lead magnet, all in your voice, on a page built for you: {url} . If it is useful I can "
            f"show you what the capture side looks like running.")



async def _ht_rehost_avatar(url, slug):
    """LinkedIn CDN avatar URLs expire (static.licdn.com links rot), so the report's founder
    photo dies after send. Download once at build time and re-host in the public lm-og bucket;
    return the permanent URL, or '' on any failure (caller keeps the original)."""
    if not url or "supabase.co" in url:
        return ""
    try:
        async with httpx.AsyncClient(timeout=30, follow_redirects=True) as c:
            r = await c.get(url)
            r.raise_for_status()
            ctype = (r.headers.get("content-type") or "image/jpeg").split(";")[0].strip()
            if not ctype.startswith("image/") or "svg" in ctype or not r.content:
                return ""  # non-image or LinkedIn's ghost-avatar SVG sprite
            key = f"avatar-{slug}.{'png' if 'png' in ctype else 'jpg'}"
            up = await c.post(f"{SUPABASE_URL}/storage/v1/object/lm-og/{key}",
                              headers={"apikey": SUPABASE_SERVICE_KEY,
                                       "Authorization": f"Bearer {SUPABASE_SERVICE_KEY}",
                                       "Content-Type": ctype, "x-upsert": "true"},
                              content=r.content)
            if up.status_code not in (200, 201):
                logger.warning(f"avatar rehost upload {up.status_code}: {up.text[:120]}")
                return ""
            return f"{SUPABASE_URL}/storage/v1/object/public/lm-og/{key}"
    except Exception as e:
        logger.warning(f"avatar rehost failed: {e}")
        return ""


async def _ht_resolve_avatar(url, li_id, slug):
    """Permanent founder photo for the report. The stored profile_photo_url is often LinkedIn's
    ghost sprite (static.licdn.com/aero-v1/sc/...) or an expired media.licdn.com link; try it,
    then fall back to the live Unipile profile picture, re-hosting whichever works. Returns the
    permanent URL or '' (page falls back to its monogram, which is the honest empty state)."""
    if url and "static.licdn.com" not in url:
        hosted = await _ht_rehost_avatar(url, slug)
        if hosted:
            return hosted
    api_key = os.environ.get("UNIPILE_API_KEY", "")
    account = os.environ.get("UNIPILE_ACCOUNT_ID", "")
    base = os.environ.get("UNIPILE_BASE", "https://api38.unipile.com:16836/api/v1")
    if not (api_key and account and li_id):
        return ""
    try:
        async with httpx.AsyncClient(timeout=30) as c:
            r = await c.get(f"{base}/users/{urllib.parse.quote(str(li_id), safe='')}",
                            params={"account_id": account},
                            headers={"X-API-KEY": api_key, "accept": "application/json"})
            r.raise_for_status()
            d = r.json() or {}
        live = d.get("profile_picture_url_large") or d.get("profile_picture_url") or ""
        if live:
            return await _ht_rehost_avatar(live, slug)
    except Exception as e:
        logger.warning(f"avatar profile fallback failed: {e}")
    return ""


async def _ht_real_engagers(li_id, prospect_name):
    """Real commenters on the prospect's top-commented recent post, via the same Unipile lane the
    wins Enricher reads. Returns {"post_text", "engagers": [{"name","headline"}...]} or None.
    Env-gated: no UNIPILE_API_KEY -> None (feature off, engager section unchanged)."""
    api_key = os.environ.get("UNIPILE_API_KEY", "")
    account = os.environ.get("UNIPILE_ACCOUNT_ID", "")
    base = os.environ.get("UNIPILE_BASE", "https://api38.unipile.com:16836/api/v1")
    if not (api_key and account and li_id):
        return None
    hdrs = {"X-API-KEY": api_key, "accept": "application/json"}
    try:
        async with httpx.AsyncClient(timeout=45) as c:
            pr = await c.get(f"{base}/users/{urllib.parse.quote(str(li_id), safe='')}/posts",
                             params={"account_id": account, "limit": 15}, headers=hdrs)
            pr.raise_for_status()
            items = (pr.json() or {}).get("items") or []

            def _cc(p):
                for k in ("comment_counter", "comments_count", "comment_count"):
                    if isinstance(p.get(k), int):
                        return p[k]
                return 0
            posts = sorted((p for p in items if _cc(p) > 0), key=_cc, reverse=True)
            if not posts:
                return None
            top = posts[0]
            post_id = top.get("social_id") or top.get("id")
            if not post_id:
                return None
            cr = await c.get(f"{base}/posts/{urllib.parse.quote(str(post_id), safe='')}/comments",
                             params={"account_id": account, "limit": 20}, headers=hdrs)
            cr.raise_for_status()
            comments = (cr.json() or {}).get("items") or []
    except Exception as e:
        logger.warning(f"real engagers fetch failed: {e}")
        return None
    who, seen = [], set()
    pname = (prospect_name or "").strip().lower()
    for cm in comments:
        det = cm.get("author_details") or {}
        name = str(cm.get("author") or det.get("name") or "").strip()
        if not name or name.lower() == pname or name.lower() in seen:
            continue
        seen.add(name.lower())
        who.append({"name": name, "headline": str(det.get("headline") or "").strip()})
        if len(who) >= 3:
            break
    if not who:
        return None
    return {"post_text": str(top.get("text") or "").strip()[:280], "engagers": who}


# Rubric v2 verbatim — canonical copy lives in the n8n Audience Audit workflow
# (EcPnaYR6buyhOlSi Code node); keep the two in lockstep on any rubric change.
_HT_AUDIT_RUBRIC = ("You classify LinkedIn profiles for an audience-quality audit. The audited account belongs to a prospect; "
    "the ICP of interest = decision-makers AT direct-to-consumer / ecommerce CONSUMER BRANDS (founder, co-founder, CEO, owner, "
    "president, CMO, VP or head of growth/marketing/ecommerce at a company selling physical consumer products: DTC, ecom, CPG, "
    "Amazon-native). Buckets: icp_dtc_brand (brand-side decision-maker, requires POSITIVE evidence of a consumer-product company), "
    "ecom_adjacent (ecom SaaS/tools, 3PL, payments, marketplaces, retail buyers, explicitly ecom-focused investors; never brands, "
    "never marketing-service sellers), agency_peer (anyone selling marketing/growth/creative/lead-gen/SEO/email/CRO services to "
    "clients, agency owners AND employees, freelancers, consultants, 'I help X grow with Y' pitches, service-shop 'we build / we "
    "scale' language, dev/automation shops), irrelevant_other (in-house employees who are not brand decision-makers, recruiters, "
    "students, investors without ecom focus, unrelated, ambiguous founders with no product signal), suspicious_empty (empty or "
    "spam headline). Tie-breakers: in-house title with no client-services language = irrelevant_other; ambiguous founder = "
    "irrelevant_other, never icp_dtc_brand. Judge from headline text only. Return STRICT JSON only: "
    "{\"classes\":[{\"id\":\"...\",\"bucket\":\"...\"}]} covering every input id exactly once.")


async def _ht_classify_headlines(pool):
    """Rubric-v2 classify in chunks of 100 via the loopback proxy. Returns {id: bucket}.
    One retry per chunk (proxy under load returns prose instead of JSON); a chunk that
    fails twice is simply absent from the map and callers count it as non-ICP, so a bad
    proxy day can only UNDERstate density, never inflate it."""
    out = {}
    for i in range(0, len(pool), 100):
        chunk = pool[i:i + 100]
        usr = json.dumps([{"id": x["id"], "name": x["name"], "headline": x["headline"]} for x in chunk])
        for attempt in (1, 2):
            try:
                d = await _ht_llm_json(_HT_AUDIT_RUBRIC, usr, max_tokens=8000)
                for c in (d.get("classes") or []):
                    if c.get("id"):
                        out[c["id"]] = c.get("bucket")
                break
            except Exception as e:
                logger.warning(f"audience classify chunk {i // 100} attempt {attempt} failed: {e}")
    return out


def _ht_audience_embed(engagers, posts_used, buckets, density, buyer_pct, verdict,
                       net_total, net_sample, net_icp, net_density, named, audited_at):
    """The compact dict the scan page renders as cs['audience']. Counted numbers only:
    network_icp_count is what we classified in the sample we actually read, never an
    extrapolation (the page adds its own sample-math caveat)."""
    return {"engagers": engagers, "posts": posts_used,
            "engager_icp_count": (buckets or {}).get("icp_dtc_brand"),
            "icp_density": density, "buyer_pct": buyer_pct, "verdict": verdict,
            "network_total": net_total, "network_sample": net_sample,
            "network_icp_count": net_icp, "network_icp_density": net_density,
            "named": (named or [])[:3], "audited_at": audited_at}


async def _ht_audience_audit(pid, li_id, name):
    """Audience audit at scan-build time (PLAN-audit-in-scans Piece 1, 2026-07-15).
    Reuses an existing audience_audits row when one exists for the prospect; otherwise runs
    the same audit as the n8n hand-raiser lane: 5-post engager read + up-to-1000-connection
    SN connections_of sample, both rubric-v2 classified, written to audience_audits
    (source scan-build) and audience_density stamped on the prospect so the hand-raiser lane
    never re-audits. Zero engagers does NOT skip the network read: for silent accounts the
    network IS the audit. Returns the cs['audience'] embed dict, or None (no data / env off)
    -> the page section is simply absent, never a crash."""
    if pid:
        try:
            rows = await _lm_supa("GET", f"audience_audits?prospect_id=eq.{pid}&order=audited_at.desc&limit=1")
            if rows:
                r = rows[0]
                return _ht_audience_embed(r.get("unique_engagers"), r.get("posts_analyzed"),
                                          r.get("buckets"), r.get("icp_density"), r.get("buyer_relevant_pct"),
                                          r.get("verdict"), r.get("network_total"), r.get("network_sample_size"),
                                          r.get("network_icp_count"), r.get("network_icp_density"),
                                          r.get("named_examples"), r.get("audited_at"))
        except Exception as e:
            logger.warning(f"audience audit reuse lookup failed: {e}")
    api_key = os.environ.get("UNIPILE_API_KEY", "")
    account = os.environ.get("UNIPILE_ACCOUNT_ID", "")
    base = os.environ.get("UNIPILE_BASE", "https://api38.unipile.com:16836/api/v1")
    if not (api_key and account and li_id):
        return None
    hdrs = {"X-API-KEY": api_key, "accept": "application/json"}

    # ---- engagers from the 5 most recent posts (reactions + comments, keyed by social_id URN;
    # the numeric feed id returns an empty 200 — proven trap) ----
    pool, posts_used = {}, 0
    try:
        async with httpx.AsyncClient(timeout=60) as c:
            pr = await c.get(f"{base}/users/{urllib.parse.quote(str(li_id), safe='')}/posts",
                             params={"account_id": account, "limit": 5}, headers=hdrs)
            pr.raise_for_status()
            items = (pr.json() or {}).get("items") or []
            for post in items:
                sid = post.get("social_id")
                if not sid:
                    continue
                posts_used += 1
                q = urllib.parse.quote(str(sid), safe="")
                for kind in ("reactions", "comments"):
                    try:
                        er = await c.get(f"{base}/posts/{q}/{kind}",
                                         params={"account_id": account, "limit": 100}, headers=hdrs)
                        er.raise_for_status()
                        for it in (er.json() or {}).get("items") or []:
                            a = it.get("author") if isinstance(it.get("author"), dict) else (it.get("author_details") or {})
                            aid = (a or {}).get("id")
                            if not aid or aid == li_id:
                                continue
                            if aid not in pool:
                                pool[aid] = {"id": aid, "name": str((a or {}).get("name") or it.get("author") or "").strip(),
                                             "headline": str((a or {}).get("headline") or "").strip()}
                    except Exception:
                        pass  # this post's reactions/comments unavailable
    except Exception as e:
        logger.warning(f"audience audit posts read failed: {e}")  # network stage still runs

    engager_pool = list(pool.values())
    buckets = {"icp_dtc_brand": 0, "ecom_adjacent": 0, "agency_peer": 0, "irrelevant_other": 0, "suspicious_empty": 0}
    named = []
    if engager_pool:
        by_id = await _ht_classify_headlines(engager_pool)
        for x in engager_pool:
            b = by_id.get(x["id"])
            if b in buckets:
                buckets[b] += 1
                if b == "icp_dtc_brand":
                    named.append({"name": x["name"], "headline": x["headline"], "source": "engager"})
            else:
                buckets["irrelevant_other"] += 1  # unclassified stays conservative
    total = len(engager_pool)
    density = round(buckets["icp_dtc_brand"] / total * 1000) / 10 if total else 0
    buyer_pct = round((buckets["icp_dtc_brand"] + buckets["ecom_adjacent"]) / total * 1000) / 10 if total else 0
    verdict = "PEER/NOISE-HEAVY"
    if density >= 20:
        verdict = "BUYER-DENSE"
    elif density >= 8:
        verdict = "MIXED"
    if total < 15:
        verdict += " (THIN SAMPLE)"
    if not total:
        verdict = "NO ENGAGEMENT"

    # ---- network sample: up to 1000 connections via SN connections_of (locked 2026-07-14).
    # Only resolves for 1st-degree relations; anything else degrades to engager-only.
    # network_total = the live profile's connections_count (the page extrapolates the counted
    # buyers over it); SN paging.total_count is unstable and is never used (proven 2026-07-14). ----
    net_total, net_density, net_icp = None, None, 0
    net_pool, seen = [], set()
    try:
        async with httpx.AsyncClient(timeout=90) as c:
            try:
                pr2 = await c.get(f"{base}/users/{urllib.parse.quote(str(li_id), safe='')}",
                                  params={"account_id": account}, headers=hdrs)
                pr2.raise_for_status()
                net_total = (pr2.json() or {}).get("connections_count") or None
            except Exception:
                net_total = None  # no denominator -> page shows counted-only
            cursor = None
            for _pg in range(20):
                params = {"account_id": account, "limit": 50}
                if cursor:
                    params["cursor"] = cursor
                sr = await c.post(f"{base}/linkedin/search", params=params,
                                  headers={**hdrs, "Content-Type": "application/json"},
                                  json={"api": "sales_navigator", "category": "people", "connections_of": [li_id]})
                sr.raise_for_status()
                sj = sr.json() or {}
                items = sj.get("items") or []
                for it in items:
                    if it.get("id") and it["id"] not in seen:
                        seen.add(it["id"])
                        net_pool.append({"id": it["id"], "name": str(it.get("name") or ""), "headline": str(it.get("headline") or "")})
                cursor = sj.get("cursor")
                if not cursor or not items:
                    break
    except Exception as e:
        logger.warning(f"audience audit network read failed: {e}")
    net_sample = len(net_pool)
    net_named = []
    if net_sample >= 30:
        by_id = await _ht_classify_headlines(net_pool)
        for x in net_pool:
            if by_id.get(x["id"]) == "icp_dtc_brand":
                net_icp += 1
                net_named.append({"name": x["name"], "headline": x["headline"], "source": "network_sample"})
        net_density = round(net_icp / net_sample * 1000) / 10

    if not total and net_density is None:
        return None  # nothing measurable at all: no row, section absent

    audited_at = _dt2.datetime.utcnow().isoformat() + "Z"
    all_named = (named + net_named)[:12]
    try:
        _st = await _lm_supa("POST", "audience_audits", {
            "prospect_name": name, "prospect_provider_id": li_id, "prospect_id": pid,
            "posts_analyzed": posts_used, "unique_engagers": total, "icp_density": density,
            "buyer_relevant_pct": buyer_pct, "buckets": buckets, "named_examples": all_named,
            "verdict": verdict, "network_total": net_total, "network_icp_density": net_density,
            "network_sample_size": net_sample or None,
            "network_icp_count": None if net_density is None else net_icp,
            "source": "scan-build"})
        if _st >= 300:
            logger.warning(f"audience_audits insert returned {_st} for {name}")
        if pid:
            prow = await _lm_supa("GET", f"outreach_prospects?id=eq.{pid}&select=enrichment_data")
            ed = (prow or [{}])[0].get("enrichment_data") or {}
            if isinstance(ed, str):
                try:
                    ed = json.loads(ed)
                except Exception:
                    ed = {}
            ed["audience_audit"] = {"density": density, "buyer_relevant_pct": buyer_pct, "verdict": verdict,
                                    "engagers": total, "posts": posts_used, "network_sample": net_sample,
                                    "network_density": net_density, "at": audited_at}
            await _lm_supa("PATCH", f"outreach_prospects?id=eq.{pid}",
                           {"audience_density": density, "enrichment_data": ed})
    except Exception as e:
        logger.warning(f"audience audit persist failed: {e}")  # embed still ships on the scan

    return _ht_audience_embed(total, posts_used, buckets, density, buyer_pct, verdict,
                              net_total, net_sample or None,
                              None if net_density is None else net_icp, net_density,
                              all_named, audited_at)


async def _ht_build_one(row):
    """Build a single detected row end-to-end. Raises on any stage failure (caller marks failed)."""
    pid = row["prospect_id"]
    # enrich from outreach_prospects (headline/company/avatar live there, not on the queue row)
    prospect = await _lm_supa("GET", f"outreach_prospects?id=eq.{pid}&select=name,headline,company,profile_photo_url,email,enrichment_data,linkedin_profile_id")
    if prospect:
        row["name"] = prospect[0].get("name") or row.get("name") or ""
        row["headline"] = prospect[0].get("headline") or ""
        row["company"] = prospect[0].get("company") or ""
        row["_avatar"] = prospect[0].get("profile_photo_url") or ""
        row["_li_id"] = prospect[0].get("linkedin_profile_id") or ""
        row["_email"] = prospect[0].get("email") or ""
        # Wins weld (2026-07-10): the outreach lane's fabrication-gated 3 wins ride onto the
        # scan so the page opens where the gift note / DM1 left off. Gated upstream (verbatim
        # source_quote check in the Wins Builder); never regenerated here.
        _ed = prospect[0].get("enrichment_data") or {}
        if isinstance(_ed, str):
            try:
                _ed = json.loads(_ed)
            except Exception:
                _ed = {}
        row["_enrichment"] = _ed  # archetype derivation reads capture signals off this
        _w = _ed.get("wins")
        # Gate relaxed 3 -> 1 (2026-07-14): the template renders 1-2 wins honestly.
        if isinstance(_w, list) and len(_w) >= 1 and not _ed.get("wins_failed"):
            row["_wins"] = _w[:3]
    # Audience audit rides the whole build concurrently (PLAN-audit-in-scans Piece 1):
    # joined right before the scans upsert; None -> the room section is simply absent.
    audience_task = asyncio.create_task(_ht_audience_audit(pid, row.get("_li_id"), row.get("name") or ""))
    transcript = await _ht_fetch_transcript(row.get("corpus_url"), override=row.get("_transcript_override"))
    # Engagement math (#18, 2026-07-10 audit): linkedin_posts transcripts carry the prospect's
    # REAL reaction counts ("[their post, N reactions]" from Scan At Accept, "[post 1 | N
    # reactions, ...]" from the Wins-Builder-shaped overrides). Stash the average for the
    # metrics strip; youtube/audio corpora have none and keep the qualitative fallback.
    _rx = [int(x) for x in re.findall(r"\[(?:their post,|post \d+ \|)\s*(\d+)\s+reactions", transcript or "")]
    if len(_rx) >= 3:
        row["_engagement"] = {"posts": len(_rx), "avg_reactions": round(sum(_rx) / len(_rx))}
    posts = await _ht_gen_posts_gated(row, transcript)
    if not posts:
        raise RuntimeError("no posts cleared lint")
    topic = posts[0].get("hook") or ((row.get("name") or "") + " episode")
    lm = await _ht_gen_lm(row, transcript, topic)
    profile = await _ht_brand_profile(row.get("name"), row.get("company_domain"))
    # brand-profile reads the prospect's real brand from their logo. When it can't (no website,
    # or logo/vision both failed) it returns a green fallback that happens to be OUR brand. Ship
    # that and the sample reads as Ivan's, not the lead's. So whenever the accent comes back as
    # the green-family fallback, swap to a neutral professional slate instead. With a readable
    # brand, their own color is kept untouched.
    _acc = (profile.get("accent_hex") or "").strip().lower()
    if not (row.get("company_domain") or "").strip() or _acc in ("#2a8f65", "#2c3a31", "#4c6e3d"):
        profile = {**profile, "accent_hex": "#5B82A6", "is_dark": False}
    profile = _ht_apply_brand_override(profile, row.get("brand_override"))
    slug = _ht_slug(row.get("name"))
    # LinkedIn avatar links expire and are often the ghost sprite; resolve to a re-hosted
    # permanent photo, or blank so the page renders its monogram fallback (2026-07-12).
    row["_avatar"] = await _ht_resolve_avatar(row.get("_avatar", ""), row.get("_li_id"), slug)
    brand_image = await _ht_render_images(posts, profile, slug)
    for p in posts:
        if p.get("format") == "Carousel":
            # Author real slides that DELIVER the caption's promised payoff; fall back to the
            # deterministic body-splitter only if the model call fails.
            p["slides"] = (await _ht_gen_carousel_slides(p, row.get("name"))) or _ht_carousel_slides(p)
    # Align the lead magnet to its niche assessment FIRST (title/promise/whats_inside/slug/seed),
    # then render the cover off the aligned title so card + cover + interactive all match.
    await _ht_enrich_lm_seed(lm, row.get("headline", ""), row.get("company", ""))
    if not lm.get("slug"):  # no mapped niche assessment -> build a bespoke live one
        assess_slug = f"{slug}-assessment"
        await _ht_enrich_lm_bespoke(lm, row, transcript, assess_slug, profile.get("accent_hex"))
    # De-slop the LM copy that ships in the sample card (same tells the Sonnet gens leak).
    if isinstance(lm.get("promise"), str):
        lm["promise"] = _ht_deslop(lm["promise"])
    if isinstance(lm.get("whats_inside"), list):
        lm["whats_inside"] = [_ht_deslop(x) if isinstance(x, str) else x for x in lm["whats_inside"]]
    lm["cover_url"] = await _ht_brand_asset(profile, "lm_cover",
                                            {"headline": lm["title"][:60], "bullets": lm.get("whats_inside", [])[:4]},
                                            slug, aspect="1:1")
    # The full brand for the live-assessment sample. Fonts/logo only ride along when the live
    # probe actually resolved them (loadable Google font, real logo) — absent → engine neutral.
    brand = {
        "accent_hex": profile.get("accent_hex") or "",
        "accent_secondary": profile.get("accent_secondary") or "",
        "font_heading": profile.get("font_heading") or "",
        # serif|sans — drives the engine's upright-serif headline path (?headstyle=serif) so an
        # editorial brand's sample headline renders as an upright serif, not the sans italic-pivot.
        "font_heading_style": profile.get("font_heading_style") or "",
        "font_body": profile.get("font_body") or "",
        "logo_url": profile.get("brand_logo_url") or "",
        "is_dark": bool(profile.get("is_dark")),
        "surface_hex": (profile.get("surface_hex") or "").lstrip("#"),
        "ink_hex": (profile.get("ink_hex") or "").lstrip("#"),
        "accent2": (profile.get("accent_secondary") or "").lstrip("#"),
        # Site-header mimic: the lead's real nav menu, button shape/color, and header, so the embed's
        # wrapping chrome reads as their site (all optional; the embed falls back to neutral defaults).
        "nav_links": profile.get("nav_links") or [],
        "cta_label": profile.get("cta_label") or "",
        "login_label": profile.get("login_label") or "",
        "nav_cta_bg": (profile.get("nav_cta_bg") or "").lstrip("#"),
        "header_bg": (profile.get("header_bg") or "").lstrip("#"),
        "radius_px": profile.get("radius_px") if isinstance(profile.get("radius_px"), int) else None,
    }
    # The three additional engine pillars (display-only samples). Each returns None on failure;
    # assemble omits absent ones. Run concurrently — they're independent LLM calls.
    real_eng = await _ht_real_engagers(row.get("_li_id"), row.get("name") or "")
    newsletter, follow_ups, engager_outreach, pillars_res = await asyncio.gather(
        _ht_gen_newsletter(row, transcript, posts),
        _ht_gen_followups(row, lm),
        _ht_gen_engager_outreach(row, posts, real_eng),
        _ht_gen_pillars(row, transcript, row.get("_wins") or []),
    )
    pillars, win_tags = pillars_res if pillars_res else (None, [])
    # Pillar tags on wins: cheap deterministic keyword pass first, the pillars LLM call's
    # classification only for the ambiguous ones, "content" as the final default.
    for i, w in enumerate(row.get("_wins") or []):
        if isinstance(w, dict) and w.get("pillar") not in _HT_PILLARS:
            llm_tag = win_tags[i] if i < len(win_tags) and win_tags[i] in _HT_PILLARS else None
            w["pillar"] = _ht_win_pillar(w) or llm_tag or "content"
    cs = _ht_assemble_scan(row, posts, lm, brand_image, lm["cover_url"], avatar=row.get("_avatar", ""),
                           title=f"this week, from {row.get('name')}'s content",
                           accent_hex=profile.get("accent_hex"), brand=brand,
                           newsletter=newsletter, follow_ups=follow_ups, engager_outreach=engager_outreach,
                           pillars=pillars, archetype=_ht_archetype(row, transcript))
    # Join the audience audit; shield so a slow audit still finishes in the background and
    # writes its audience_audits row even when this scan ships without the section.
    try:
        audience = await asyncio.wait_for(asyncio.shield(audience_task), timeout=1200)
    except Exception as e:
        logger.warning(f"audience audit not ready for scan embed: {e}")
        audience = None
    if audience:
        cs["audience"] = audience
    async with httpx.AsyncClient(timeout=45) as c:
        sc = await c.post(f"{SUPABASE_URL}/rest/v1/scans?on_conflict=company_slug",
                          headers={"apikey": SUPABASE_SERVICE_KEY, "Authorization": f"Bearer {SUPABASE_SERVICE_KEY}",
                                   "Content-Type": "application/json",
                                   "Prefer": "return=representation,resolution=merge-duplicates"},
                          json={"company_slug": slug, "status": "complete", "matched_offer": "content_system",
                                "domain": row.get("company_domain") or "", "email": row.get("_email") or "",
                                "company_name": row.get("company") or row.get("name") or "",
                                "report_json": {"matched_offer": "content_system", "content_system": cs}})
        sc.raise_for_status()
        scan_id = sc.json()[0]["id"]
    dm = await _ht_draft_dm(row, slug, lm)
    await _lm_supa("PATCH", f"hypertarget_corpus?prospect_id=eq.{pid}",
                   {"stage": "asset_ready", "scan_id": scan_id, "company_slug": slug,
                    "lm_draft_id": lm["draft_id"], "dm_text": dm,
                    "built_at": _dt2.datetime.utcnow().isoformat() + "Z"})


GH_PERSONAL_SITE_REPO = os.environ.get("PERSONAL_SITE_REPO", "ivanmanfre/personal")


async def _ht_trigger_deploy():
    """Best-effort: fire ONE personal-site GH Actions deploy so new scan slugs prerender + unfurl. Never raises into the build."""
    token = os.environ.get("GITHUB_TOKEN", "")
    if not token:
        logger.warning("hypertarget: no GITHUB_TOKEN set, skipping deploy trigger")
        return
    url = f"https://api.github.com/repos/{GH_PERSONAL_SITE_REPO}/actions/workflows/deploy.yml/dispatches"
    async with httpx.AsyncClient(timeout=20) as c:
        r = await c.post(url, headers={"Authorization": f"Bearer {token}",
                                       "Accept": "application/vnd.github+json",
                                       "X-GitHub-Api-Version": "2022-11-28"},
                         json={"ref": "main"})
        if r.status_code >= 300:
            logger.warning(f"hypertarget deploy dispatch -> {r.status_code}: {r.text[:200]}")
        else:
            logger.info("hypertarget: personal-site deploy dispatched")


async def _ht_run_builder(target_pid=None, transcript_override=None, inline_row=None):
    st = _ht_state
    st.update({"running": True, "started_at": _dt2.datetime.utcnow().isoformat() + "Z",
               "finished_at": None, "built": 0, "failed": 0, "total": 0, "current": None, "last_error": None})
    try:
        if target_pid:
            # targeted build (e.g. caller supplies a transcript when yt-dlp is blocked / audio-only)
            rows = await _lm_supa("GET", f"hypertarget_corpus?prospect_id=eq.{target_pid}&select=prospect_id,name,company_domain,corpus_url,corpus_type,brand_override")
            # Corpus-less targeted build (2026-07-10 weld): cold-lane prospects must NOT get a
            # hypertarget_corpus row -- its asset_ready stage trips trg_sync_hypertarget_reserved
            # and yanks them out of the DM senders. Caller supplies the row fields inline; the
            # corpus stage PATCHes below then match 0 rows, which is exactly what we want.
            if not rows and inline_row and inline_row.get("prospect_id"):
                rows = [dict(inline_row)]
        else:
            rows = await _lm_supa("GET", "hypertarget_corpus?stage=eq.detected&select=prospect_id,name,company_domain,corpus_url,corpus_type,brand_override&order=detected_at.asc&limit=" + str(HT_BATCH))
        st["total"] = len(rows)
        for row in rows:
            pid = row["prospect_id"]
            if transcript_override:
                row["_transcript_override"] = transcript_override
            st["current"] = row.get("name") or pid
            await _lm_supa("PATCH", f"hypertarget_corpus?prospect_id=eq.{pid}", {"stage": "building"})
            try:
                await _ht_build_one(row)
                st["built"] += 1
            except Exception as e:
                import traceback as _tb
                st["failed"] += 1
                detail = (str(e) or repr(e) or type(e).__name__)[:300]
                # 2026-07-29: surface per-row failures on /build-hypertarget/status. Only the
                # OUTER handler used to set last_error, so a per-row failure reported
                # {"failed": 1, "last_error": null} and the reason was invisible to every caller.
                # It is worse for CORPUS-LESS inline builds (the cold-lane weld below): rows come
                # from inline_row, so the failure_reason PATCH here matches 0 hypertarget_corpus
                # rows by design and the detail lands nowhere but the Railway log. That is how
                # David Card's reply draft sat blocked for 2h on 4 silent retries.
                st["last_error"] = f"{row.get('name') or pid}: {detail}"
                await _lm_supa("PATCH", f"hypertarget_corpus?prospect_id=eq.{pid}",
                               {"stage": "failed", "failure_reason": detail})
                logger.error(f"hypertarget build failed for {pid}: {detail}\n{_tb.format_exc()}")
    except Exception as e:
        st["last_error"] = str(e)[:300]
        logger.error(f"hypertarget builder crashed: {e}")
    finally:
        st["running"] = False
        st["current"] = None
        st["finished_at"] = _dt2.datetime.utcnow().isoformat() + "Z"
        if st.get("built", 0) > 0:
            try:
                await _ht_trigger_deploy()
            except Exception as _e:
                logger.error(f"hypertarget deploy trigger failed: {_e}")


@app.post("/build-hypertarget")
async def build_hypertarget(request: Request, x_api_key: Optional[str] = Header(None), authorization: Optional[str] = Header(None)):
    """Fire-and-forget: build hypertarget rows into `asset_ready` scans. Returns immediately;
    work runs detached with no timeout. Optional JSON body {prospect_id, transcript} targets one
    row and supplies a transcript (used when yt-dlp is blocked or the corpus is audio-only)."""
    key = x_api_key or (authorization.replace("Bearer ", "").strip() if authorization else None)
    verify_api_key(key)
    if _ht_state["running"]:
        return {"status": "already_running", "state": _ht_state}
    body = {}
    try:
        body = await request.json()
    except Exception:
        body = {}
    if not isinstance(body, dict):
        body = {}
    pid = body.get("prospect_id")
    transcript = body.get("transcript")
    # inline row fields for corpus-less targeted builds (cold-lane prospects; see _ht_run_builder)
    inline = {"prospect_id": pid, "name": body.get("name") or "", "company_domain": body.get("company_domain") or "",
              "corpus_url": body.get("corpus_url") or "", "corpus_type": body.get("corpus_type") or "linkedin_posts",
              "brand_override": None} if pid and body.get("inline") else None
    asyncio.create_task(_ht_run_builder(target_pid=pid, transcript_override=transcript, inline_row=inline))
    return {"status": "started", "targeted": bool(pid), "inline": bool(inline)}


# ── Rise DTC Growth Scan (dtc_scan.py) ───────────────────────────────────────────
# A Rise-DTC-branded per-prospect scan of a Shopify brand's PUBLIC data, laddered to Rise's
# paid-growth / performance-creative / profit-visibility levers. Corpus-less (no LinkedIn /
# audience / avatar / posts / LM). Findings are deterministically templated from the fetched
# fact table and grounding-gated at build time (structurally incapable of fabricating a number).
import dtc_scan  # noqa: E402  (sibling module at /app/dtc_scan.py)


@app.post("/build-dtc-scan")
async def build_dtc_scan_endpoint(request: Request, x_api_key: Optional[str] = Header(None),
                                  authorization: Optional[str] = Header(None)):
    """Build ONE Rise DTC growth scan for a Shopify domain and upsert the scans row.
    Body: {domain, company_name?, prospect_id?}. Synchronous (six public pulls ~15-30s).
    Homepage-unreadable → ships NO scan (returns ok:false). Never fabricates a number."""
    key = x_api_key or (authorization.replace("Bearer ", "").strip() if authorization else None)
    verify_api_key(key)
    try:
        body = await request.json()
    except Exception:
        body = {}
    if not isinstance(body, dict):
        body = {}
    domain = (body.get("domain") or "").strip()
    if not domain:
        return {"ok": False, "reason": "no domain provided"}
    company_name = body.get("company_name") or None
    prospect_id = body.get("prospect_id") or None
    if body.get("probe"):
        # read-only reliability probe: run the six pulls, return signal statuses, write NOTHING
        try:
            corpus = await dtc_scan.build_corpus(domain, brand_name=company_name,
                                                 ads_token=os.environ.get("META_ADS_TOKEN"),
                                                 psi_key=os.environ.get("PAGESPEED_API_KEY"))
        except Exception as e:
            return {"ok": False, "probe": True, "reason": str(e)[:300], "domain": domain}
        sigs = corpus.get("signals", {})
        flat = {"shopify": sigs.get("shopify", {}), "tech_stack": sigs.get("tech_stack", {}),
                "reviews": sigs.get("reviews", {}), "signup": sigs.get("signup", {}),
                "meta_ads": sigs.get("ads", {}).get("meta", {}), "pagespeed": sigs.get("pagespeed", {})}
        return {"ok": True, "probe": True, "domain": domain,
                "corpus_status": corpus.get("corpus_status"), "completeness": corpus.get("completeness"),
                "statuses": {k: {kk: v.get(kk) for kk in ("status", "reason", "endpoint_used")}
                             for k, v in flat.items()}}
    try:
        result = await dtc_scan.build_dtc_scan(
            domain, SUPABASE_URL, SUPABASE_SERVICE_KEY,
            company_name=company_name, prospect_id=prospect_id)
    except Exception as e:
        import traceback as _tb
        logger.error(f"build-dtc-scan failed for {domain}: {e}\n{_tb.format_exc()}")
        return {"ok": False, "reason": str(e)[:300], "domain": domain}
    # fire a personal-site deploy so the new slug prerenders + unfurls (best-effort)
    if result.get("ok"):
        try:
            await _ht_trigger_deploy()
        except Exception as _e:
            logger.warning(f"dtc-scan deploy trigger failed: {_e}")
    return result


_ht_lm_state = {}  # company_slug -> {running, ok, error, result} for /rebuild-lm/status polling


async def _ht_rebuild_lm_work(company_slug, angle, accent, logo_url, is_dark, wordmark, brand_extra, founder, context, lm, rj, row_id):
    """The heavy LM regen, run detached so the HTTP request never holds the connection through a
    multi-minute assessment gen + publish + cover render (that inline wait was 502-ing at nginx)."""
    _ht_lm_state[company_slug] = {"running": True, "ok": None, "error": None, "result": None}
    try:
        spec = await _ht_gen_assessment_spec(founder, context, angle=angle)
        if not spec:
            raise RuntimeError("assessment generation returned nothing")
        spec["cta"] = {
            "headline": "Want a partner who turns this score into an actual plan?",
            "description": "In 30 minutes I'll show you which two gaps to fix first, based on your score and your stage. No pitch deck, just the sequencing.",
            "button": "Book a call",
            "url": "https://calendly.com/im-ivanmanfredi/30min",
        }
        slug = f"{company_slug}-assessment"
        try:
            await _ht_publish_assessment(slug, spec, accent)
        except Exception as e:
            # Files are written before the liveness poll; a GH Pages lag timeout must NOT lose the slug.
            logger.warning(f"rebuild_lm publish poll lag ({slug}): {e} -- seeding anyway, page goes live shortly")
        _ht_seed_from_spec(lm, spec, slug)
        lm.setdefault("brand", {})
        # Full brand mirror: fonts + surface + ink + accent2 so the embed renders in the lead's
        # actual site style (their typography + white/dark surface), not just an accent tint. These
        # ride into the live assessment via buildAssessmentEmbedUrl (font/fontb/bg/ink/accent2).
        for k, v in (brand_extra or {}).items():
            if v not in (None, "", []):
                lm["brand"][k] = v
        lm["accent_hex"] = accent
        lm["brand"]["accent_hex"] = accent
        if logo_url:
            lm["brand"]["logo_url"] = logo_url
        lm["brand"]["is_dark"] = is_dark
        # mood MUST be a list (the recorder does mood.join(); a string 500s the whole render). wordmark
        # is sent under every alias the cover template might read so the footer shows the lead's name
        # instead of the "this company." default.
        profile = {"accent_hex": accent, "is_dark": is_dark, "brand_logo_url": logo_url,
                   "wordmark": wordmark, "brand_name": wordmark, "name": wordmark,
                   "company": wordmark, "company_name": wordmark, "mood": ["editorial"],
                   "accent_secondary": lm["brand"].get("accent2") or lm["brand"].get("accent_secondary") or "",
                   "font_heading": lm["brand"].get("font_heading") or "", "font_body": lm["brand"].get("font_body") or ""}
        try:
            lm["cover_url"] = await _ht_brand_asset(profile, "lm_cover",
                                                    {"headline": lm["title"][:60], "bullets": lm.get("whats_inside", [])[:4]},
                                                    company_slug, aspect="1:1")
        except Exception as e:
            logger.warning(f"rebuild_lm cover render failed ({slug}): {e}")
        if isinstance(lm.get("promise"), str):
            lm["promise"] = _ht_deslop(lm["promise"])
        if isinstance(lm.get("whats_inside"), list):
            lm["whats_inside"] = [_ht_deslop(x) if isinstance(x, str) else x for x in lm["whats_inside"]]
        # Re-fetch before writing: the build ran for minutes and rj is a stale pre-fetch copy.
        # Graft the new lm onto the CURRENT report so concurrent report edits are not clobbered.
        try:
            fresh = await _lm_supa("GET", f"scans?id=eq.{row_id}&select=report_json")
            frj = fresh[0]["report_json"] if fresh else None
            if isinstance(frj, str):
                frj = json.loads(frj)
            if isinstance(frj, dict) and (frj.get("content_system") or {}).get("sample_output") is not None:
                frj["content_system"]["sample_output"]["lm"] = lm
                rj = frj
        except Exception as _e:
            logger.warning(f"rebuild_lm fresh-graft failed ({company_slug}), writing stale copy: {_e}")
        await _lm_supa("PATCH", f"scans?id=eq.{row_id}", {"report_json": rj})
        _ht_lm_state[company_slug] = {"running": False, "ok": True, "error": None,
                                      "result": {"slug": slug, "title": lm.get("title"), "accent": accent,
                                                 "cover_url": lm.get("cover_url"),
                                                 "categories": [c.get("name") for c in (spec.get("categories") or [])]}}
    except Exception as e:
        logger.warning(f"rebuild_lm work failed ({company_slug}): {e}")
        _ht_lm_state[company_slug] = {"running": False, "ok": False, "error": str(e)[:300], "result": None}


@app.post("/rebuild-lm")
async def rebuild_lm(request: Request, x_api_key: Optional[str] = Header(None), authorization: Optional[str] = Header(None)):
    """Regenerate ONLY the lead-magnet assessment for an existing scan, leaving posts/newsletter/
    follow-ups intact. Body: {company_slug, angle?, accent_hex?, logo_url?, is_dark?}. Fire-and-forget:
    returns immediately; poll /rebuild-lm/status?company_slug=... for the result."""
    key = x_api_key or (authorization.replace("Bearer ", "").strip() if authorization else None)
    verify_api_key(key)
    body = {}
    try:
        body = await request.json()
    except Exception:
        body = {}
    company_slug = (body.get("company_slug") or "").strip()
    if not company_slug:
        raise HTTPException(status_code=400, detail="company_slug required")
    angle = body.get("angle") or ""
    rows = await _lm_supa("GET", f"scans?company_slug=eq.{company_slug}&select=id,report_json")
    if not rows:
        raise HTTPException(status_code=404, detail="scan not found")
    row = rows[0]
    rj = row["report_json"]
    if isinstance(rj, str):
        rj = json.loads(rj)
    cs = rj.get("content_system") or {}
    lm = (cs.get("sample_output") or {}).get("lm")
    if lm is None:
        raise HTTPException(status_code=400, detail="scan has no lm")
    founder = cs.get("founder") or {}
    # Optional full brand mirror: {accent_hex, accent2, font_heading, font_body, surface_hex, ink_hex, logo_url}.
    brand_extra = body.get("brand") or {}
    accent = ((body.get("accent_hex") or brand_extra.get("accent_hex") or "").strip()
              or lm.get("accent_hex") or (lm.get("brand") or {}).get("accent_hex") or "#5B82A6")
    logo_url = (body.get("logo_url") or brand_extra.get("logo_url") or "").strip() or (lm.get("brand") or {}).get("logo_url") or ""
    is_dark = bool(body.get("is_dark", brand_extra.get("is_dark", (lm.get("brand") or {}).get("is_dark", False))))
    # No transcript on the scan row -> ground the assessment in the prospect's own drafted content.
    posts = (cs.get("sample_output") or {}).get("posts") or []
    ctx = [founder.get("headline") or ""] + [((p.get("hook") or "") + "\n" + (p.get("body") or "")) for p in posts]
    if lm.get("promise"):
        ctx.append(str(lm.get("promise")))
    context = "\n\n".join([c for c in ctx if c])[:14000]
    wordmark = (body.get("wordmark") or "").strip() or founder.get("name") or company_slug
    asyncio.create_task(_ht_rebuild_lm_work(company_slug, angle, accent, logo_url, is_dark, wordmark, brand_extra, founder, context, lm, rj, row["id"]))
    return {"status": "started", "company_slug": company_slug, "slug": f"{company_slug}-assessment"}


@app.get("/rebuild-lm/status")
async def rebuild_lm_status(company_slug: str = "", x_api_key: Optional[str] = Header(None), authorization: Optional[str] = Header(None)):
    key = x_api_key or (authorization.replace("Bearer ", "").strip() if authorization else None)
    verify_api_key(key)
    return _ht_lm_state.get(company_slug, {"running": False, "ok": None, "error": None, "result": None})


@app.get("/build-hypertarget/status")
async def build_hypertarget_status(x_api_key: Optional[str] = Header(None), authorization: Optional[str] = Header(None)):
    key = x_api_key or (authorization.replace("Bearer ", "").strip() if authorization else None)
    verify_api_key(key)
    return _ht_state


if __name__ == "__main__":
    uvicorn.run(
        app,
        host="0.0.0.0",
        port=PORT,
        log_level="info"
    )
