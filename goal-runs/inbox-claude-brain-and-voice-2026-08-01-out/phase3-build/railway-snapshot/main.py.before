    session_id: str
    result: str
    success: bool
    client_id: Optional[str] = None
    files_created: List[str] = []
    files_modified: List[str] = []


# --------------- Client Management ---------------

async def get_client_config(client_id: str) -> dict:
    """Fetch client configuration from Supabase client_registry."""
    if not SUPABASE_URL or not SUPABASE_SERVICE_KEY:
        raise HTTPException(status_code=500, detail="Supabase not configured for client registry")

    async with httpx.AsyncClient() as client:
        response = await client.get(
            f"{SUPABASE_URL}/rest/v1/client_registry",
            params={"client_id": f"eq.{client_id}", "is_active": "eq.true"},
            headers={
                "apikey": SUPABASE_SERVICE_KEY,
                "Authorization": f"Bearer {SUPABASE_SERVICE_KEY}",
            },
            timeout=15,
        )
        data = response.json()
        if not data:
            raise HTTPException(status_code=404, detail=f"Client '{client_id}' not found in registry")
        return data[0]


def ensure_client_repo(client_id: str, github_repo: str, client_config: dict = None) -> str:
    """Clone or pull the client's config repo. Returns the local path."""
    client_dir = Path(CLIENTS_DIR) / client_id

    # Inject GITHUB_TOKEN into the repo URL for auth
    auth_repo = github_repo
    if GITHUB_TOKEN and "github.com/" in github_repo:
        auth_repo = github_repo.replace(
            "https://github.com/",
            f"https://{GITHUB_TOKEN}@github.com/"
        )

    if client_dir.exists() and (client_dir / ".git").exists():
        # Pull latest
        subprocess.run(
            ["git", "pull", "--ff-only"],
            cwd=str(client_dir),
            capture_output=True,
            timeout=30,
        )
        # Fetch all branches so WIP refs are available locally
        subprocess.run(
            ["git", "fetch", "origin", "--prune"],
            cwd=str(client_dir),
            capture_output=True,
            timeout=30,
        )
        logger.info(f"Pulled latest for client {client_id}")
    else:
        # Fresh shallow clone
        client_dir.parent.mkdir(parents=True, exist_ok=True)
        result = subprocess.run(
            ["git", "clone", "--depth", "1", auth_repo, str(client_dir)],
            capture_output=True,
            timeout=60,
        )
        if result.returncode != 0:
            raise HTTPException(
                status_code=500,
                detail=f"Failed to clone client repo: {result.stderr.decode()[:200]}"
            )
        # Unshallow + fetch all branches so WIP refs are reachable
        subprocess.run(
            ["git", "fetch", "--unshallow", "origin"],
            cwd=str(client_dir), capture_output=True, timeout=60,
        )
        logger.info(f"Cloned repo for client {client_id}")

    # Phase 4: check for unmerged WIP branches from any host newer than HEAD
    try:
        encoded_repo = urllib.parse.quote(github_repo, safe="")
        wip_resp = httpx.get(
            f"{SUPABASE_URL}/rest/v1/wip_branches?repo=eq.{encoded_repo}"
            "&merged=eq.false&order=created_at.desc&limit=1"
            "&select=branch,created_at",
            headers={"apikey": SUPABASE_SERVICE_KEY, "Authorization": f"Bearer {SUPABASE_SERVICE_KEY}"},
            timeout=10,
        )
        if wip_resp.status_code == 200:
            wip_rows = wip_resp.json()
            if wip_rows:
                wip = wip_rows[0]
                head_time = subprocess.check_output(
                    ["git", "log", "-1", "--format=%cI", "HEAD"], cwd=str(client_dir), text=True,
                ).strip()
                if wip["created_at"] > head_time:
                    try:
                        subprocess.run(
                            ["git", "checkout", wip["branch"]],
                            cwd=str(client_dir), check=True, capture_output=True,
                        )
                        logger.info(f"Checked out WIP {wip['branch']} for {client_id}")
                    except subprocess.CalledProcessError as e:
                        logger.warning(
                            f"WIP checkout failed for {client_id}: "
                            f"{e.stderr.decode() if e.stderr else e}"
                        )
    except Exception as e:
        logger.warning(f"WIP check failed for {client_id}: {e}")

    # Auto-setup n8nac + AGENTS.md (skipped if already done this session)
    cid = client_dir.name
    if cid not in N8NAC_INITIALIZED:
        _ensure_client_n8nac(client_dir, client_config)
        N8NAC_INITIALIZED.add(cid)

    return str(client_dir)


def _ensure_client_n8nac(client_dir: Path, client_config: dict = None):
    """Initialize n8nac and copy AGENTS.md if not already done."""
    # Copy AGENTS.md if missing
    agents_src = Path("/app/AGENTS.md")
    agents_dst = client_dir / "AGENTS.md"
    if agents_src.exists() and not agents_dst.exists():
        shutil.copy2(str(agents_src), str(agents_dst))

    # Initialize n8nac if client has n8n credentials and not already configured
    config_file = client_dir / "n8nac-config.json"
    if client_config and not config_file.exists():
        n8n_url = client_config.get("n8n_url", "")
        n8n_key = client_config.get("n8n_api_key", "")
        if n8n_url and n8n_key:
            try:
                r1 = subprocess.run(
                    ["n8nac", "init-auth", "--host", n8n_url, "--api-key", n8n_key],
                    cwd=str(client_dir), capture_output=True, timeout=30,
                )
                if r1.returncode == 0:
                    subprocess.run(
                        ["n8nac", "init-project", "--project-index", "1", "--sync-folder", "workflows"],
                        cwd=str(client_dir), capture_output=True, timeout=30,
                    )
                    logger.info(f"n8nac initialized for {client_dir.name}")
            except Exception as e:
                logger.warning(f"n8nac init failed for {client_dir.name}: {e}")


def build_base_env() -> dict:
    """Build base environment with correct auth priority: OAuth/Max first, API key fallback."""
    env = os.environ.copy()
    oauth_creds = Path("/home/appuser/.claude/.credentials.json")
    if oauth_creds.exists():
        # Prefer OAuth (Max subscription) — remove API key so CLI uses OAuth
        env.pop("ANTHROPIC_API_KEY", None)
    elif ANTHROPIC_API_KEY:
        env["ANTHROPIC_API_KEY"] = ANTHROPIC_API_KEY
    return env


def build_client_env(client_config: dict) -> dict:
    """Build environment dict for a client's Claude Code execution."""
    env = build_base_env()

    # Inject client-specific env vars for MCP servers
    if client_config.get("n8n_api_key"):
        env["N8N_API_KEY"] = client_config["n8n_api_key"]
    if client_config.get("n8n_url"):
        env["N8N_API_URL"] = client_config["n8n_url"]

    # Merge any extra_env from the registry
    extra = client_config.get("extra_env") or {}
    env.update({k: str(v) for k, v in extra.items()})

    return env


