# Track last session per client/workspace for automatic resume
# Key: client_id or "__default__", Value: session_id UUID string
CLIENT_SESSIONS: dict[str, str] = {}

# Per-client locks to prevent concurrent session resume race conditions
CLIENT_LOCKS: dict[str, asyncio.Lock] = {}

# Track clients that already have n8nac initialized (skip redundant checks)
N8NAC_INITIALIZED: set[str] = set()


def get_client_lock(session_key: str) -> asyncio.Lock:
    """Get or create a lock for a client to serialize requests."""
    if session_key not in CLIENT_LOCKS:
        CLIENT_LOCKS[session_key] = asyncio.Lock()
    return CLIENT_LOCKS[session_key]


def verify_api_key(x_api_key: Optional[str] = Header(None)):
    """Verify API key if one is configured"""
    if API_KEY and x_api_key != API_KEY:
        raise HTTPException(status_code=401, detail="Invalid or missing API key")
    return True


class ChatRequest(BaseModel):
    """Request model for chat endpoint"""
    prompt: str
    session_id: Optional[str] = None
